<script>
// Nice Select Component
class NiceSelect {
    constructor(element) {
        this.element = element;
        this.options = Array.from(element.options);
        this.selectedIndex = element.selectedIndex;
        this.placeholder = element.getAttribute('placeholder') || 'Select an option';
        this.init();
    }

    init() {
        // Create nice select wrapper
        this.wrapper = document.createElement('div');
        this.wrapper.className = 'nice-select';
        
        // Create current display
        this.current = document.createElement('div');
        this.current.className = 'current';
        
        // Check if current option has an icon
        const currentOption = this.options[this.selectedIndex];
        const iconClass = currentOption ? currentOption.getAttribute('data-icon') : null;
        if (iconClass) {
            const iconElement = document.createElement('i');
            iconElement.className = iconClass + ' mr-2 text-gray-500';
            this.current.appendChild(iconElement);
        }
        
        const textElement = document.createElement('span');
        textElement.textContent = this.getCurrentText();
        this.current.appendChild(textElement);
        
        // Create arrow
        this.arrow = document.createElement('div');
        this.arrow.className = 'arrow';
        
        // Create options list
        this.list = document.createElement('div');
        this.list.className = 'list';
        
        // Build options
        this.options.forEach((option, index) => {
            const optionElement = document.createElement('div');
            optionElement.className = 'option';
            
            // Check if option has an icon
            const iconClass = option.getAttribute('data-icon');
            if (iconClass) {
                const iconElement = document.createElement('i');
                iconElement.className = iconClass + ' mr-2 text-gray-500';
                optionElement.appendChild(iconElement);
            }
            
            const textElement = document.createElement('span');
            textElement.textContent = option.textContent;
            optionElement.appendChild(textElement);
            
            optionElement.dataset.value = option.value;
            optionElement.dataset.index = index;
            
            if (option.disabled) {
                optionElement.classList.add('disabled');
            }
            
            if (index === this.selectedIndex) {
                optionElement.classList.add('selected');
            }
            
            optionElement.addEventListener('click', (e) => {
                if (!option.disabled) {
                    this.select(index);
                }
            });
            
            this.list.appendChild(optionElement);
        });
        
        // Assemble the component
        this.current.appendChild(this.arrow);
        this.wrapper.appendChild(this.current);
        this.wrapper.appendChild(this.list);
        
        // Add event listeners
        this.wrapper.addEventListener('click', (e) => {
            // Check if click is on the wrapper, current display, arrow, or any child element of current
            if (e.target === this.wrapper || 
                e.target === this.current || 
                e.target === this.arrow || 
                this.current.contains(e.target)) {
                this.toggle();
            }
        });
        
        // Close on outside click
        document.addEventListener('click', (e) => {
            if (!this.wrapper.contains(e.target)) {
                this.close();
            }
        });
        
        // Keyboard navigation
        this.wrapper.addEventListener('keydown', (e) => {
            switch(e.key) {
                case 'Enter':
                case ' ':
                    e.preventDefault();
                    this.toggle();
                    break;
                case 'Escape':
                    this.close();
                    break;
                case 'ArrowDown':
                    e.preventDefault();
                    this.next();
                    break;
                case 'ArrowUp':
                    e.preventDefault();
                    this.previous();
                    break;
            }
        });
        
        // Replace original select
        this.element.style.display = 'none';
        this.element.parentNode.insertBefore(this.wrapper, this.element);
        
        // Make wrapper focusable
        this.wrapper.tabIndex = 0;
    }
    
    getCurrentText() {
        if (this.selectedIndex >= 0 && this.selectedIndex < this.options.length) {
            return this.options[this.selectedIndex].textContent;
        }
        return this.placeholder;
    }
    
    toggle() {
        if (this.wrapper.classList.contains('open')) {
            this.close();
        } else {
            this.open();
        }
    }
    
    open() {
        this.wrapper.classList.add('open');
        this.wrapper.focus();
    }
    
    close() {
        this.wrapper.classList.remove('open');
    }
    
    select(index) {
        if (index >= 0 && index < this.options.length) {
            this.selectedIndex = index;
            
            // Clear current display
            this.current.innerHTML = '';
            
            // Check if selected option has an icon
            const selectedOption = this.options[index];
            const iconClass = selectedOption.getAttribute('data-icon');
            if (iconClass) {
                const iconElement = document.createElement('i');
                iconElement.className = iconClass + ' mr-2 text-gray-500';
                this.current.appendChild(iconElement);
            }
            
            const textElement = document.createElement('span');
            textElement.textContent = selectedOption.textContent;
            this.current.appendChild(textElement);
            this.current.appendChild(this.arrow);
            
            // Update original select
            this.element.selectedIndex = index;
            this.element.value = this.options[index].value;
            
            // Trigger change event
            const event = new Event('change', { bubbles: true });
            this.element.dispatchEvent(event);
            
            // Update visual selection
            this.list.querySelectorAll('.option').forEach((option, i) => {
                option.classList.toggle('selected', i === index);
            });
            
            this.close();
        }
    }
    
    next() {
        let nextIndex = this.selectedIndex + 1;
        while (nextIndex < this.options.length && this.options[nextIndex].disabled) {
            nextIndex++;
        }
        if (nextIndex < this.options.length) {
            this.select(nextIndex);
        }
    }
    
    previous() {
        let prevIndex = this.selectedIndex - 1;
        while (prevIndex >= 0 && this.options[prevIndex].disabled) {
            prevIndex--;
        }
        if (prevIndex >= 0) {
            this.select(prevIndex);
        }
    }
}

$(document).ready(function() {
    // Ödeme yöntemi değişikliklerini dinle
    $('#method').on('change', function() {
        var selectedValue = $(this).val();
        var quickAmountSection = $(this).closest('form').find('label:contains("Quick Amount")').parent();
        
        // Seçilen value 188738 ise Quick Amount kısmını gizle
        if (selectedValue === '188738') {
            quickAmountSection.hide();
        } else {
            // Farklı bir değer seçilirse Quick Amount kısmını göster
            quickAmountSection.show();
        }
    });
    
    // Sayfa yüklendiğinde mevcut seçimi kontrol et
    $('#method').trigger('change');
});


// Initialize nice selects
document.addEventListener('DOMContentLoaded', function() {
    // Initialize all select elements as nice selects
    const selects = document.querySelectorAll('select');
    selects.forEach(select => {
        new NiceSelect(select);
    });

    // Quick amount buttons functionality
    const quickAmountBtns = document.querySelectorAll('.quick-amount-btn');
    const amountInput = document.getElementById('amount');

    quickAmountBtns.forEach(btn => {
        btn.addEventListener('click', function() {
            // Remove active state from all buttons
            quickAmountBtns.forEach(b => {
                b.classList.remove('active', 'border-blue-500', 'text-blue-600', 'bg-blue-50');
                b.classList.add('border-gray-200', 'text-gray-700', 'bg-white');
            });

            // Add active state to clicked button
            this.classList.remove('border-gray-200', 'text-gray-700', 'bg-white');
            this.classList.add('active', 'border-blue-500', 'text-blue-600', 'bg-blue-50');

        // Set amount value
        const amount = this.textContent.trim();
        amountInput.value = amount;
        
        // Trigger input event
        const inputEvent = new Event('input', { bubbles: true });
        amountInput.dispatchEvent(inputEvent);
        
        // Trigger change event
        const changeEvent = new Event('change', { bubbles: true });
        amountInput.dispatchEvent(changeEvent);
        });
    });

    // Payment method change handler - dinamik instruction div'i izle
    const paymentMethodSelect = document.getElementById('method');
    const instructionCardContent = document.querySelector('.bg-blue-50.border.border-blue-200.rounded-lg.p-4');
    
    // Quick Amount gizleme/gösterme fonksiyonu
    function toggleQuickAmount() {
        const selectedValue = paymentMethodSelect.value;
        
        // Label'ı text içeriğine göre arayalım
        let quickAmountLabel = null;
        const labels = document.querySelectorAll('label');
        labels.forEach(label => {
            if (label.textContent.includes('Quick Amount')) {
                quickAmountLabel = label;
            }
        });
        
        if (quickAmountLabel) {
            const quickAmountDiv = quickAmountLabel.parentElement;
            
            // Seçilen value 188738 ise Quick Amount kısmını gizle
            if (selectedValue === '188738') {
                quickAmountDiv.style.display = 'none';
            } else {
                // Farklı bir değer seçilirse Quick Amount kısmını göster
                quickAmountDiv.style.display = 'block';
            }
        }
    }
    
    // İlk yüklemede instruction_instruction div'ini kontrol et
    function updateInstructionFromDiv() {
        const instructionDiv = document.getElementById('instruction_instruction');
        if (instructionDiv && instructionCardContent) {
            let content = instructionDiv.innerHTML.trim();
            
            // Label kısmını çıkar
            content = content.replace(/<label[^>]*class="control-label"[^>]*>.*?<\/label>/gi, '');
            content = content.trim();
            
            if (content) {
                instructionCardContent.innerHTML = content;
            } else {
                // İçerik boşsa bg-blue alanını da boş yap
                instructionCardContent.innerHTML = '';
            }
            // instruction_instruction div'ini gizle
            instructionDiv.style.display = 'none';
        } else if (instructionCardContent) {
            // instruction_instruction div yoksa bg-blue alanını boş yap
            instructionCardContent.innerHTML = '';
        }
    }
    
    // Ödeme yöntemi değiştiğinde instruction_instruction div'ini kontrol et ve Quick Amount'u toggle et
    if (paymentMethodSelect) {
        paymentMethodSelect.addEventListener('change', function() {
            // Kısa bir gecikme ekle çünkü div dinamik olarak güncelleniyor olabilir
            setTimeout(updateInstructionFromDiv, 100);
            // Quick Amount gizleme/gösterme işlemini yap
            toggleQuickAmount();
        });
    }
    
    // MutationObserver ile instruction_instruction div'indeki değişiklikleri izle
    const observer = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
            if (mutation.type === 'childList' || mutation.type === 'subtree') {
                const target = mutation.target;
                if (target.id === 'instruction_instruction' || target.closest('#instruction_instruction')) {
                    updateInstructionFromDiv();
                }
            }
        });
    });
    
    // Observer'ı başlat - tüm body'yi izle çünkü div dinamik olarak eklenebilir
    observer.observe(document.body, {
        childList: true,
        subtree: true,
        characterData: true
    });
    
    // İlk yüklemede bir kez kontrol et
    updateInstructionFromDiv();
    toggleQuickAmount(); // İlk yüklemede Quick Amount kontrolü yap
    
    // Ayrıca sayfa yüklendikten sonra da kontrol et
    setTimeout(function() {
        updateInstructionFromDiv();
        toggleQuickAmount(); // Gecikme sonrası da kontrol et
    }, 500);
});

// Issue type selection
document.querySelectorAll('.issue-type-btn').forEach(btn => {
    btn.addEventListener('click', function() {
        // Remove active state from all buttons and reset to default
        document.querySelectorAll('.issue-type-btn').forEach(b => {
            b.classList.remove('active');
            // Reset to default state based on button position
            const buttonText = b.querySelector('.text-sm.font-semibold').textContent.trim();
            if (buttonText === 'Orders') {
                b.className = 'issue-type-btn p-4 border-2 border-gray-200 rounded-lg hover:border-green-500 transition-colors text-center group cursor-pointer';
            } else if (buttonText === 'Payment') {
                b.className = 'issue-type-btn p-4 border-2 border-gray-200 rounded-lg hover:border-blue-500 transition-colors text-center group cursor-pointer';
            } else if (buttonText === 'General') {
                b.className = 'issue-type-btn p-4 border-2 border-gray-200 rounded-lg hover:border-purple-500 transition-colors text-center group cursor-pointer';
            } else if (buttonText === 'Cooperation') {
                b.className = 'issue-type-btn p-4 border-2 border-gray-200 rounded-lg hover:border-orange-500 transition-colors text-center group cursor-pointer';
            }
        });
        
        // Add active state to clicked button
        this.classList.add('active');
        
        // Set active styling based on button type
        const issueType = this.querySelector('.text-sm.font-semibold').textContent.trim();
        if (issueType === 'Orders') {
            this.className = 'issue-type-btn active p-4 border-2 border-green-500 bg-green-50 rounded-lg hover:border-green-500 transition-colors text-center group cursor-pointer';
        } else if (issueType === 'Payment') {
            this.className = 'issue-type-btn active p-4 border-2 border-blue-500 bg-blue-50 rounded-lg hover:border-blue-500 transition-colors text-center group cursor-pointer';
        } else if (issueType === 'General') {
            this.className = 'issue-type-btn active p-4 border-2 border-purple-500 bg-purple-50 rounded-lg hover:border-purple-500 transition-colors text-center group cursor-pointer';
        } else if (issueType === 'Cooperation') {
            this.className = 'issue-type-btn active p-4 border-2 border-orange-500 bg-orange-50 rounded-lg hover:border-orange-500 transition-colors text-center group cursor-pointer';
        }
    });
});





// Priority selection
document.querySelectorAll('.priority-btn').forEach(btn => {
    btn.addEventListener('click', function() {
        // Remove active class and reset to default state
        document.querySelectorAll('.priority-btn').forEach(b => {
            b.classList.remove('active');
            // Reset to default state
            if (b.textContent.trim() === 'Low') {
                b.className = 'priority-btn px-3 py-1.5 rounded-full border-2 border-emerald-400 text-emerald-600 bg-transparent font-medium hover:bg-emerald-50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 cursor-pointer text-sm';
            } else if (b.textContent.trim() === 'Medium') {
                b.className = 'priority-btn px-3 py-1.5 rounded-full border-2 border-amber-400 text-amber-600 bg-transparent font-medium hover:bg-amber-50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 cursor-pointer text-sm';
            } else if (b.textContent.trim() === 'High') {
                b.className = 'priority-btn px-3 py-1.5 rounded-full border-2 border-rose-400 text-rose-600 bg-transparent font-medium hover:bg-rose-50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 cursor-pointer text-sm';
            }
        });
        
        // Add active class and set active state
        this.classList.add('active');
        if (this.textContent.trim() === 'Low') {
            this.className = 'priority-btn active px-3 py-1.5 rounded-full border-2 border-emerald-500 text-white bg-emerald-500 font-medium hover:bg-emerald-600 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 cursor-pointer text-sm shadow-[0_2px_8px_rgba(16,185,129,0.3)]';
        } else if (this.textContent.trim() === 'Medium') {
            this.className = 'priority-btn active px-3 py-1.5 rounded-full border-2 border-amber-500 text-white bg-amber-500 font-medium hover:bg-amber-600 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 cursor-pointer text-sm shadow-[0_2px_8px_rgba(245,158,11,0.3)]';
        } else if (this.textContent.trim() === 'High') {
            this.className = 'priority-btn active px-3 py-1.5 rounded-full border-2 border-rose-500 text-white bg-rose-500 font-medium hover:bg-rose-600 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 cursor-pointer text-sm shadow-[0_2px_8px_rgba(244,63,94,0.3)]';
        }
    });
});

    // FAQ Accordion
    const faqContainer = document.getElementById('faq-container');
    if (faqContainer) {
        faqContainer.addEventListener('click', function(e) {
            const button = e.target.closest('button');
            if (!button) return;

            const faqItem = button.parentElement;
            const answer = button.nextElementSibling;
            const icon = button.querySelector('i');
            const isExpanded = answer.style.maxHeight && answer.style.maxHeight !== '0px';

            // Close all other open FAQs
            const allItems = faqContainer.children;
            for(let item of allItems) {
                if (item !== faqItem) {
                    const otherAnswer = item.querySelector('.overflow-hidden');
                    const otherIcon = item.querySelector('i');
                    const otherButton = item.querySelector('button');
                    otherAnswer.style.maxHeight = '0px';
                    if (otherIcon) {
                        otherIcon.classList.remove('ri-subtract-line');
                        otherIcon.classList.add('ri-add-line');
                    }
                    otherButton.classList.remove('border-b', 'border-gray-200/80');
                }
            }

            // Toggle current FAQ
            if (isExpanded) {
                answer.style.maxHeight = '0px';
                icon.classList.remove('ri-subtract-line');
                icon.classList.add('ri-add-line');
                button.classList.remove('border-b', 'border-gray-200/80');
            } else {
                answer.style.maxHeight = answer.scrollHeight + 'px';
                icon.classList.remove('ri-add-line');
                icon.classList.add('ri-subtract-line');
                button.classList.add('border-b', 'border-gray-200/80');
            }
        });
    }

    // Tab Switching Functionality
    document.addEventListener('DOMContentLoaded', function() {
        const createTab = document.getElementById('create-tab');
        const listTab = document.getElementById('list-tab');
        const createContent = document.getElementById('create-tab-content');
        const listContent = document.getElementById('list-tab-content');

        function switchToCreate() {
            // Update tab styles
            createTab.className = 'tab-btn active flex items-center justify-center gap-[10px] py-[12px] px-[14px] rounded-full font-medium whitespace-nowrap text-[15px] leading-[160%] tracking-[-0.3px] !text-white border border-white/15 btn-custom-active shadow-[0px_0px_3px_0px_#0139ff,0px_0px_0px_1.182px_#0139ff] cursor-pointer';
            listTab.className = 'tab-btn flex items-center justify-center gap-[10px] py-[12px] px-[14px] rounded-full font-medium whitespace-nowrap text-[15px] leading-[160%] tracking-[-0.3px] text-gray-600 hover:bg-gray-200 hover:text-gray-800 cursor-pointer';
            
            // Show/hide content
            createContent.classList.remove('hidden');
            listContent.classList.add('hidden');
        }

        function switchToList() {
            // Update tab styles
            listTab.className = 'tab-btn active flex items-center justify-center gap-[10px] py-[12px] px-[14px] rounded-full font-medium whitespace-nowrap text-[15px] leading-[160%] tracking-[-0.3px] !text-white border border-white/15 btn-custom-active shadow-[0px_0px_3px_0px_#0139ff,0px_0px_0px_1.182px_#0139ff] cursor-pointer';
            createTab.className = 'tab-btn flex items-center justify-center gap-[10px] py-[12px] px-[14px] rounded-full font-medium whitespace-nowrap text-[15px] leading-[160%] tracking-[-0.3px] text-gray-600 hover:bg-gray-200 hover:text-gray-800 cursor-pointer';
            
            // Show/hide content
            listContent.classList.remove('hidden');
            createContent.classList.add('hidden');
        }

        // URL kontrolü - eğer URL'de SAYFA/SAYI pattern'i varsa Balance History'yi aktif et
        function checkUrlAndActivateTab() {
            const currentPath = window.location.pathname;
            // SAYFA/SAYI pattern'ini kontrol et (örn: /addfunds/2, /page/1, vb.)
            const pageNumberPattern = /\/[a-zA-Z]+\/\d+$/;
            
            if (pageNumberPattern.test(currentPath)) {
                switchToList();
            }
        }

        // Sayfa yüklendiğinde URL'yi kontrol et
        checkUrlAndActivateTab();

        // Add event listeners
        createTab.addEventListener('click', function(e) {
            e.preventDefault();
            switchToCreate();
        });

        listTab.addEventListener('click', function(e) {
            e.preventDefault();
            switchToList();
        });
    });
</script>
