<section class="page-header-ui" style="padding-bottom: 32px;padding-top: 32px;">
    <div class="container mx-auto px-4 pb-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Current Balance Box -->
            <div class="bg-gradient-to-br from-blue-50 to-sky-50 border border-blue-200 rounded-xl p-6 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <h3 class="text-sm font-medium text-gray-500 uppercase tracking-wide">Current Balance</h3>
                        <p class="text-3xl font-bold text-gray-900 mt-2">{{ user["balance"] }}</p>
                    </div>
                    <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center border border-blue-400">
                        <i class="ri-wallet-3-line text-blue-600 text-xl"></i>
                    </div>
                </div>
            </div>
            
            <!-- Total Spent Box -->
            <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <h3 class="text-sm font-medium text-gray-500 uppercase tracking-wide">Total Spent</h3>
                        <p class="text-3xl font-bold text-gray-900 mt-2">{{ user["spent"] }}</p>
                    </div>
                    <div class="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center border border-red-400">
                        <i class="ri-money-dollar-circle-line text-red-600 text-xl"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="relative z-10 pb-16 md:pb-15 bg-white pt-12">
    <div class="container mx-auto px-4 relative z-10">
        
            <div class="mt-[-80px] flex items-center justify-between mb-8">
        <!-- Tab Navigation -->
        <div class="inline-flex items-center gap-[2px] list-none p-[6px] m-0 rounded-full border border-gray-200 bg-white">
            <a href="#" id="create-tab" class="tab-btn active flex items-center justify-center gap-[10px] py-[12px] px-[14px] rounded-full font-medium whitespace-nowrap text-[15px] leading-[160%] tracking-[-0.3px] !text-white border border-white/15 btn-custom-active shadow-[0px_0px_3px_0px_#0139ff,0px_0px_0px_1.182px_#0139ff] cursor-pointer">
                <i class="ri-money-dollar-circle-line text-[22px]"></i>
                <span>Add Funds</span>
            </a>
            <a href="#" id="list-tab" class="tab-btn flex items-center justify-center gap-[10px] py-[12px] px-[14px] rounded-full font-medium whitespace-nowrap text-[15px] leading-[160%] tracking-[-0.3px] text-gray-600 hover:bg-gray-200 hover:text-gray-800 cursor-pointer">
                <i class="ri-history-line text-[22px]"></i>
                <span>Balance History</span>
            </a>
        </div>


        </div>

        <!-- Two Cards Layout -->
        <div id="create-tab-content" class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            {% if paymentsList %}
            <!-- Main Add Funds Form Card -->
            <div class="lg:col-span-2 bg-white border border-gray-200 rounded-xl overflow-hidden">
       
                
                <div class="p-6">
       
                    <form {% if site['rtl'] %} class="rtl-form space-y-6"{% else %} class="space-y-6"{% endif %} method="post" action="">
        

        {% if success %}
                            <div class="alert alert-dismissible alert-success {% if site['rtl'] %} rtl-alert {% endif %} p-4 mb-4 text-sm text-green-800 bg-green-50 border border-green-200 rounded-lg">
                                <button type="button" class="close" data-dismiss="alert">&times;</button>
                                {{ successText }}
                            </div>
                        {% endif %}
                        
                        {% if error %}
                            <div class="alert alert-dismissible alert-danger {% if site['rtl'] %} rtl-alert {% endif %} p-4 mb-4 text-sm text-red-800 bg-red-50 border border-red-200 rounded-lg">
                                <button type="button" class="close" data-dismiss="alert">&times;</button>
                                {{ errorText }}
                            </div>
                        {% endif %}
                      


            <div class="form-group">
              <label for="method" class="control-label">{{ lang('addfunds.method') }}</label>
              <select class="form-control" id="method" name="AddFoundsForm[type]" id="order_type">
                                     {% for payment in paymentsList %}
                                    <option value="{{ payment['id'] }}"{% if currentPayment == payment['id'] %} selected{% endif %} data-icon="ri-bank-card-line">{{ payment['name'] }}</option>
                                {% endfor %}

              </select>
            </div>




            
            {% if site['cpf_field'] %}
            <div class="form-group">
              <label for="cpf" class="control-label">{{ lang('addfunds.cpf') }}</label>
              <input type="text" class="form-control"  name="AddFoundsForm[cpf]" id="cpf">
            </div>
            {% endif %}
            <input type="hidden" name="_csrf" value="{{ csrftoken }}">

                     

                        
            <div class="form-group">
              <div id="amount-fields">

                     <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-3 uppercase tracking-wide">Quick Amount</label>
                            <div class="grid grid-cols-6 gap-2">
                                <button type="button" class="quick-amount-btn px-3 py-2 rounded-lg border-2 border-gray-200 text-gray-700 bg-white hover:border-blue-500 hover:text-blue-600 transition-colors cursor-pointer text-sm font-medium">
                                    10
                                </button>
                                <button type="button" class="quick-amount-btn px-3 py-2 rounded-lg border-2 border-gray-200 text-gray-700 bg-white hover:border-blue-500 hover:text-blue-600 transition-colors cursor-pointer text-sm font-medium">
                                    25
                                </button>
                                <button type="button" class="quick-amount-btn px-3 py-2 rounded-lg border-2 border-gray-200 text-gray-700 bg-white hover:border-blue-500 hover:text-blue-600 transition-colors cursor-pointer text-sm font-medium">
                                    50
                                </button>
                                <button type="button" class="quick-amount-btn px-3 py-2 rounded-lg border-2 border-gray-200 text-gray-700 bg-white hover:border-blue-500 hover:text-blue-600 transition-colors cursor-pointer text-sm font-medium">
                                    100
                                </button>
                                <button type="button" class="quick-amount-btn px-3 py-2 rounded-lg border-2 border-gray-200 text-gray-700 bg-white hover:border-blue-500 hover:text-blue-600 transition-colors cursor-pointer text-sm font-medium">
                                    250
                                </button>
                                <button type="button" class="quick-amount-btn px-3 py-2 rounded-lg border-2 border-gray-200 text-gray-700 bg-white hover:border-blue-500 hover:text-blue-600 transition-colors cursor-pointer text-sm font-medium">
                                    500
                                </button>
                            </div>
                        </div>



                 <div style="margin-top: 20px;">
                                <label for="amount" class="block text-sm font-semibold text-gray-700 mb-2 uppercase tracking-wide">{{ lang('addfunds.amount') }}</label>
                                <div class="relative">
                                    <span class="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-500 font-semibold">$</span>
                                    <input type="text" inputmode="decimal" id="amount" name="AddFoundsForm[amount]" class="w-full pl-8 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors text-base font-normal min-h-[48px] leading-[1.5] placeholder:text-gray-400 placeholder:font-normal" placeholder="Enter amount">
                                </div>
                            </div>
              </div>
            </div>
            
         


                        <!-- Submit Button -->
                        <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors flex items-center justify-center gap-2">
                            {{ lang('addfunds.button.pay') }}
                            <i class="ri-arrow-right-line"></i>
                        </button>
          </form>
       
          
                </div>
            </div>
            {% endif %}

            {% if addfunds %}
            <div class="lg:col-span-2 bg-white border border-gray-200 rounded-xl overflow-hidden">
                <div class="p-6 {% if site['rtl'] %} rtl-content {% endif %}">
                    {{ addfunds }}
                </div>
            </div>
            {% endif %}

            <!-- Right Side Cards -->
            <div class="space-y-6">
                <!-- Instruction Card -->
                <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
                    <div class="px-6 py-4 border-b border-gray-200">
                        <h3 class="text-lg font-semibold text-gray-800 flex items-center gap-2">
                            <i class="ri-information-line text-blue-600 text-xl"></i>
                            Instruction
                        </h3>
                    </div>
                    <div class="p-6">
                        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                        </div>
                    </div>
                </div>

                <!-- FAQ Card -->
         <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
                    <div class="p-6">
                        <p class="text-sm text-gray-600 mb-4">Please check this informations before you make any payment or submit any ticket.</p>
                        <a href="/tickets" class="w-full bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium py-2 px-4 rounded-lg border border-gray-300 transition-colors flex items-center justify-center gap-2 mb-3 no-underline">
                            <i class="ri-customer-service-line"></i>
                            Create Ticket
                        </a>
                        <a href="/createinvoice" class="w-full bg-blue-100 hover:bg-blue-200 text-blue-700 font-medium py-2 px-4 rounded-lg border border-blue-300 transition-colors flex items-center justify-center gap-2 no-underline">
                            <i class="ri-file-list-line"></i>
                            Create Invoice
                        </a>
                    </div>
             

                </div>

                </div>

       
            </div>
        </div>

        <!-- Ticket List Tab Content -->
        <div id="list-tab-content" class="hidden container mx-auto px-4 relative z-10">

            {% if paymentList %}
            <!-- Balance History Table -->
            <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
                <div class="hidden md:block overflow-x-auto">
                    <table class="table w-full">
                        <thead class="bg-gray-50 border-b border-gray-200">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">{{ lang('addfunds.id') }}</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">{{ lang('addfunds.date') }}</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">{{ lang('addfunds.method') }}</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">{{ lang('addfunds.amount') }}</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            {% for payment in paymentList %}
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-4 py-4 whitespace-nowrap text-sm font-semibold text-blue-600">{{ payment['id'] }}</td>
                                <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-500">
                                    <span class="nowrap">{{ payment['date'] }}</span>
                                </td>
                                <td class="px-4 py-4 whitespace-nowrap text-sm font-semibold text-gray-900">{{ payment['method'] }}</td>
                                <td class="px-4 py-4 whitespace-nowrap text-sm font-semibold text-green-600">
                                    {% if payment['original_amount'] %}
                                        <span data-toggle="tooltip" data-placement="left" title="{{ payment['original_amount'] }}&nbsp;{{ payment['original_currency'] }}">≈ {{ payment['amount'] }}</span>
                                    {% else %}
                                        {{ payment['amount'] }}
                                    {% endif %}
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                
                <!-- Mobile Card View -->
                <div class="md:hidden">
                    {% for payment in paymentList %}
                    <div class="p-4{% if not loop.last %} border-b border-gray-200{% endif %}">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-sm font-semibold text-blue-600">#{{ payment['id'] }}</span>
                            <span class="text-sm text-gray-500">{{ payment['date'] }}</span>
                        </div>
                        <div class="text-sm font-semibold text-gray-900 mb-1">{{ payment['method'] }}</div>
                        <div class="text-sm font-semibold text-green-600">
                            {% if payment['original_amount'] %}
                                ≈ {{ payment['amount'] }}
                            {% else %}
                                {{ payment['amount'] }}
                            {% endif %}
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
            
            {% if pagination['count'] > 50 %}
            <div class="mt-6 flex justify-center">
                <div class="nav-pills">
                    <ul class="pagination {% if site['rtl'] %} rtl-pagination {% endif %} flex items-center space-x-2">
                        {% if pagination['current'] != 1 %}
                            <li>
                                <a href="{{ page['url'] }}/{{ pagination['last'] }}" aria-label="Previous" class="px-3 py-2 bg-white border border-gray-300 rounded-md text-gray-500 hover:bg-gray-50">
                                    <span aria-hidden="true">&laquo;</span>
                                </a>
                            </li>
                        {% endif %}

                        {% set r, l = 3, 3 %}

                        {% if pagination['current'] == 1 %}
                            {% set r = 6 %}
                        {% endif %}

                        {% if pagination['current'] == 2 %}
                            {% set r = 5 %}
                        {% endif %}

                        {% if pagination['current'] >= pagination['pages'] %}
                            {% set l = 5 %}
                        {% endif %}

                        {% for i in 1..ceil(pagination['pages']) %}
                            {% if i >= (pagination['current']-l) and i <= (pagination['current']+r) %}
                                <li{% if i == pagination['current'] %} class="active"{% endif %}>
                                    <a href="{{ page['url'] }}/{{i}}" class="px-3 py-2 border rounded-md {% if i == pagination['current'] %}bg-blue-600 text-white border-blue-600{% else %}bg-white text-gray-500 border-gray-300 hover:bg-gray-50{% endif %}">{{i}}</a>
                                </li>
                            {% endif %}
                        {% endfor %}

                        {% if pagination['current'] < pagination['pages'] %}
                            <li>
                                <a href="{{ page['url'] }}/{{ pagination['next'] }}" aria-label="Next" class="px-3 py-2 bg-white border border-gray-300 rounded-md text-gray-500 hover:bg-gray-50">
                                    <span aria-hidden="true">&raquo;</span>
                                </a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
            {% endif %}
            {% endif %}
        </div>

    </div>
</div>

<style>

