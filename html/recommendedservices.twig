        // Generate speed lightning icons
        function generateSpeedIcons(speed) {
            speed = Math.max(0, Math.min(5, Number(speed) || 0));
        
            let icons = '';
            for (let i = 1; i <= 5; i++) {
                icons += i <= speed
                    ? '<i class="ri-flashlight-fill text-yellow-500"></i>'
                    : '<i class="ri-flashlight-line text-gray-400"></i>';
            }
            return icons;
        }
        

