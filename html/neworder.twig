    // Flag to prevent multiple service loading attempts
    let isLoadingServices = false;

    // Update service dropdown when category changes
    function updateServiceDropdown(categoryId) {
        const $serviceSelect = $('#orderform-service');
        const $serviceMenu = $('#service-menu ul');
        
        // Prevent multiple simultaneous loading attempts
        if (isLoadingServices) {
            return;
        }
        
        // Validate category ID
        if (!categoryId || categoryId === '') {
            return;
        }
        
        isLoadingServices = true;
        
        // IMPORTANT: Reset flags to allow new service selection for this category
        // AMA sadece manuel kategori değişikliğinde! Cookie/URL seçiminde değil!
        if (!isSelectionTriggeredBySearch) {
            isFirstServiceSelected = false;
        }
        
        // Clear current services
        $serviceSelect.empty();
        $serviceMenu.empty();
        
        // Reset service dropdown display
        $('#service-selected-text').text('Loading services...');
        $('#service-icon-container img').attr('src', 'https://storage.perfectcdn.com/ed17j7/snoz2ubzdwbqghgs.png');
        
        if (!categoryId) {
            $('#service-selected-text').text('Select a category first');
            isLoadingServices = false;
            return;
        }
        
        // Make AJAX call to load services for the selected category
        $.ajax({
            url: window.location.href,
            type: 'GET',
            data: { 
                category: categoryId,
                ajax: 1
            },
            success: function(response) {
                try {
                    let services = [];
                    
                    // HTML response kontrolü (<!DOCTYPE ile başlıyorsa HTML'dir)
                    if (typeof response === 'string' && response.trim().startsWith('<!DOCTYPE')) {
                        triggerOriginalServiceLoad();
                        return;
                    }
                    
                    if (typeof response === 'string') {
                        response = JSON.parse(response);
                    }
                    
                    if (response.services) {
                        services = response.services;
                    } else if (window.modules && window.modules.siteOrder && window.modules.siteOrder.services) {
                        // Fallback to existing services data filtered by category
                        const allServices = window.modules.siteOrder.services;
                        for (let serviceId in allServices) {
                            if (allServices[serviceId].category_id == categoryId) {
                                services.push(allServices[serviceId]);
                            }
                        }
                    }
                    
                    populateServiceDropdown(services);
                } catch (e) {
                    // Fallback to trigger the original select change
                    triggerOriginalServiceLoad();
                } finally {
                    isLoadingServices = false;
                }
            },
            error: function(xhr, status, error) {
                // Fallback to trigger the original select change
                triggerOriginalServiceLoad();
                
                // Reset loading flag
                isLoadingServices = false;
            }
        });
    }

    // Trigger original service loading mechanism
    function triggerOriginalServiceLoad() {
        const $serviceSelect = $('#orderform-service');
        
        // Check if there's an existing service loading mechanism
        if (window.modules && window.modules.siteOrder) {
            if (typeof window.modules.siteOrder.loadServices === 'function') {
                const categoryId = $('#orderform-category').val();
                window.modules.siteOrder.loadServices(categoryId, function(services) {
                    populateServiceDropdown(services);
                });
            } else if (typeof window.modules.siteOrder.categoryChanged === 'function') {
                window.modules.siteOrder.categoryChanged();
                // Watch for changes in the hidden select
                if (!isSelectionTriggeredBySearch) {
                    setTimeout(function() {
                        loadServicesFromHiddenSelect();
                    }, 500);
                }
            }
        }
        
        // Alternative: trigger any existing category change handlers
        $('#orderform-category').trigger('change.select2');
        
        // Watch for changes in the hidden select after a delay
        if (!isSelectionTriggeredBySearch) {
            setTimeout(function() {
                loadServicesFromHiddenSelect();
            }, 1000);
        }
    }

