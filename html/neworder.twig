    // Function to filter categories by platform
    function filterCategoriesByPlatform(platform) {
        console.log('Filtering categories by platform:', platform);
        
        const $categoryMenu = $('#category-menu ul');
        const $allCategories = $categoryMenu.find('li');
        
        // Clear any existing timeouts
        if (window.platformFilterTimeout) {
            clearTimeout(window.platformFilterTimeout);
        }
        
        // Reset UI state immediately
        $('#category-menu li').removeClass('bg-gray-100');
        
        if (platform === 'all') {
            // Show all categories
            $allCategories.show();
            
            // Reset to first category if available with slight delay
            window.platformFilterTimeout = setTimeout(function() {
                const $firstCategory = $allCategories.first();
                if ($firstCategory.length) {
                    selectCategoryAndTrigger($firstCategory);
                }
            }, 100);
        } else {
            // Hide all categories first
            $allCategories.hide();
            
            // Show only categories that match the platform
            let $matchingCategories = $allCategories.filter(function() {
                const categoryText = $(this).text().toLowerCase();
                return categoryText.includes(platform.toLowerCase());
            });
            
            // If no exact match found, try broader matching
            if ($matchingCategories.length === 0) {
                $matchingCategories = $allCategories.filter(function() {
                    const categoryText = $(this).text().toLowerCase();
                    
                    // Platform specific keyword matching
                    switch(platform) {
                        case 'instagram':
                            return categoryText.includes('instagram') || categoryText.includes('ig ') || categoryText.includes('insta');
                        case 'tiktok':
                            return categoryText.includes('tiktok') || categoryText.includes('tik tok') || categoryText.includes('tt ');
                        case 'youtube':
                            return categoryText.includes('youtube') || categoryText.includes('yt ') || categoryText.includes('video');
                        case 'facebook':
                            return categoryText.includes('facebook') || categoryText.includes('fb ') || categoryText.includes('meta');
                        case 'twitter':
                            return categoryText.includes('twitter') || categoryText.includes('x ') || categoryText.includes('tweet');
                        case 'telegram':
                            return categoryText.includes('telegram') || categoryText.includes('tg ');
                        case 'spotify':
                            return categoryText.includes('spotify') || categoryText.includes('music');
                        case 'twitch':
                            return categoryText.includes('twitch') || categoryText.includes('stream');
                        case 'discord':
                            return categoryText.includes('discord');
                        default:
                            return false;
                    }
                });
            }
            
            if ($matchingCategories.length > 0) {
                // Show matching categories
                $matchingCategories.show();
                
                // Auto-select first matching category with delay to ensure proper loading
                window.platformFilterTimeout = setTimeout(function() {
                    const $firstMatchingCategory = $matchingCategories.first();
                    if ($firstMatchingCategory.length) {
                        selectCategoryAndTrigger($firstMatchingCategory);
                    }
                }, 100);
            } else {
                // No matching categories found, show a message
                $('#category-selected-text').text(`No ${platform} categories found`);
                $('#service-selected-text').text('Select a category first');
                
                // Clear hidden selects
                $('#orderform-category').val('');
                $('#orderform-service').val('');
                
                // Clear service menu
                $('#service-menu ul').empty();
            }
        }
    }

