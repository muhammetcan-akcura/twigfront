        $('#charge').val(charge);
        $('#charge-display').text('$' + charge);
    }

    // Enhanced dropdown setup with sync functionality
    function setupCustomDropdown(dropdownId, menuId, searchId, selectedTextId, iconContainerId, syncFunction) {
        const $dropdown = $('#' + dropdownId);
        if (!$dropdown.length) return;

        const $button = $dropdown.find('button');
        const $menu = $('#' + menuId);
        const $searchInput = $('#' + searchId);
        const $selectedText = $('#' + selectedTextId);
        const $iconContainer = iconContainerId ? $('#' + iconContainerId) : null;
        const activeClass = 'bg-gray-100';

        function updateHighlight() {
            const currentValue = $selectedText.text().trim();
            $menu.find('li').removeClass(activeClass);
            $menu.find('li').each(function() {
                const $item = $(this);
                if ($item.data('text') && $item.data('text').trim() === currentValue) {
                    $item.addClass(activeClass);
                }
            });
        }

        $button.on('click', function(e) {
            e.stopPropagation();
            $('.absolute.z-50').not($menu).addClass('hidden');
            $menu.toggleClass('hidden');
            if (!$menu.hasClass('hidden')) {
                updateHighlight();
            }
        });

        $menu.on('click', 'li', function() {
            const $li = $(this);
            
            // Sync with hidden select
            if (syncFunction) {
                syncFunction($li);
            }

            $menu.find('li').removeClass(activeClass);
            $li.addClass(activeClass);
            $menu.addClass('hidden');
        });

        $searchInput.on('input', function() {
            const searchTerm = $(this).val().toLowerCase();
            $menu.find('li').each(function() {
                const text = $(this).text().toLowerCase();
                $(this).toggle(text.includes(searchTerm));
            });
        });
    }

    // Check for service parameter in URL and auto-select with aggressive triggering
    function checkURLServiceParameter() {
        const urlParams = new URLSearchParams(window.location.search);
        const serviceId = urlParams.get('service');
        
        if (serviceId) {
            console.log('URL service parameter detected:', serviceId);
            
            // Wait for window.modules to be available
            let maxRetries = 20;
            let retryCount = 0;
            
            function trySelectService() {
                retryCount++;
                
                if (window.modules && window.modules.siteOrder && window.modules.siteOrder.services) {
                    const services = window.modules.siteOrder.services;
                    const targetService = services[serviceId];
                    
                    if (targetService) {
                        console.log('Found target service:', targetService.name || targetService.origin_name);
                        selectServiceFromURL(serviceId, targetService, null);  // No callback for URL
                        return;
                    } else {
                        console.log('Service not found in services data:', serviceId);
                    }
                } else {
                    console.log('window.modules not ready yet, retry:', retryCount);
                }
                
                // Retry if not found and haven't exceeded max retries
                if (retryCount < maxRetries) {
                    setTimeout(trySelectService, 100);
                } else {
                    console.log('Failed to find service after max retries');
                }
            }
            
            // Start immediate attempt and also retry
            trySelectService();
        }
    }
    
    // Aggressively select service from URL parameter
    function selectServiceFromURL(serviceId, targetService, successCallback) {
        console.log('[SELECT] selectServiceFromURL called for service:', serviceId);
        isSelectionTriggeredBySearch = true;
        
        // Farklı category field'larını kontrol et
        const categoryId = targetService.category_id ||
                          targetService.categoryId ||
                          targetService.category ||
                          targetService.cat_id ||
                          targetService.catId ||
                          targetService.cid;
        
        if (!categoryId) {
            // Alternatif: Tüm kategorilerden service'i bulmaya çalış
            tryFindServiceInCategories(serviceId, targetService);
            
            // Flag'i reset et
            setTimeout(() => {
                isSelectionTriggeredBySearch = false;
            }, 500);
            
            return;
        }
        
        // CRITICAL: isFirstServiceSelected = TRUE yapmalıyız
        // Böylece cookie'den servis seçildikten sonra loadServicesFromHiddenSelect tekrar çağrılırsa
        // ilk servisi otomatik seçmeyecek
        isFirstServiceSelected = true;
        
        // Step 1: Select and trigger category
        selectCategoryFromURL(categoryId, function() {
            let checkAttempts = 0;
            const maxAttempts = 20;
            
            function checkAndSelectService() {
                checkAttempts++;
                
                // Service dropdown'da hedef servis var mı kontrol et
                const serviceExists = $(`#orderform-service option[value="${serviceId}"]`).length > 0 ||
                                    $(`#service-menu li[data-value="${serviceId}"]`).length > 0;
                
                if (serviceExists) {
                    console.log('[SELECT] Service exists in dropdown, selecting:', serviceId);
                    // Hidden select'e direkt service ID'yi set et
                    $('#orderform-service').val(serviceId);
                    
                    // UI'ı güncelle
                    const serviceName = targetService.name || targetService.origin_name || `Service ${serviceId}`;
                    $('#service-selected-text').text(serviceName);
                    $('#service-icon-container img').attr('src', getIconForService(serviceName));
                    
                    // Service change event'ini trigger et
                    $('#orderform-service').trigger('change');
                    
                    // Service bilgilerini güncelle
                    updateServiceInfo(targetService);
                    
                    // Flag'i reset et ve success callback çağır
                    setTimeout(() => {
                        isSelectionTriggeredBySearch = false;
                        console.log('[SELECT] Service selection complete');
                        
                        if (successCallback) {
                            successCallback();
                        }
                    }, 500);

                } else if (checkAttempts < maxAttempts) {
                    setTimeout(checkAndSelectService, 100);
                } else {
                    // Son çare: Servisi manuel ekle
                    forceAddAndSelectService(serviceId, targetService);
                    
                    // Flag'i reset et ve callback çağır
                    setTimeout(() => {
                        isSelectionTriggeredBySearch = false;
                        
                        if (successCallback) {
                            successCallback();
                        }
                    }, 500);
                }
            }
            
            // İlk kontrol hemen yap
            checkAndSelectService();
        });
    }
    
    // Select category from URL with callback
    function selectCategoryFromURL(categoryId, callback) {
        // Update hidden category select
        $('#orderform-category').val(categoryId);
        
        // Update category UI
        const categoryOption = $(`#orderform-category option[value="${categoryId}"]`);
        if (categoryOption.length) {
            const categoryText = categoryOption.text();
