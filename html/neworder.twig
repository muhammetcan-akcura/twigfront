        }
    });

    // Close modal with Escape key
    $(document).on('keydown', function(e) {
        if (e.key === 'Escape' && !$('#search-services-modal').hasClass('hidden')) {
            $('#search-services-modal').addClass('hidden');
        }
    });

    // Search functionality in modal with debounce for performance
    let searchTimeout;
    $('#modal-service-search').on('input', function() {
        const searchTerm = $(this).val();
        
        // Clear previous timeout
        clearTimeout(searchTimeout);
        
        // Show search spinner
        if (searchTerm.trim() !== '') {
            $('#services-container').html(`
                <div class="text-center py-8">
                    <i class="ri-loader-2-fill spinner-icon text-blue-500 text-2xl mb-3"></i>
                    <p class="text-gray-500 text-sm">Searching...</p>
                </div>
            `);
        }
        
        // Set new timeout for debounced search
        searchTimeout = setTimeout(() => {
            searchServices(searchTerm);
        }, 300); // 300ms delay
    });

    // Service selection from modal - removed to allow direct link navigation
    // Items will now redirect to their href URLs instead of selecting services via JavaScript

    // Function to update favorite toggle state
    function updateFavoriteToggle(isFavorite) {
        const $toggle = $('#favorite-toggle');
        const $dot = $toggle.siblings('label').find('.dot');
        const $bg = $toggle.siblings('label').find('div:first div:first');
        
        if (isFavorite) {
            $toggle.prop('checked', true);
            $bg.removeClass('bg-gray-300').addClass('bg-blue-600');
            $dot.removeClass('left-1').addClass('left-5');
        } else {
            $toggle.prop('checked', false);
            $bg.removeClass('bg-blue-600').addClass('bg-gray-300');
            $dot.removeClass('left-5').addClass('left-1');
        }
    }

    // Favorite toggle functionality
    $('#favorite-toggle').on('change', function() {
        const isChecked = $(this).is(':checked');
        const $dot = $(this).siblings('label').find('.dot');
        const $bg = $(this).siblings('label').find('div:first div:first');
        const $toggle = $(this);
        
        // Get current service ID
        const currentServiceId = $('#orderform-service').val();
        
        if (!currentServiceId) {
            console.log('No service selected, reverting toggle state');
            // Revert toggle state if no service is selected
            $toggle.prop('checked', !isChecked);
            return;
        }
        
        // Disable toggle during request
        $toggle.prop('disabled', true);
        
        // CSRF token
        var csrfToken = "{{ csrftoken }}";
        
        // Determine active state
        const activeState = isChecked ? 1 : 0;
        
        // AJAX request to update favorite status
        $.ajax({
            url: `/services/switch-favorite-service?active=${activeState}&service_id=${currentServiceId}`,
            type: 'POST',
            data: {
                _csrf: csrfToken
            },
            success: function(response) {
                // Update UI on success
                if (isChecked) {
                    $bg.removeClass('bg-gray-300').addClass('bg-blue-600');
                    $dot.removeClass('left-1').addClass('left-5');
                    console.log('Service added to favorites');
                } else {
                    $bg.removeClass('bg-blue-600').addClass('bg-gray-300');
                    $dot.removeClass('left-5').addClass('left-1');
                    console.log('Service removed from favorites');
                }
                
                // Update service data in window.modules if available
                if (window.modules && window.modules.siteOrder && window.modules.siteOrder.services) {
                    const service = window.modules.siteOrder.services[currentServiceId];
                    if (service) {
                        service.favorite = isChecked;
                        console.log('Updated service favorite status in cache');
                    }
                }
            },
            error: function(xhr, status, error) {
                // Revert toggle state on error
                $toggle.prop('checked', !isChecked);
                
                // Show error message (optional)
                if (xhr.responseJSON && xhr.responseJSON.message) {
                    alert('Error: ' + xhr.responseJSON.message);
                } else {
                    alert('An error occurred while updating favorite status');
                }
            },
            complete: function() {
                // Re-enable toggle
                $toggle.prop('disabled', false);
            }
        });
    });

    // Global function to manually select a service by ID
    window.selectServiceById = function(serviceId) {
        console.log('Manually selecting service:', serviceId);
        
        if (window.modules && window.modules.siteOrder && window.modules.siteOrder.services) {
            const targetService = window.modules.siteOrder.services[serviceId];
            if (targetService) {
                console.log('Found service data:', targetService.name || targetService.origin_name);
                selectServiceFromURL(serviceId, targetService);
                return true;
            } else {
                console.log('Service not found:', serviceId);
                return false;
            }
        } else {
            console.log('Services data not available');
            return false;
        }
    };

    // Show loading overlay
    function showLoadingOverlay() {
        $('#service-loading-overlay').removeClass('hidden');
        console.log('Loading overlay gösterildi');
    }
    
    // Hide loading overlay
    function hideLoadingOverlay() {
        $('#service-loading-overlay').addClass('hidden');
        console.log('Loading overlay gizlendi');
    }

    // Direct service selection without category change (for search results)
    function selectServiceDirectly(serviceId, serviceData) {
        isSelectionTriggeredBySearch = true;
        console.log('Direkt servis seçiliyor:', serviceData.name);
        console.log('Service data:', serviceData);
        
        // Show loading overlay at the start
        showLoadingOverlay();
        
        // Service data'sından category bilgisini bul
        const serviceCategoryId = serviceData.category_id ||
                                serviceData.categoryId ||
                                serviceData.cid ||
                                serviceData.cat_id ||
                                serviceData.category ||
                                serviceData.catId ||
                                findCategoryIdForService(serviceId);
        
        const currentCategoryId = $('#orderform-category').val();
        
        console.log('Mevcut kategori:', currentCategoryId, 'Servis kategorisi:', serviceCategoryId);
        
        if (serviceCategoryId && currentCategoryId == serviceCategoryId) {
            // Aynı kategoride, direkt seç
            console.log('Aynı kategoride, direkt seçiliyor');
            performDirectServiceSelection(serviceId, serviceData);
        } else if (serviceCategoryId) {
            // Farklı kategori, önce kategoriyi triggerla
            console.log('Farklı kategori, kategori triggerlaniyor:', serviceCategoryId);
            
            // Kategoriyi seç ve triggerla
            triggerCategorySelection(serviceCategoryId, getCategoryNameById(serviceCategoryId), function() {
                console.log('Kategori trigger başarılı, şimdi servis triggerlaniyor');
                // Kategori trigger başarılı, şimdi servisi triggerla
                performDirectServiceSelection(serviceId, serviceData);
            });
        } else {
            console.log('Kategori ID bulunamadı, mevcut kategoride deneniyor');
            // Kategori ID bulunamadı, mevcut kategoride dene
            performDirectServiceSelection(serviceId, serviceData);
        }
    }
    
    // Find category ID for service by searching all services
    function findCategoryIdForService(serviceId) {
        if (window.modules && window.modules.siteOrder && window.modules.siteOrder.services) {
            const allServices = window.modules.siteOrder.services;
            for (let sId in allServices) {
                if (sId == serviceId) {
                    const service = allServices[sId];
                    return service.category_id || service.categoryId || service.cid || service.cat_id || service.category || service.catId;
                }
            }
        }
        return null;
    }
    
    // Perform direct service selection
    function performDirectServiceSelection(serviceId, serviceData) {
        const serviceName = serviceData.name || serviceData.origin_name || `Service ${serviceId}`;
        
        // Hidden select'e set et - ÖNCE OPTION EKLE SONRA VALUE SET ET
        const $serviceSelect = $('#orderform-service');
        
        // Eğer option yoksa ekle
        if ($serviceSelect.find(`option[value="${serviceId}"]`).length === 0) {
            const $option = $(`<option value="${serviceId}">${serviceName}</option>`);
            $serviceSelect.append($option);
            console.log('Hidden select\'e yeni option eklendi:', serviceId, serviceName);
        }
        
        // Şimdi value'yu set et
        $serviceSelect.val(serviceId);
        console.log('Hidden select value set edildi:', serviceId, 'Actual value:', $serviceSelect.val());
        
        // UI'ı güncelle
        $('#service-selected-text').text(serviceName);
        $('#service-icon-container img').attr('src', getIconForService(serviceName));
        
        // Service dropdown'da highlight yap
        $('#service-menu li').removeClass('bg-gray-100');
        $(`#service-menu li[data-value="${serviceId}"]`).addClass('bg-gray-100');
        
        // Service change event'ini trigger et (sistem algılaması için)
        $serviceSelect.trigger('change');
        
        // Select2 trigger (varsa)
        if (typeof $.fn.select2 !== 'undefined') {
            try {
                $serviceSelect.select2('trigger', 'change');
                $serviceSelect.trigger('change.select2');
            } catch(e) {
                console.log('Select2 trigger failed:', e);
            }
        }
        
        // Service bilgilerini güncelle
        updateServiceInfo(serviceData);
        
        // Service card'ı güncelle
        updateServiceCard(serviceData);
        
        // Hide loading overlay after everything is complete
        hideLoadingOverlay();
        
        console.log('Direkt servis seçimi tamamlandı (tüm trigger\'lar çalıştırıldı):', serviceName);
        console.log('Final hidden select value:', $serviceSelect.val());
        setTimeout(() => {
            isSelectionTriggeredBySearch = false;
            console.log('isSelectionTriggeredBySearch flag reset to false after delay.');
        }, 500);
    }
    
    // Get category name by ID
    function getCategoryNameById(categoryId) {
        const categoryOption = $(`#orderform-category option[value="${categoryId}"]`);
        return categoryOption.length ? categoryOption.text() : 'Unknown Category';
    }
    
    // Trigger category selection and wait for success
    function triggerCategorySelection(categoryId, categoryName, successCallback) {
        console.log('Kategori triggerlaniyor:', categoryId, categoryName);
        
        // UI'ı güncelle
        $('#category-selected-text').text(categoryName);
        const iconUrl = getIconForService(categoryName);
        $('#category-icon-container img').attr('src', iconUrl);
        
        // Hidden select'i güncelle
        $('#orderform-category').val(categoryId);
        
        // Kategori dropdown'da highlight
        $('#category-menu li').removeClass('bg-gray-100');
        $(`#category-menu li[data-value="${categoryId}"]`).addClass('bg-gray-100');
        
        // Reset service selection flag - sadece manuel değişiklikte
        if (!isSelectionTriggeredBySearch) {
            isFirstServiceSelected = false;
        }
        
        // Kategori change event'ini triggerla
        $('#orderform-category').trigger('change');
        
        // Select2 trigger (varsa)
        if (typeof $.fn.select2 !== 'undefined') {
            try {
                $('#orderform-category').select2('trigger', 'change');
                $('#orderform-category').trigger('change.select2');
            } catch(e) {
                console.log('Category Select2 trigger failed:', e);
            }
        }
        
        // Kategori triggerladıktan sonra kısa bir süre bekle - sayaçla
        console.log('Kategori triggerladı, bekleme başlıyor...');
        
        let waitCounter = 0;
        const maxWaitTime = 150; // 150ms
        const intervalTime = 50; // Her 50ms'de sayaç güncelle
        
        const countInterval = setInterval(function() {
            waitCounter += intervalTime;
            console.log(`Bekleme süresi: ${waitCounter}ms / ${maxWaitTime}ms`);
            
            if (waitCounter >= maxWaitTime) {
                clearInterval(countInterval);
                console.log('Bekleme tamamlandı, service seçiliyor');
                if (successCallback) {
                    successCallback();
                }
            }
        }, intervalTime);
    }

    // Form Submit Handler - Seçilen servis ID'sini cookie'ye kaydet
    $('#order-form').on('submit', function(e) {
        const selectedServiceId = $('#orderform-service').val();
        console.log('[SUBMIT] Form submitting, selected service ID:', selectedServiceId);
        
        if (selectedServiceId && selectedServiceId !== '') {
            // ÖNCE eski cookie'yi sil, SONRA yeni cookie'yi yaz
            deleteCookie('selected_service_id');
            console.log('[SUBMIT] Old cookie deleted');
            // 1 dakikalık cookie olarak kaydet
            setCookie('selected_service_id', selectedServiceId, 1);
            console.log('[SUBMIT] New cookie saved:', selectedServiceId);
        } else {
            console.log('[SUBMIT] No service selected, clearing cookie');
            // Servis seçilmemişse cookie'yi temizle
            deleteCookie('selected_service_id');
        }
        
        // Form submit'i normal şekilde devam etsin
        return true;
    });

    // Cookie-based Service Auto-Selection Function
    function checkAndApplyCookieService() {
        const cookieServiceId = getCookie('selected_service_id');
        console.log('[COOKIE] Checking cookie, found ID:', cookieServiceId);
        
        if (cookieServiceId) {
            // Servis data'sını bul
            if (window.modules && window.modules.siteOrder && window.modules.siteOrder.services) {
                const targetService = window.modules.siteOrder.services[cookieServiceId];
                
                if (targetService) {
                    console.log('[COOKIE] Service found, selecting:', cookieServiceId);
                    // Cookie'yi servis seçimi BAŞARILI olduktan SONRA sil
                    selectServiceFromURL(cookieServiceId, targetService, function() {
                        console.log('[COOKIE] Selection successful, deleting cookie');
                        deleteCookie('selected_service_id');
                    });
                    return true;
                } else {
                    console.log('[COOKIE] Service not found in data, deleting cookie');
                    deleteCookie('selected_service_id');
                }
            } else {
                console.log('[COOKIE] Services data not ready, starting retry');
                // Retry mekanizması
                let retryCount = 0;
                const maxRetries = 10;
                
                function retryServiceSelection() {
                    retryCount++;
                    console.log('[COOKIE] Retry attempt:', retryCount);
                    
                    if (window.modules && window.modules.siteOrder && window.modules.siteOrder.services) {
                        const targetService = window.modules.siteOrder.services[cookieServiceId];
                        
                        if (targetService) {
                            console.log('[COOKIE] Retry successful, selecting:', cookieServiceId);
                            selectServiceFromURL(cookieServiceId, targetService, function() {
                                console.log('[COOKIE] Retry selection successful, deleting cookie');
                                deleteCookie('selected_service_id');
                            });
                        } else {
                            console.log('[COOKIE] Retry failed - service not found');
                            deleteCookie('selected_service_id');
                        }
                    } else if (retryCount < maxRetries) {
                        setTimeout(retryServiceSelection, 500);
                    } else {
                        console.log('[COOKIE] Max retries reached, giving up');
                        deleteCookie('selected_service_id');
                    }
                }
                
                setTimeout(retryServiceSelection, 500);
                return true;
            }
        }
        
        return false;
    }

    // Enhanced Service Parameter Check - Cookie önce, URL sonra
    function checkServiceSelection() {
        console.log('[INIT] checkServiceSelection called');
        // Önce cookie kontrolü yap
        const cookieServiceSelected = checkAndApplyCookieService();
        
        if (!cookieServiceSelected) {
            console.log('[INIT] No cookie, checking URL parameter');
            // Cookie'den servis seçilmediyse URL parametresini kontrol et
            checkURLServiceParameter();
        } else {
            console.log('[INIT] Cookie found, skipping URL check');
        }
    }

    // Ana kontrol - sayfa yüklendikten sonra çalıştır
    // Daha uzun bekleme süresi - services data'nın yüklenmesini garantilemek için
    setTimeout(function() {
        console.log('[INIT] Starting service selection after 500ms delay');
        checkServiceSelection();
    }, 500);

    // Service Search Input Functionality
    let serviceSearchTimeout;
    let serviceSearchDropdownOpen = false;
    
    $('#service-search-input').on('input', function() {
        const searchTerm = $(this).val().trim();
        const $menu = $('#service-search-menu');
        const $loading = $('#service-search-loading');
        const $noResults = $('#service-search-no-results');
        const $results = $('#service-search-results');
        
        // Clear previous timeout
        clearTimeout(serviceSearchTimeout);
        
        if (searchTerm.length < 2) {
            $menu.addClass('hidden');
            serviceSearchDropdownOpen = false;
            return;
        }
        
        // Show dropdown and loading state
        $menu.removeClass('hidden');
        $loading.removeClass('hidden');
        $noResults.addClass('hidden');
        $results.empty();
        serviceSearchDropdownOpen = true;
        
        // Debounce search
        serviceSearchTimeout = setTimeout(() => {
            performServiceSearch(searchTerm);
        }, 300);
    });
    
    // Perform service search
    function performServiceSearch(searchTerm) {
        const $loading = $('#service-search-loading');
        const $noResults = $('#service-search-no-results');
        const $results = $('#service-search-results');
        
        let foundServices = [];
        
        // Search in window.modules.siteOrder.services if available
        if (window.modules && window.modules.siteOrder && window.modules.siteOrder.services) {
            const allServices = window.modules.siteOrder.services;
            
            for (let serviceId in allServices) {
                const service = allServices[serviceId];
                const serviceName = (service.name || service.origin_name || '').toLowerCase();
                
                if (serviceName.includes(searchTerm.toLowerCase())) {
                    // Full service data with category_id
                    foundServices.push({
                        id: serviceId,
                        name: service.name || service.origin_name,
                        price: service.price || '0.00',
                        min: service.min || '1',
                        max: service.max || '1000',
                        avgTime: service.average_time !== 'Not Enough Data' ? service.average_time : 'Instant',
                        category_id: service.category_id || service.categoryId || service.cid || service.cat_id || service.category || service.catId,
                        // Include original service data for full compatibility
                        originalData: service
                    });
                }
            }
        }
        
        $loading.addClass('hidden');
        
        if (foundServices.length === 0) {
            $noResults.removeClass('hidden');
        } else {
            $noResults.addClass('hidden');
            
            // Limit to first 10 results for performance
            const servicesToShow = foundServices.slice(0, 10);
            
            servicesToShow.forEach(service => {
                const iconUrl = getIconForService(service.name);
                const serviceName = `${service.name} - $${service.price}`;
                
                const $serviceItem = $(`
                    <li class="px-4 py-2 hover:bg-gray-100 cursor-pointer flex items-center gap-3" data-service-id="${service.id}">
                        <img src="${iconUrl}" alt="Service Icon" class="w-[22px] h-[22px] object-contain">
                        <span class="font-medium">${serviceName}</span>
                    </li>
                `);
                
                // Click handler for direct service selection
                $serviceItem.on('click', function() {
                    const serviceId = $(this).data('service-id');
                    
                    // Close search dropdown
                    $('#service-search-menu').addClass('hidden');
                    serviceSearchDropdownOpen = false;
                    
                    // Clear search input
                    $('#service-search-input').val('');
                    
                    console.log('Search\'ten servis seçildi:', service.name, 'ID:', serviceId);
                    console.log('Service full data:', service);
                    
                    // Tam service data'sını (originalData veya kendisi) kullan
                    const fullServiceData = service.originalData || service;
                    
                    // Direkt servis seçimi
                    selectServiceDirectly(serviceId, fullServiceData);
                });
                
                $results.append($serviceItem);
            });
        }
    }
    
    // Close search dropdown when clicking outside
    $(document).on('click', function(e) {
        if (!$(e.target).closest('#service-search-dropdown').length && serviceSearchDropdownOpen) {
            $('#service-search-menu').addClass('hidden');
            serviceSearchDropdownOpen = false;
        }
    });
    
    // Focus behavior for search input
    $('#service-search-input').on('focus', function() {
        const searchTerm = $(this).val().trim();
        if (searchTerm.length >= 2) {
            $('#service-search-menu').removeClass('hidden');
            serviceSearchDropdownOpen = true;
        }
    });
    
    // Prevent dropdown close when clicking inside the search input area
    $('#service-search-dropdown').on('click', function(e) {
        e.stopPropagation();
    });

});
</script>