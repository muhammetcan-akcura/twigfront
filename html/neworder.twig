    // Function to dynamically position the more platforms dropdown
    function positionMorePlatformsDropdown($button, $dropdown) {
        const windowWidth = $(window).width();
        const buttonOffset = $button.offset();
        const buttonWidth = $button.outerWidth();
        const dropdownWidth = $dropdown.outerWidth();
        
        // Reset any previous positioning styles
        $dropdown.css({
            'left': '',
            'right': '',
            'transform': ''
        });
        
        // Check if dropdown would overflow on the right side
        const wouldOverflowRight = (buttonOffset.left + dropdownWidth) > windowWidth;
        
        // Check if dropdown would overflow on the left side (when positioned to the left)
        const wouldOverflowLeft = (buttonOffset.left + buttonWidth - dropdownWidth) < 0;
        
        if (windowWidth <= 768) { // Mobile screens
            if (wouldOverflowRight && !wouldOverflowLeft) {
                // Position to the right edge of the button
                $dropdown.css({
                    'left': 'auto',
                    'right': '0',
                    'transform': 'none'
                });
            } else if (wouldOverflowLeft && !wouldOverflowRight) {
                // Position to the left edge of the button
                $dropdown.css({
                    'left': '0',
                    'right': 'auto',
                    'transform': 'none'
                });
            } else if (wouldOverflowRight && wouldOverflowLeft) {
                // Center but constrain to screen edges
                const maxLeft = windowWidth - dropdownWidth - 10; // 10px margin
                const minLeft = 10; // 10px margin
                const centerLeft = buttonOffset.left + (buttonWidth / 2) - (dropdownWidth / 2);
                const finalLeft = Math.max(minLeft, Math.min(maxLeft, centerLeft));
                
                $dropdown.css({
                    'left': finalLeft - buttonOffset.left + 'px',
                    'right': 'auto',
                    'transform': 'none'
                });
            } else {
                // Use default centered positioning
                $dropdown.css({
                    'left': '50%',
                    'right': 'auto',
                    'transform': 'translateX(-50%)'
                });
            }
        } else { // Desktop screens
            // Use default centered positioning for desktop
            $dropdown.css({
                'left': '50%',
                'right': 'auto',
                'transform': 'translateX(-50%)'
            });
        }
    }
    
