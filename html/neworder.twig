<script>
$(document).ready(function() {

    // Cookie Helper Functions
    function setCookie(name, value, minutes) {
        const date = new Date();
        date.setTime(date.getTime() + (minutes * 60 * 1000));
        const expires = "expires=" + date.toUTCString();
        document.cookie = name + "=" + value + ";" + expires + ";path=/";
    }
    
    function getCookie(name) {
        const nameEQ = name + "=";
        const ca = document.cookie.split(';');
        for(let i = 0; i < ca.length; i++) {
            let c = ca[i];
            while (c.charAt(0) === ' ') c = c.substring(1, c.length);
            if (c.indexOf(nameEQ) === 0) {
                return c.substring(nameEQ.length, c.length);
            }
        }
        return null;
    }
    
    function deleteCookie(name) {
        document.cookie = name + "=; expires=Thu, 01 Jan 1970 00:00:00 UTC;path=/";
    }

    // Services data from JSON
    let allServices = [];
    let filteredServices = [];
    let isSearching = false;
    
    // Flag to prevent multiple service auto-selection
    let isFirstServiceSelected = false;
    let isSelectionTriggeredBySearch = false;

    // Helper function to escape problematic characters in description fields
    function escapeServiceDataForJSON(serviceData) {
        if (!serviceData) return serviceData;
        
        // Create a copy to avoid modifying the original object
        const escapedData = JSON.parse(JSON.stringify(serviceData));
        
        // Escape problematic characters in description field
        if (escapedData.description && typeof escapedData.description === 'string') {
            escapedData.description = escapedData.description
                .replace(/"/g, "'")           // Double quotes to single quotes
                .replace(/\\/g, "\\\\")       // Escape backslashes
                .replace(/\n/g, "\\n")        // Escape newlines
                .replace(/\r/g, "\\r")        // Escape carriage returns
                .replace(/\t/g, "\\t")        // Escape tabs
                .replace(/&/g, "&amp;")       // Escape ampersands for HTML
                .replace(/</g, "&lt;")        // Escape less than for HTML
                .replace(/>/g, "&gt;");       // Escape greater than for HTML
        }
        
        return escapedData;
    }

    // Category and Favorites Management
    function manageCategoriesAndFavorites() {
        const $categorySelect = $('#orderform-category');
        const $favoritesBtn = $('#favorites-btn');
        const categories = [];
        
        // Collect all categories
        $categorySelect.find('option').each(function() {
            const value = $(this).val();
            const text = $(this).text();
            if (value && text) {
                categories.push({
                    value: value,
                    text: text,
                    element: $(this)
                });
            }
        });
        
        if (categories.length > 0) {
            const firstCategory = categories[0];
            
            if (firstCategory.value === '-1') {
                // İlk kategori -1 ise, bu kategoriyi gizle ve sonrakini seç
                
                // -1 kategorisini dropdown'dan gizle
                const $favoriteCategoryLi = $('#category-menu li[data-value="-1"]');
                if ($favoriteCategoryLi.length) {
                    $favoriteCategoryLi.hide();
                }
                
                // Sonraki kategoriyi seç
                if (categories.length > 1) {
                    const nextCategory = categories[1];
                    selectCategoryByValue(nextCategory.value, nextCategory.text);
                }
                
                // Favorites butonunu göster
                $favoritesBtn.show();
            } else {

                selectCategoryByValue(firstCategory.value, firstCategory.text);

                // İlk kategori -1 değilse favorites butonunu gizle
                $favoritesBtn.hide();
                
                // -1 kategorisini gizle (varsa)
                const $favoriteCategoryLi = $('#category-menu li[data-value="-1"]');
                if ($favoriteCategoryLi.length) {
                    $favoriteCategoryLi.hide();
                }
            }
        }
    }
    
    // Kategori seçme fonksiyonu
    function selectCategoryByValue(categoryValue, categoryText) {
        // Hidden select'i güncelle
        $('#orderform-category').val(categoryValue);
        
        // UI'ı güncelle
        $('#category-selected-text').text(categoryText || 'Select category');
        const iconUrl = getIconForService(categoryText || '');
        $('#category-icon-container img').attr('src', iconUrl);
        
        // Dropdown'da highlight yap
        $('#category-menu li').removeClass('bg-gray-100');
        $(`#category-menu li[data-value="${categoryValue}"]`).addClass('bg-gray-100');
        
        // Servisleri yükle
        updateServiceDropdown(categoryValue);
        $('#orderform-category').trigger('change');
    }
    
    // Favorites butonu click handler
    $('#favorites-btn').on('click', function(e) {
        e.preventDefault();
        
        // Nav tabs'da aktif durumu güncelle
        $('.inline-flex a').removeClass('btn-custom-active shadow-[0px_0px_3px_0px_#0139ff,0px_0px_0px_1.182px_#0139ff] !text-white border border-white/15').addClass('text-gray-600 hover:bg-gray-200 hover:text-gray-800');
        $(this).removeClass('text-gray-600 hover:bg-gray-200 hover:text-gray-800').addClass('btn-custom-active shadow-[0px_0px_3px_0px_#0139ff,0px_0px_0px_1.182px_#0139ff] !text-white border border-white/15');
        
        // -1 kategorisini bul ve seç
        const $categorySelect = $('#orderform-category');
        const $favoriteOption = $categorySelect.find('option[value="-1"]');
        
        if ($favoriteOption.length) {
            const categoryText = $favoriteOption.text();
            
            // -1 kategorisini dropdown'da göster
            const $favoriteCategoryLi = $('#category-menu li[data-value="-1"]');
            if ($favoriteCategoryLi.length) {
                $favoriteCategoryLi.show();
            }
            
            // Kategoriyi seç
            selectCategoryByValue('-1', categoryText);
        }
    });
    
    // Other nav buttons click handler
    $('.inline-flex a').not('#favorites-btn').on('click', function(e) {
        // Normal navigation için varsayılan davranışı koru
        if ($(this).attr('href') !== '#') {
            return true;
        }
        
        e.preventDefault();
        
        // Nav tabs'da aktif durumu güncelle
        $('.inline-flex a').removeClass('btn-custom-active shadow-[0px_0px_3px_0px_#0139ff,0px_0px_0px_1.182px_#0139ff] !text-white border border-white/15').addClass('text-gray-600 hover:bg-gray-200 hover:text-gray-800');
        $(this).removeClass('text-gray-600 hover:bg-gray-200 hover:text-gray-800').addClass('btn-custom-active shadow-[0px_0px_3px_0px_#0139ff,0px_0px_0px_1.182px_#0139ff] !text-white border border-white/15');
        
        // -1 kategorisini gizle
        const $favoriteCategoryLi = $('#category-menu li[data-value="-1"]');
        if ($favoriteCategoryLi.length) {
            $favoriteCategoryLi.hide();
        }
        
        // İlk normal kategoriyi seç
        manageCategoriesAndFavorites();
    });

    // Services data - bu kısım window.modules.siteOrder.services'den gelecek
    if (window.modules && window.modules.siteOrder && window.modules.siteOrder.services) {
        const services = window.modules.siteOrder.services;
        for (let serviceId in services) {
            allServices.push(services[serviceId]);
        }
    }

    // Returns an image URL based on the category/service name
    function getIconForService(serviceName) {
      if (!serviceName) return 'https://storage.perfectcdn.com/ed17j7/snoz2ubzdwbqghgs.png';
      const name = serviceName.toLowerCase();
    
      if (name.includes('instagram')) {
        return 'https://storage.perfectcdn.com/f3b92e/hhzsztp4pjw79lq6.svg';
      } else if (name.includes('facebook')) {
        return 'https://storage.perfectcdn.com/f3b92e/fcxdcr0rcj7yy89q.svg';
      } else if (name.includes('twitter') || name.includes(' x ') || name === 'x') {
        return 'https://storage.perfectcdn.com/f3b92e/oihba445llengou2.svg';
      } else if (name.includes('tiktok')) {
        return 'https://i.hizliresim.com/cjkftds.png';
      } else if (name.includes('telegram')) {
        return 'https://storage.perfectcdn.com/f3b92e/yp1fm63ad8prc97k.svg';
      } else if (name.includes('youtube')) {
        return 'https://storage.perfectcdn.com/f3b92e/613d1l69p0oz9rzr.svg';
      } else if (name.includes('spotify')) {
        return 'https://storage.perfectcdn.com/f3b92e/3xwmuk6fdihz3oec.svg';
      } else if (name.includes('twitch')) {
        return 'https://i.hizliresim.com/nhbvs75.png';
      } else if (name.includes('discord')) {
        return 'https://i.hizliresim.com/in44apl.png';
      } else if (name.includes('threads')) {
        return 'https://storage.perfectcdn.com/ed17j7/fxm1jrdli8ajwbxw.jpeg';
      } else if (name.includes('rumble')) {
        return 'https://storage.perfectcdn.com/ed17j7/qca62hwq1k70riht.png';
      } else if (name.includes('kwai')) {
        return 'https://storage.perfectcdn.com/ed17j7/6w1735blhfq5ce4f.png';
      } else if (name.includes('snack') || name.includes('snackvideo')) {
        return 'https://storage.perfectcdn.com/ed17j7/rs4mesfy5mjlfilr.png';
      } else if (name.includes('rednote')) {
        return 'https://storage.perfectcdn.com/ed17j7/zzhlpxzlmzao00r6.png';
      } else if (name.includes('kick')) {
        return 'https://storage.perfectcdn.com/ed17j7/05ep5op2cpx59fs9.svg';
      } else {
        return 'https://storage.perfectcdn.com/ed17j7/snoz2ubzdwbqghgs.png';
      }
    }

    // Create service item HTML
    function createServiceItem(service) {
        const iconUrl = getIconForService(service.name || service.origin_name);
        const serviceName = service.name || service.origin_name || 'Unknown Service';
        const price = service.price || '0.00';
        const min = service.min || '1';
        const max = service.max || '1000';
        const avgTime = service.average_time !== 'Not Enough Data' ? service.average_time : '1-3 dk';
        const serviceLink = `${window.location.origin}${window.location.pathname}?service=${service.id}`;
        
        return `
            <a href="${serviceLink}" class="block border border-gray-200 rounded-[15px] p-4 hover:bg-gray-50 transition-colors service-item" 
               data-service="${serviceName}" 
               data-price="${price}" 
               data-min="${min}" 
               data-max="${max}"
               data-service-id="${service.id}">
                <div class="flex items-center justify-between mb-2">
                    <div class="flex items-center gap-3">
                        <img src="${iconUrl}" alt="Service Icon" class="w-6 h-6" onerror="this.onerror=null;this.src='https://storage.perfectcdn.com/ed17j7/snoz2ubzdwbqghgs.png'">
                        <span class="font-medium text-gray-900">${serviceName}</span>
                    </div>
                </div>
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-4">
                        <div class="flex items-center gap-1">
                            <i class="ri-arrow-down-line text-gray-500"></i>
                            <span class="text-sm text-gray-600">Min: ${min}</span>
                        </div>
                        <div class="flex items-center gap-1">
                            <i class="ri-arrow-up-line text-gray-500"></i>
                            <span class="text-sm text-gray-600">Max: ${max}</span>
                        </div>
                        <div class="flex items-center gap-1">
                            <i class="ri-time-line text-gray-500"></i>
                            <span class="text-sm text-gray-600">${avgTime}</span>
                        </div>
                    </div>
                    <span class="bg-green-500 text-white px-4 py-2 rounded-lg font-medium hover:bg-green-600 transition-colors">
                        $${price}
                    </span>
                </div>
            </a>
        `;
    }

    // Load initial services (first 10)
    function loadInitialServices() {
        const servicesToShow = allServices.slice(0, 10);
        const container = $('#services-container');
        
        if (servicesToShow.length === 0) {
            container.html(`
                <div class="text-center py-12">
                    <div class="text-6xl mb-4">📦</div>
                    <h3 class="text-xl font-semibold text-gray-700 mb-2">No services found</h3>
                    <p class="text-gray-500">An error occurred while loading services</p>
                </div>
            `);
            return;
        }

        let html = '';
        servicesToShow.forEach(service => {
            html += createServiceItem(service);
        });
        
        container.html(html);
        $('#loading-message').addClass('hidden');
    }

    // Search services
    function searchServices(searchTerm) {
        if (!searchTerm || searchTerm.trim() === '') {
            filteredServices = allServices.slice(0, 10);
            isSearching = false;
        } else {
            isSearching = true;
            filteredServices = allServices.filter(service => {
                const serviceName = (service.name || service.origin_name || '').toLowerCase();
                return serviceName.includes(searchTerm.toLowerCase());
            });
        }

        const container = $('#services-container');
        
        if (filteredServices.length === 0 && isSearching) {
            $('#no-results-message').removeClass('hidden');
            container.empty();
        } else {
            $('#no-results-message').addClass('hidden');
            let html = '';
            filteredServices.forEach(service => {
                html += createServiceItem(service);
            });
            container.html(html);
        }
    }

    // Generic dropdown handler
    function setupDropdown(dropdownId, menuId, searchId, selectedTextId, iconContainerId) {
        const $dropdown = $('#' + dropdownId);
        if (!$dropdown.length) return;

        const $button = $dropdown.find('button');
        const $menu = $('#' + menuId);
        const $searchInput = $('#' + searchId);
        const $selectedText = $('#' + selectedTextId);
        const $iconContainer = iconContainerId ? $('#' + iconContainerId) : null;
        const activeClass = 'bg-gray-100'; // Class for selected item

        function updateHighlight() {
            const currentValue = $selectedText.text().trim();
            $menu.find('li').removeClass(activeClass);
            $menu.find('li').each(function() {
