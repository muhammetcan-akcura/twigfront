<script>
document.addEventListener('DOMContentLoaded', function() {
    // Tab buttons - using IDs for reliable selection
    const wordpressTab = document.getElementById('wordpress-tab');
    const customDevTab = document.getElementById('custom-dev-tab');
    
    // Content sections
    const wordpressContent = document.querySelector('.mb-20.animate-in');
    const customDevContent = document.getElementById('custom-dev-content');
    const comparisonContent = document.getElementById('comparison-content');
    
    // Initially hide custom development content and show comparison
    if (customDevContent) {
        customDevContent.style.display = 'none';
    }
    if (comparisonContent) {
        comparisonContent.style.display = 'block';
    }
    
    // Function to set WordPress tab as active
    function setWordPressActive() {
        // Remove all active/inactive classes first
        wordpressTab.classList.remove('inactive-tab');
        customDevTab.classList.remove('active-tab');
        
        // Add active class to WordPress tab
        wordpressTab.classList.add('active-tab');
        customDevTab.classList.add('inactive-tab');
        
        // Update WordPress tab styling
        wordpressTab.className = 'tab-button active-tab flex items-center gap-3 px-6 py-4 rounded-xl transition-all duration-300 shadow-lg bg-[var(--primary-blue)] text-white';
        
        // Update Custom Dev tab styling
        customDevTab.className = 'tab-button inactive-tab flex items-center gap-3 px-6 py-4 rounded-xl transition-all duration-300 hover:bg-slate-50 text-[var(--text-dark)] bg-transparent';
        
        // Update icon colors
        const wpIcon = wordpressTab.querySelector('.tab-icon');
        const wpTitle = wordpressTab.querySelector('.tab-title');
        const wpSubtitle = wordpressTab.querySelector('.tab-subtitle');
        
        if (wpIcon) wpIcon.className = 'tab-icon text-white';
        if (wpTitle) wpTitle.className = 'font-semibold tab-title text-white';
        if (wpSubtitle) wpSubtitle.className = 'text-xs tab-subtitle text-white/80';
        
        const cdIcon = customDevTab.querySelector('.tab-icon');
        const cdTitle = customDevTab.querySelector('.tab-title');
        const cdSubtitle = customDevTab.querySelector('.tab-subtitle');
        
        if (cdIcon) cdIcon.className = 'tab-icon text-purple-500';
        if (cdTitle) cdTitle.className = 'font-semibold tab-title text-[var(--text-dark)]';
        if (cdSubtitle) cdSubtitle.className = 'text-xs tab-subtitle text-[var(--text-dark)]';
        
        // Update comparison section borders - WordPress active
        const comparisonCards = document.querySelectorAll('#comparison-content .rounded-2xl');
        if (comparisonCards.length >= 2) {
            // WordPress card (first) - add blue border
            comparisonCards[0].className = 'rounded-2xl shadow-lg p-8 border transition-all duration-300 ring-2 bg-[var(--light-bg)] border-[var(--border-color)] ring-[var(--primary-blue)]/30';
            // Custom Dev card (second) - remove purple border
            comparisonCards[1].className = 'rounded-2xl shadow-lg p-8 border transition-all duration-300 bg-[var(--light-bg)] border-[var(--border-color)]';
        }
    }
    
    // Function to set Custom Development tab as active
    function setCustomDevActive() {
        // Remove all active/inactive classes first
        customDevTab.classList.remove('inactive-tab');
        wordpressTab.classList.remove('active-tab');
        
        // Add active class to Custom Dev tab
        customDevTab.classList.add('active-tab');
        wordpressTab.classList.add('inactive-tab');
        
        // Update Custom Dev tab styling
        customDevTab.className = 'tab-button active-tab flex items-center gap-3 px-6 py-4 rounded-xl transition-all duration-300 shadow-lg bg-purple-500 text-white';
        
        // Update WordPress tab styling
        wordpressTab.className = 'tab-button inactive-tab flex items-center gap-3 px-6 py-4 rounded-xl transition-all duration-300 hover:bg-slate-50 text-[var(--text-dark)] bg-transparent';
        
        // Update icon colors
        const cdIcon = customDevTab.querySelector('.tab-icon');
        const cdTitle = customDevTab.querySelector('.tab-title');
        const cdSubtitle = customDevTab.querySelector('.tab-subtitle');
        
        if (cdIcon) cdIcon.className = 'tab-icon text-white';
        if (cdTitle) cdTitle.className = 'font-semibold tab-title text-white';
        if (cdSubtitle) cdSubtitle.className = 'text-xs tab-subtitle text-white/80';
        
        const wpIcon = wordpressTab.querySelector('.tab-icon');
        const wpTitle = wordpressTab.querySelector('.tab-title');
        const wpSubtitle = wordpressTab.querySelector('.tab-subtitle');
        
        if (wpIcon) wpIcon.className = 'tab-icon text-[var(--primary-blue)]';
        if (wpTitle) wpTitle.className = 'font-semibold tab-title text-[var(--text-dark)]';
        if (wpSubtitle) wpSubtitle.className = 'text-xs tab-subtitle text-[var(--text-dark)]';
        
        // Update comparison section borders - Custom Dev active
        const comparisonCards = document.querySelectorAll('#comparison-content .rounded-2xl');
        if (comparisonCards.length >= 2) {
            // WordPress card (first) - remove blue border
            comparisonCards[0].className = 'rounded-2xl shadow-lg p-8 border transition-all duration-300 bg-[var(--light-bg)] border-[var(--border-color)]';
            // Custom Dev card (second) - add purple border
            comparisonCards[1].className = 'rounded-2xl shadow-lg p-8 border transition-all duration-300 ring-2 bg-[var(--light-bg)] border-[var(--border-color)] ring-purple-500/30';
        }
    }
    
    // WordPress tab click handler
    if (wordpressTab) {
        wordpressTab.addEventListener('click', function() {
            setWordPressActive();
            
            // Show WordPress content and comparison, hide Custom Development content
            if (wordpressContent) {
                wordpressContent.style.display = 'block';
                wordpressContent.classList.add('animate-in', 'fade-in', 'duration-500');
            }
            if (customDevContent) {
                customDevContent.style.display = 'none';
            }
            if (comparisonContent) {
                comparisonContent.style.display = 'block';
            }
        });
    }
    
    // Custom Development tab click handler
    if (customDevTab) {
        customDevTab.addEventListener('click', function() {
            setCustomDevActive();
            
            // Show Custom Development content, hide WordPress content, keep comparison visible
            if (customDevContent) {
                customDevContent.style.display = 'block';
                customDevContent.classList.add('animate-in', 'fade-in', 'duration-500');
            }
            if (wordpressContent) {
                wordpressContent.style.display = 'none';
            }
            if (comparisonContent) {
                comparisonContent.style.display = 'block';
            }
        });
    }
    
    // Initialize with WordPress tab active
    setWordPressActive();
    
    // Modal functionality
    const modalOverlay = document.getElementById('modal-overlay');
    const modalContents = document.querySelectorAll('.modal-content');
    const viewDetailsBtns = document.querySelectorAll('.view-details-btn');
    const closeBtns = document.querySelectorAll('.modal-close');
    
    // Function to open modal
    function openModal(modalId) {
        const modal = document.getElementById(modalId);
        if (modal && modalOverlay) {
            modalOverlay.classList.remove('hidden');
            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden'; // Prevent background scrolling
        }
    }
    
    // Function to close modal
    function closeModal() {
        if (modalOverlay) {
            modalOverlay.classList.add('hidden');
            modalContents.forEach(modal => {
                modal.classList.add('hidden');
            });
            document.body.style.overflow = ''; // Restore scrolling
        }
    }
    
    // Event listeners for view details buttons
    viewDetailsBtns.forEach(btn => {
        btn.addEventListener('click', function() {
            const modalId = this.getAttribute('data-modal');
            openModal(modalId);
        });
    });
    
    // Event listeners for close buttons
    closeBtns.forEach(btn => {
        btn.addEventListener('click', closeModal);
    });
    
    // Close modal when clicking on overlay
    if (modalOverlay) {
        modalOverlay.addEventListener('click', function(e) {
            if (e.target === modalOverlay) {
                closeModal();
            }
        });
    }
    
    // Close modal with Escape key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeModal();
        }
    });
});
// Modal Animations
document.addEventListener('DOMContentLoaded', function() {
    const detailsBtns = document.querySelectorAll('.view-details-btn');
    const modalOverlay = document.getElementById('modal-overlay');
    const modalCloseButtons = document.querySelectorAll('.modal-close');
    
    // Add Tailwind classes for transitions
    modalOverlay.classList.add('transition-opacity', 'duration-300', 'ease-in-out');
    document.querySelectorAll('.modal-content').forEach(modal => {
        modal.classList.add('transform', 'transition-all', 'duration-300', 'ease-in-out');
    });
    
    detailsBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
            const modalId = this.getAttribute('data-modal');
            const modal = document.getElementById(modalId);
            
            if (modal && modalOverlay) {
                // Show overlay with fade
                modalOverlay.classList.remove('hidden');
                requestAnimationFrame(() => {
                    modalOverlay.classList.add('opacity-100');
                });
                
                // Show and animate modal
                modal.classList.remove('hidden');
                modal.classList.add('scale-95', 'opacity-0');
                requestAnimationFrame(() => {
                    modal.classList.remove('scale-95', 'opacity-0');
                    modal.classList.add('scale-100', 'opacity-100');
                });
            }
        });
    });

    function closeModal() {
        const activeModal = document.querySelector('.modal-content:not(.hidden)');
        
        if (activeModal) {
            // Animate modal out
            activeModal.classList.remove('scale-100', 'opacity-100');
            activeModal.classList.add('scale-95', 'opacity-0');
        }
        
        // Fade out overlay
        modalOverlay.classList.remove('opacity-100');
        
        // Wait for animations to finish
        setTimeout(() => {
            if (activeModal) activeModal.classList.add('hidden');
            modalOverlay.classList.add('hidden');
        }, 300);
    }
    
    modalCloseButtons.forEach(function(btn) {
        btn.addEventListener('click', closeModal);
    });
    
    modalOverlay.addEventListener('click', function(e) {
        if (e.target === modalOverlay) {
            closeModal();
        }
    });
    
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeModal();
        }
    });
});
</script>
