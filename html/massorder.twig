<style>
/* Mass order: same scale/width/palette as tickets pages */
.mo-page { zoom: 0.805; }
@media (max-width: 767px) { .mo-page { zoom: 0.98; } }
.mo-page .mo-solid {
    background: linear-gradient(0deg, rgba(255,255,255,0.16) 6.48%, rgba(255,255,255,0) 100%), #134de2;
    border: 1px solid #4580f7;
    color: #ffffff;
}
.mo-page .mo-solid:hover { background: #103fad; border-color: #103fad; }
.mo-page .mo-ghost { border: 1px solid #e5e7eb; color: #4b5563; background: #ffffff; }
.mo-page .mo-ghost:hover { border-color: #9db8fb; color: #134de2; }
.mo-page .mo-ghost-blue { border: 1px solid #c7d7fe; color: #134de2; background: #eef3ff; }
.mo-page .mo-ghost-blue:hover { background: #e0e9ff; }
.mo-page .mo-textarea:focus { border-color: #4580f7 !important; box-shadow: 0 0 0 3px rgba(69,128,247,0.15) !important; outline: none; }
html.dark-mode .mo-page .mo-ghost { background: transparent; border-color: #334155; color: #cbd5e1; }
html.dark-mode .mo-page .mo-ghost:hover { border-color: #4580f7; color: #7aa2fa; }
html.dark-mode .mo-page .mo-ghost-blue { background: rgba(69,128,247,0.15); border-color: rgba(69,128,247,0.4); color: #9db8fb; }
</style>

<div class="mo-page relative z-10 pb-16 md:pb-15 bg-white pt-6">
    <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-[986px] mx-auto">

            <!-- Mass Order Card -->
            <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
                <!-- Header -->
                <div class="border-b border-gray-200 px-5 py-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                    <h2 class="text-base font-semibold text-gray-800 flex items-center gap-2">
                        <i class="ri-stack-line text-lg text-gray-700 font-normal"></i>
                        Mass Order
                    </h2>
                    <div class="flex items-center gap-2">
                        <button type="button" id="howToMassOrderBtn" class="mo-ghost inline-flex items-center gap-1.5 h-8 px-3 rounded-lg text-xs font-medium transition-colors">
                            <i class="ri-question-line text-sm"></i>
                            <span>How to mass order?</span>
                        </button>
                        <button type="button" id="openFormatGeneratorBtn" class="mo-ghost-blue inline-flex items-center gap-1.5 h-8 px-3 rounded-lg text-xs font-semibold transition-colors">
                            <i class="ri-magic-line text-sm"></i>
                            <span>Quick Format Generator</span>
                        </button>
                    </div>
                </div>

                <div class="p-5">
                    <form {% if site['rtl'] %}class="space-y-4 rtl-form"{% else %}class="space-y-4"{% endif %} method="post" action="{{ page['url'] }}">
                        {% if 1 == success %}
                            <div class="bg-green-50 border border-green-200 rounded-lg p-3 text-sm" role="alert">
                                <button type="button" class="float-right text-green-500 hover:text-green-700 text-lg leading-none" onclick="this.parentElement.style.display='none'">&times;</button>
                                <div class="text-green-800 font-semibold mb-1">{{lang('massorder.message.success')}}</div>
                                <div class="text-green-700">
                                    {{lang('massorder.orders')}}: {{order['success']}}<br>
                                    {{lang('massorder.errors')}}: {{order['error']}}<br>
                                    <a href="{{ order['link'] }}" target="_blank" class="text-blue-600 hover:text-blue-800 underline">{{ lang('massorder.button.details') }}</a>
                                </div>
                            </div>
                        {%endif%}
                        {% if error %}
                            <div class="bg-red-50 border border-red-200 rounded-lg p-3 text-sm {% if site['rtl'] %} rtl-alert {% endif %}" role="alert">
                                <button type="button" class="float-right text-red-500 hover:text-red-700 text-lg leading-none" onclick="this.parentElement.style.display='none'">&times;</button>
                                {% if order['link'] %}
                                    <div class="text-red-800 font-semibold mb-1">{{ errorText }}</div>
                                    <div class="text-red-700">
                                        {{lang('massorder.orders')}}: {{order['success']}}<br>
                                        {{lang('massorder.errors')}}: {{order['error']}}<br>
                                        <a href="{{ order['link'] }}" target="_blank" class="text-blue-600 hover:text-blue-800 underline">{{ lang('massorder.button.details') }}</a>
                                    </div>
                                {% else %}
                                    <div class="text-red-700">{{ errorText }}</div>
                                {% endif %}
                            </div>
                        {% endif %}

                        <div class="form-group">
                            <label for="links" class="block text-sm font-semibold text-gray-700 mb-2">{{ lang('massorder.label') }}</label>
                            <textarea
                                class="mo-textarea w-full border border-gray-300 rounded-lg px-3 py-2.5 resize-y font-mono text-sm leading-relaxed transition-colors"
                                name="MassOrderForm[orders]"
                                rows="10"
                                id="links"
                                placeholder="{{ lang('massorder.placeholder') }}"></textarea>
                        </div>

                        <input type="hidden" name="_csrf" value="{{csrftoken}}">

                        <button type="submit" class="mo-solid w-full flex items-center justify-center gap-2 font-semibold text-sm rounded-lg transition-colors h-10">
                            <span>{{ lang('massorder.button') }}</span>
                            <i class="ri-arrow-right-line text-base"></i>
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- How to Mass Order Modal -->
<div id="massOrderModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex items-center justify-center">
    <div class="bg-white rounded-xl max-w-xl w-full mx-4 max-h-[80vh] overflow-y-auto">
        <div class="p-5">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-base font-semibold text-gray-800">How to Mass Order?</h3>
                <button id="closeModal" class="text-gray-500 hover:text-gray-700 text-2xl">
                    <i class="ri-close-line"></i>
                </button>
            </div>
            <div class="text-gray-600 leading-relaxed">
                <p class="mb-4 text-sm">Place service id , then put "|", place your link and after that put "|" again and place the quantity you'd like to get.</p>
                
                <div class="bg-gray-100 rounded-lg p-4 border border-gray-200">
                    <div class="text-gray-500 text-sm mb-3 font-medium">Enter your service ID|Link (Your Order URL/username) | Quantity (The amount of likes/followers/views you want to add )</div>
                    <div class="space-y-2 text-gray-700 font-mono text-sm overflow-x-auto">
                        <div class="whitespace-nowrap">0000|https://www.facebook.com/username|1000</div>
                        <div class="whitespace-nowrap">0001|https://www.facebook.com/username1|1000</div>
                        <div class="whitespace-nowrap">0002|https://www.facebook.com/username2|1000</div>
                        <div class="whitespace-nowrap">0003|https://www.facebook.com/username3|1000</div>
                        <div class="whitespace-nowrap">0004|https://www.facebook.com/username4|1000</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Format Generator Modal -->
<div id="formatGeneratorModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex items-center justify-center">
    <div class="bg-white rounded-xl max-w-lg w-full mx-4 max-h-[90vh] overflow-y-auto">
        <div class="border-b border-gray-200 px-5 py-3 rounded-t-xl">
            <div class="flex items-center justify-between">
                <h3 class="text-base font-semibold text-gray-800 flex items-center gap-2">
                    <i class="ri-magic-line text-blue-600 text-lg"></i>
                    Quick Format Generator
                </h3>
                <button id="closeFormatModal" class="text-gray-500 hover:text-gray-700 text-2xl">
                    <i class="ri-close-line"></i>
                </button>
            </div>
            <p class="text-gray-500 text-sm mt-1">Enter links and auto-format them for mass order</p>
        </div>
        <div class="p-5 space-y-4">
            <!-- Service ID & Quantity Row -->
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label for="genServiceId" class="block text-sm font-semibold text-gray-700 mb-2">Service ID</label>
                    <input 
                        type="text" 
                        id="genServiceId" 
                        placeholder="e.g. 5896" 
                        class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-200 focus:border-blue-400 font-medium outline-none text-gray-800"
                    />
                </div>
                <div>
                    <label for="genQuantity" class="block text-sm font-semibold text-gray-700 mb-2">Quantity</label>
                    <input 
                        type="number" 
                        id="genQuantity" 
                        placeholder="e.g. 1000" 
                        class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-200 focus:border-blue-400 font-medium outline-none text-gray-800"
                    />
                </div>
            </div>

            <!-- Links Textarea -->
            <div>
                <label for="genLinks" class="block text-sm font-semibold text-gray-700 mb-2">
                    Links 
                    <span class="text-gray-400 font-normal">(one per line)</span>
                </label>
                <textarea 
                    id="genLinks" 
                    rows="7" 
                    placeholder="https://www.instagram.com/user1&#10;https://www.instagram.com/user2&#10;https://www.instagram.com/user3&#10;..." 
                    class="w-full border border-gray-300 rounded-lg px-3 py-2.5 focus:ring-2 focus:ring-blue-200 focus:border-blue-400 resize-none outline-none font-mono text-sm"
                ></textarea>
                <div class="flex items-center justify-between mt-2">
                    <span id="genLinkCount" class="text-xs text-gray-400">0 links entered</span>
                </div>
            </div>

            <!-- Format Button -->
            <button 
                type="button" 
                id="btnFormat" 
                class="w-full flex items-center justify-center gap-2 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors h-10 text-sm"
            >
                <i class="ri-arrow-left-line text-lg"></i>
                <span>Format</span>
            </button>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // --- How to Mass Order Modal ---
    var modal = document.getElementById('massOrderModal');
    var openBtn = document.getElementById('howToMassOrderBtn');
    var closeBtn = document.getElementById('closeModal');

    openBtn.addEventListener('click', function() { modal.classList.remove('hidden'); });
    closeBtn.addEventListener('click', function() { modal.classList.add('hidden'); });
    modal.addEventListener('click', function(e) { if (e.target === modal) modal.classList.add('hidden'); });

    // --- Format Generator Modal ---
    var formatModal = document.getElementById('formatGeneratorModal');
    var openFormatBtn = document.getElementById('openFormatGeneratorBtn');
    var closeFormatBtn = document.getElementById('closeFormatModal');

    openFormatBtn.addEventListener('click', function() { formatModal.classList.remove('hidden'); });
    closeFormatBtn.addEventListener('click', function() { formatModal.classList.add('hidden'); });
    formatModal.addEventListener('click', function(e) { if (e.target === formatModal) formatModal.classList.add('hidden'); });

    // Close any modal with Escape
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            modal.classList.add('hidden');
            formatModal.classList.add('hidden');
        }
    });

    // --- Quick Format Generator Logic ---
    var genServiceId = document.getElementById('genServiceId');
    var genQuantity = document.getElementById('genQuantity');
    var genLinks = document.getElementById('genLinks');
    var genLinkCount = document.getElementById('genLinkCount');
    var btnFormat = document.getElementById('btnFormat');
    var massOrderTextarea = document.getElementById('links');

    function parseLinks() {
        return genLinks.value
            .split('\n')
            .map(function(line) { return line.trim(); })
            .filter(function(line) { return line.length > 0; });
    }

    // Update link count
    genLinks.addEventListener('input', function() {
        var links = parseLinks();
        genLinkCount.textContent = links.length + ' link' + (links.length !== 1 ? 's' : '') + ' entered';
    });

    // Format button click
    btnFormat.addEventListener('click', function() {
        var serviceId = genServiceId.value.trim();
        var quantity = genQuantity.value.trim();
        var links = parseLinks();

        if (!serviceId) { alert('Please enter a Service ID'); return; }
        if (!quantity) { alert('Please enter a Quantity'); return; }
        if (links.length === 0) { alert('Please enter at least one link'); return; }

        var formatted = links.map(function(link) {
            return serviceId + '|' + link + '|' + quantity;
        }).join('\n');

        // Add to mass order textarea
        var current = massOrderTextarea.value.trim();
        if (current) {
            massOrderTextarea.value = current + '\n' + formatted;
        } else {
            massOrderTextarea.value = formatted;
        }

        // Clear inputs
        genLinks.value = '';
        genServiceId.value = '';
        genQuantity.value = '';
        genLinkCount.textContent = '0 links entered';

        // Close modal
        formatModal.classList.add('hidden');
    });
});
</script>