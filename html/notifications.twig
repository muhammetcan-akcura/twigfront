<div class="relative z-10 pb-16 md:pb-15 bg-white pt-12">
    <div class="container mx-auto px-4 relative z-10">

        <!-- Main Content -->
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
            
            <!-- Sidebar -->
            <div class="lg:col-span-1">
                <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
                    
                    <!-- Profile Info Section -->
                    <div class="bg-white p-6 text-center border-b border-gray-200">
                        <div class="avatar-custom-style w-16 h-16 mx-auto mb-3 rounded-lg text-white flex items-center justify-center text-xl font-bold">
                            {{ user['username']|first|upper }}
                        </div>
                        <h3 class="text-lg font-semibold mb-1 text-gray-800">{{ user['username'] }}</h3>
                        <span class="text-sm text-gray-600">SMM Member</span>
                    </div>

                    <!-- Navigation Menu -->
                    <nav class="p-4">
                        <ul class="space-y-1">
                            <li>
                                <a href="{{ page_url('account') }}" class="sidebar-nav-btn w-full text-left px-4 py-3 rounded-lg font-medium transition-all duration-200 flex items-center gap-3 group">
                                    <div class="w-8 h-8 rounded-lg bg-gray-100 flex items-center justify-center group-hover:bg-gray-200 transition-colors">
                                        <i class="ri-user-line text-gray-600 text-lg"></i>
                                    </div>
                                    <span class="flex-1">{{ lang('account.tab.general') }}</span>
                                    <div class="w-2 h-2 rounded-full bg-gray-500 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                                </a>
                            </li>
                            
                            <li>
                                <a href="{{ page_url('notifications') }}" class="sidebar-nav-btn active w-full text-left px-4 py-3 rounded-lg font-medium transition-all duration-200 flex items-center gap-3 group">
                                    <div class="w-8 h-8 rounded-lg bg-blue-100 flex items-center justify-center group-hover:bg-blue-200 transition-colors">
                                        <i class="ri-notification-line text-blue-600 text-lg"></i>
                                    </div>
                                    <span class="flex-1">{{ lang('account.tab.notifications') }}</span>
                                    <div class="w-2 h-2 rounded-full bg-blue-500 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                                </a>
                            </li>
                        </ul>
                    </nav>

                    <!-- Account Stats -->
                    <div class="border-t border-gray-100 p-4 bg-gray-50">
                        <div class="space-y-3">
                            <div class="flex justify-between items-center">
                                <span class="text-sm text-gray-600">Balance</span>
                                <span class="text-sm font-semibold text-green-600">${{ user.funds|number_format(2) }}</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-sm text-gray-600">Total Spent</span>
                                <span class="text-sm font-semibold text-gray-800">${{ user.spent|number_format(2) }}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Content Area -->
            <div class="lg:col-span-3">
                
                <!-- Notifications Tab -->
                <div id="notifications" class="tab-content active">
                    <div class="bg-white border border-gray-200 rounded-xl p-6 md:p-8">
                        <div class="flex items-center gap-3 mb-6">
                            <i class="ri-notification-line text-2xl text-blue-600"></i>
                            <h2 class="text-2xl font-bold text-gray-800">{{ lang('account.tab.notifications') }}</h2>
                        </div>

                        <!-- Email Confirmation Section -->
                        {% if confirmEmail.available %}
                            <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm mb-6">
                                <div id="confirmEmailSuccess" class="bg-green-50 border border-green-200 text-green-800 rounded-md p-4 hidden mb-4{% if site['rtl'] %} rtl-alert {% endif %} relative">
                                    <button type="button" class="absolute top-2 right-2 text-green-400 hover:text-green-600 text-xl font-semibold leading-none" data-dismiss="alert">&times;</button>
                                    <!--- Success text -->
                                </div>
                                <div id="confirmEmailError" class="bg-red-50 border border-red-200 text-red-800 rounded-md p-4 hidden mb-4{% if site['rtl'] %} rtl-alert {% endif %} relative">
                                    <button type="button" class="absolute top-2 right-2 text-red-400 hover:text-red-600 text-xl font-semibold leading-none" data-dismiss="alert">&times;</button>
                                    <!--- Error text -->
                                </div>
                                <div class="flex items-center gap-3 mb-4">
                                    <div class="w-8 h-8 rounded-lg bg-yellow-100 flex items-center justify-center">
                                        <i class="ri-mail-line text-yellow-600 text-lg"></i>
                                    </div>
                                    <h5 class="text-lg font-semibold text-gray-900">{{ lang('notifications.email_confirmation.title') }}</h5>
                                </div>
                                <p class="text-gray-600 mb-4">{{ lang('notifications.email_confirmation.description') }}</p>
                                <form action="{{ confirmEmail.url }}" method="post">
                                    <input type="hidden" name="_csrf" value="{{ csrftoken }}">
                                    <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 px-6 rounded-lg transition duration-150 ease-in-out">
                                        {{ lang('notifications.email_confirmation.confirm') }}
                                    </button>
                                </form>
                            </div>
                        {% endif %}

                        <!-- Telegram Connection Section -->
                        {% if connectTelegram.available %}
                            <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm mb-6">
                                <div class="flex items-center gap-3 mb-4">
                                    <div class="w-8 h-8 rounded-lg bg-blue-100 flex items-center justify-center">
                                        <i class="ri-telegram-line text-blue-600 text-lg"></i>
                                    </div>
                                    <h5 class="text-lg font-semibold text-gray-900">{{ lang('notifications.telegram.title') }}</h5>
                                </div>
                                <form action="{{ connectTelegram.url }}" method="post">
                                    <input type="hidden" name="_csrf" value="{{ csrftoken }}">
                                    <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 px-6 rounded-lg transition duration-150 ease-in-out">
                                        {{ lang('notifications.telegram.button') }}
                                    </button>
                                </form>
                            </div>
                        {% endif %}

                        <!-- Notifications Settings -->
                        {% if userNotifications['notifications']|length > 0 %}
    
                                
                                {% if error %}
                                    <div class="bg-red-50 border border-red-200 text-red-800 rounded-md p-4 mb-4 relative {% if site['rtl'] %} rtl-alert {% endif %}">
                                        <div class="flex items-center">
                                            <i class="ri-error-warning-line text-red-600 text-xl mr-3"></i>
                                            <span>{{ errorMessage }}</span>
                                        </div>
                                        <button type="button" class="absolute top-2 right-2 text-red-400 hover:text-red-600 text-xl font-semibold leading-none" data-dismiss="alert">&times;</button>
                                    </div>
                                {% endif %}
                                
                                {% if success %}
                                    <div class="bg-green-50 border border-green-200 text-green-800 rounded-md p-4 mb-4 relative {% if site['rtl'] %} rtl-alert {% endif %}">
                                        <div class="flex items-center">
                                            <i class="ri-check-line text-green-600 text-xl mr-3"></i>
                                            <span>{{ successText }}</span>
                                        </div>
                                        <button type="button" class="absolute top-2 right-2 text-green-400 hover:text-green-600 text-xl font-semibold leading-none" data-dismiss="alert">&times;</button>
                                    </div>
                                {% endif %}
                                
                                <form action="" method="post">
                                    <div class="overflow-x-auto">
                                        <table class="min-w-full divide-y divide-gray-200">
                                            <thead class="bg-gray-50">
                                            <tr>
                                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ lang('notifications.title') }}</th>
                                                {% for sender in userNotifications['senders'] %}
                                                    <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">{{ sender.name }}</th>
                                                {% endfor %}
                                            </tr>
                                            </thead>
                                            <tbody class="bg-white divide-y divide-gray-200">
                                            {% for notification in userNotifications['notifications'] %}
                                                <tr class="hover:bg-gray-50">
                                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">{{ notification['name'] }}</td>
                                                    {% for sender in userNotifications['senders'] %}
                                                        <td class="px-6 py-4 whitespace-nowrap text-center">
                                                            <span {% if sender['disabled'] %}data-toggle="tooltip" data-placement="top" title="{{ sender['tooltip'] }}"{% endif %}>
                                                                <input type="hidden" name="NotificationsForm[notifications][{{ sender['code'] }}][{{ notification['id'] }}]" value="0"/>
                                                                <input type="checkbox" name="NotificationsForm[notifications][{{ sender['code'] }}][{{ notification['id'] }}]" {% if notification['statuses'][sender['code']] %}checked="checked"{% endif %} {% if sender['disabled'] %}disabled{% endif %} value="1" class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded disabled:opacity-50"/>
                                                            </span>
                                                        </td>
                                                    {% endfor %}
                                                </tr>
                                            {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>
                                    <input type="hidden" name="_csrf" value="{{ csrftoken }}">
                                    {% if saveButtonAvailable %}
                                        <button type="submit" class="w-full mt-6 bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 px-4 rounded-lg transition duration-150 ease-in-out">
                                            {{ lang('notifications.save') }}
                                        </button>
                                    {% endif %}
                                </form>
                     
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
