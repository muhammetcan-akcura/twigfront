// Function to load payment data via fetch (simulating real browser request)
function loadPaymentData() {
    fetch("/addfunds", {
        "headers": {
            "accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7",
            "accept-language": "tr-TR,tr;q=0.9,en;q=0.8",
            "sec-ch-ua": "\"Not;A=Brand\";v=\"99\", \"Google Chrome\";v=\"139\", \"Chromium\";v=\"139\"",
            "sec-ch-ua-mobile": "?0",
            "sec-ch-ua-platform": "\"Windows\"",
            "sec-fetch-dest": "document",
            "sec-fetch-mode": "navigate",
            "sec-fetch-site": "none",
            "sec-fetch-user": "?1",
            "upgrade-insecure-requests": "1"
        },
        "body": null,
        "method": "GET",
        "mode": "cors",
        "credentials": "include"
    })
    .then(response => {
        if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
        }
        return response.text();
    })
    .then(html => {
        try {
            // Parse the HTML response using jQuery
            const $html = $(html);
            
            // Find the table with payment data
            const $table = $html.find('table.table.w-full');
            
            if ($table.length > 0) {
                const $tbody = $table.find('tbody');
                const $rows = $tbody.find('tr');
                const $paymentSelect = $('#payment_select');
                
                $paymentSelect.find('option:not(:first)').remove();
                
                $rows.each(function() {
                    const $row = $(this);
                    const $cells = $row.find('td');
                    
                    if ($cells.length >= 4) {
                        const id = $cells.eq(0).text().trim();
                        const date = $cells.eq(1).find('.nowrap').text().trim() || $cells.eq(1).text().trim();
                        const method = $cells.eq(2).text().trim();
                        const amountRaw = $cells.eq(3).text().trim();
                        
                        // Clean amount and convert to number
                        const amountNumeric = parseFloat(amountRaw.replace(/[^0-9.-]+/g,""));
                        
                        // ONLY ADD POSITIVE AMOUNTS (Actual Payments)
                        if (id && date && !isNaN(amountNumeric) && amountNumeric > 0) {
                            const formattedDate = date.split(' ')[0].replace(/-/g, '/');
                            
                            let optionText = `Payment #${id} - ${formattedDate} - ${amountRaw}`;
                            if (method) {
                                optionText = `Payment #${id} - ${formattedDate} - ${method} - ${amountRaw}`;
                            }
                            
                            const $option = $('<option></option>')
                                .val(id)
                                .attr('data-date', formattedDate)
                                .attr('data-amount', amountRaw)
                                .attr('data-method', method)
                                .text(optionText);
                            
                            $paymentSelect.append($option);
                        }
                    }
                });
                
                console.log('Payment data reloaded (Positive amounts only)');
                const selectElement = document.getElementById('payment_select');
                if (selectElement) {
                    // Remove existing nice select wrapper if exists
                    const existingWrapper = selectElement.parentNode.querySelector('.nice-select');
                    if (existingWrapper) {
                        existingWrapper.remove();
                        selectElement.style.display = '';
                    }
                    
                    // Reinitialize
                    new NiceSelect(selectElement);
                }
                
                console.log('Payment data loaded successfully from /addfunds');
            } else {
                console.warn('Payment table not found in /addfunds response');
            }
            
        } catch (error) {
            console.error('Error parsing payment data:', error);
        }
    })
    .catch(error => {
        console.error('Failed to load payment data from /addfunds:', error);
    });
}

// Form validation function
function validateForm() {
    const companyName = document.getElementById('company_name').value.trim();
    const companyAddress = document.getElementById('company_address').value.trim();
    const vatTax = document.getElementById('vat_tax').value.trim();
    const paymentSelect = document.getElementById('payment_select').value;
    
    // Reset previous error styles
    const inputs = ['company_name', 'company_address', 'vat_tax', 'payment_select'];
    inputs.forEach(id => {
        const element = document.getElementById(id);
        element.classList.remove('border-red-500', 'ring-red-500');
        element.classList.add('border-gray-300');
    });
    
    let isValid = true;
    let errorMessage = '';
    
    // Check required fields
    if (!companyName) {
        document.getElementById('company_name').classList.add('border-red-500', 'ring-red-500');
        errorMessage += 'Company Name is required.\n';
        isValid = false;
    }
    
    if (!companyAddress) {
        document.getElementById('company_address').classList.add('border-red-500', 'ring-red-500');
        errorMessage += 'Company Address is required.\n';
        isValid = false;
    }
    
    if (!vatTax) {
        document.getElementById('vat_tax').classList.add('border-red-500', 'ring-red-500');
        errorMessage += 'Vat/Tax Number is required.\n';
        isValid = false;
    }
    
    if (!paymentSelect) {
        // Add error styling to nice-select wrapper
        const niceSelectWrapper = document.querySelector('.nice-select');
        if (niceSelectWrapper) {
            niceSelectWrapper.classList.add('border-red-500');
            niceSelectWrapper.classList.remove('border-gray-300');
        }
        errorMessage += 'Please select a payment.\n';
        isValid = false;
    }
    
    if (!isValid) {
        showAlert(errorMessage.trim(), 'danger', 'Form Error', false);
    }
    
    return isValid;
}

// UTF-8 text encoding function - now preserves special characters with DejaVu Sans
function encodeUTF8Text(text) {
    if (!text) return text;
    
    try {
        // With DejaVu Sans font, we can preserve all UTF-8 characters including Turkish
        // No need to convert special characters anymore
        return text.normalize('NFC');
    } catch (error) {
        console.warn('Text normalization failed:', error);
        return text;
    }
}

// UTF-8 Font loading function with DejaVu Sans (FileReader implementation)
async function loadUTF8Font(doc) {
    return new Promise(async (resolve, reject) => {
        try {
            const fontUrl = 'https://cdn.jsdelivr.net/npm/dejavu-fonts-ttf@2.37.3/ttf/DejaVuSans.ttf';
            console.log('Loading DejaVu Sans font from CDN...');
            
            const response = await fetch(fontUrl);
            if (!response.ok) {
                throw new Error(`Font fetch failed: ${response.status}`);
            }
            
            const blob = await response.blob();
            const reader = new FileReader();
            
            reader.onloadend = function() {
                try {
                    // Get base64 string and remove prefix
                    const base64String = reader.result.split(',')[1];
                    
                    // Add font to jsPDF
                    doc.addFileToVFS('DejaVuSans.ttf', base64String);
                    doc.addFont('DejaVuSans.ttf', 'DejaVuSans', 'normal');
                    doc.setFont('DejaVuSans', 'normal');
                    
                    // Set document properties
                    doc.setProperties({
                        title: 'Invoice - UTF-8 Encoded',
                        subject: 'Invoice Document',
                        author: 'ITSJUSTSEO Limited',
                        creator: 'Invoice System UTF-8',
                        producer: 'jsPDF UTF-8'
                    });
                    
                    console.log('✓ DejaVu Sans font loaded successfully with UTF-8 support');
                    resolve(true);
                } catch (error) {
                    console.warn('Error processing font with FileReader:', error);
                    doc.setFont('helvetica', 'normal');
                    reject(false);
                }
            };
            
            reader.onerror = function(error) {
                console.warn('FileReader error:', error);
                doc.setFont('helvetica', 'normal');
                reject(false);
            };
            
            reader.readAsDataURL(blob);
            
        } catch (error) {
            console.warn('DejaVu Sans font loading failed, using fallback:', error);
            doc.setFont('helvetica', 'normal');
            reject(false);
        }
    });
}

