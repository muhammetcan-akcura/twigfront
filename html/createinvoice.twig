        const timeoutDuration = 3000; // 3 seconds timeout
        
        const loadTimeout = setTimeout(() => {
            if (!logoLoaded) {
                console.warn('Logo loading timeout, continuing without logo');
                createPDFContent();
            }
        }, timeoutDuration);
        
        img.onload = function() {
            if (!logoLoaded) {
                logoLoaded = true;
                clearTimeout(loadTimeout);
                
                try {
                    // Create canvas to convert image
                    const canvas = document.createElement('canvas');
                    const ctx = canvas.getContext('2d');
                    canvas.width = this.width;
                    canvas.height = this.height;
                    ctx.drawImage(this, 0, 0);
                    
                    // Convert to base64
                    logoData = canvas.toDataURL('image/png');
                    
                    console.log('Logo loaded successfully');
                    createPDFContent(logoData);
                    
                } catch (error) {
                    console.warn('Logo processing failed:', error);
                    createPDFContent();
                }
            }
        };
        
        img.onerror = function() {
            if (!logoLoaded) {
                logoLoaded = true;
                clearTimeout(loadTimeout);
                console.warn('Logo could not be loaded, continuing without logo');
                createPDFContent();
            }
        };
        
        // Set crossOrigin before src
        img.crossOrigin = 'anonymous';
        img.src = logoUrl;
        
        // Fallback: If image doesn't load in reasonable time, continue without logo
        setTimeout(() => {
            if (!logoLoaded) {
                logoLoaded = true;
                clearTimeout(loadTimeout);
                console.warn('Logo loading fallback triggered, continuing without logo');
                createPDFContent();
            }
        }, timeoutDuration + 1000);
