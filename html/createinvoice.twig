// Function to load payment data via fetch (simulating real browser request)
function loadPaymentData() {
    fetch("/addfunds", {
        "headers": {
            "accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7",
            "accept-language": "tr-TR,tr;q=0.9,en;q=0.8",
            "sec-ch-ua": "\"Not;A=Brand\";v=\"99\", \"Google Chrome\";v=\"139\", \"Chromium\";v=\"139\"",
            "sec-ch-ua-mobile": "?0",
            "sec-ch-ua-platform": "\"Windows\"",
            "sec-fetch-dest": "document",
            "sec-fetch-mode": "navigate",
            "sec-fetch-site": "none",
            "sec-fetch-user": "?1",
            "upgrade-insecure-requests": "1"
        },
        "body": null,
        "method": "GET",
        "mode": "cors",
        "credentials": "include"
    })
    .then(response => {
        if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
        }
        return response.text();
    })
    .then(html => {
        try {
            // Parse the HTML response using jQuery
            const $html = $(html);
            
            // Find the table with payment data
            const $table = $html.find('table.table.w-full');
            
            if ($table.length > 0) {
                const $tbody = $table.find('tbody');
                const $rows = $tbody.find('tr');
                const $paymentSelect = $('#payment_select');
                
                $paymentSelect.find('option:not(:first)').remove();
                
                $rows.each(function() {
                    const $row = $(this);
                    const $cells = $row.find('td');
                    
                    if ($cells.length >= 4) {
                        const id = $cells.eq(0).text().trim();
                        const date = $cells.eq(1).find('.nowrap').text().trim() || $cells.eq(1).text().trim();
                        const method = $cells.eq(2).text().trim();
                        const amountRaw = $cells.eq(3).text().trim();
                        
                        // Clean amount and convert to number
                        const amountNumeric = parseFloat(amountRaw.replace(/[^0-9.-]+/g,""));
                        
                        // ONLY ADD POSITIVE AMOUNTS (Actual Payments)
                        if (id && date && !isNaN(amountNumeric) && amountNumeric > 0) {
                            const formattedDate = date.split(' ')[0].replace(/-/g, '/');
                            
                            let optionText = `Payment #${id} - ${formattedDate} - ${amountRaw}`;
                            if (method) {
                                optionText = `Payment #${id} - ${formattedDate} - ${method} - ${amountRaw}`;
                            }
                            
                            const $option = $('<option></option>')
                                .val(id)
                                .attr('data-date', formattedDate)
                                .attr('data-amount', amountRaw)
                                .attr('data-method', method)
                                .text(optionText);
                            
                            $paymentSelect.append($option);
                        }
                    }
                });
                
                console.log('Payment data reloaded (Positive amounts only)');
                const selectElement = document.getElementById('payment_select');
                if (selectElement) {
                    // Remove existing nice select wrapper if exists
                    const existingWrapper = selectElement.parentNode.querySelector('.nice-select');
                    if (existingWrapper) {
                        existingWrapper.remove();
                        selectElement.style.display = '';
                    }
                    
                    // Reinitialize
                    new NiceSelect(selectElement);
                }
                
                console.log('Payment data loaded successfully from /addfunds');
            } else {
                console.warn('Payment table not found in /addfunds response');
            }
            
        } catch (error) {
            console.error('Error parsing payment data:', error);
        }
    })
    .catch(error => {
        console.error('Failed to load payment data from /addfunds:', error);
    });
}

// Form validation function
function validateForm() {
    const companyName = document.getElementById('company_name').value.trim();
    const companyAddress = document.getElementById('company_address').value.trim();
    const vatTax = document.getElementById('vat_tax').value.trim();
    const paymentSelect = document.getElementById('payment_select').value;
    
    // Reset previous error styles
    const inputs = ['company_name', 'company_address', 'vat_tax', 'payment_select'];
    inputs.forEach(id => {
        const element = document.getElementById(id);
        element.classList.remove('border-red-500', 'ring-red-500');
        element.classList.add('border-gray-300');
    });
    
    let isValid = true;
    let errorMessage = '';
    
    // Check required fields
    if (!companyName) {
        document.getElementById('company_name').classList.add('border-red-500', 'ring-red-500');
        errorMessage += 'Company Name is required.\n';
        isValid = false;
    }
    
    if (!companyAddress) {
        document.getElementById('company_address').classList.add('border-red-500', 'ring-red-500');
        errorMessage += 'Company Address is required.\n';
        isValid = false;
    }
    
    if (!vatTax) {
        document.getElementById('vat_tax').classList.add('border-red-500', 'ring-red-500');
        errorMessage += 'Vat/Tax Number is required.\n';
        isValid = false;
    }
    
    if (!paymentSelect) {
        // Add error styling to nice-select wrapper
        const niceSelectWrapper = document.querySelector('.nice-select');
        if (niceSelectWrapper) {
            niceSelectWrapper.classList.add('border-red-500');
            niceSelectWrapper.classList.remove('border-gray-300');
        }
        errorMessage += 'Please select a payment.\n';
        isValid = false;
    }
    
    if (!isValid) {
        showAlert(errorMessage.trim(), 'danger', 'Form Error', false);
    }
    
    return isValid;
}

// UTF-8 text encoding function - now preserves special characters with DejaVu Sans
function encodeUTF8Text(text) {
    if (!text) return text;
    
    try {
        // With DejaVu Sans font, we can preserve all UTF-8 characters including Turkish
        // No need to convert special characters anymore
        return text.normalize('NFC');
    } catch (error) {
        console.warn('Text normalization failed:', error);
        return text;
    }
}

// UTF-8 Font loading function with DejaVu Sans (FileReader implementation)
async function loadUTF8Font(doc) {
    return new Promise(async (resolve, reject) => {
        try {
            const fontUrl = 'https://cdn.jsdelivr.net/npm/dejavu-fonts-ttf@2.37.3/ttf/DejaVuSans.ttf';
            console.log('Loading DejaVu Sans font from CDN...');
            
            const response = await fetch(fontUrl);
            if (!response.ok) {
                throw new Error(`Font fetch failed: ${response.status}`);
            }
            
            const blob = await response.blob();
            const reader = new FileReader();
            
            reader.onloadend = function() {
                try {
                    // Get base64 string and remove prefix
                    const base64String = reader.result.split(',')[1];
                    
                    // Add font to jsPDF
                    doc.addFileToVFS('DejaVuSans.ttf', base64String);
                    doc.addFont('DejaVuSans.ttf', 'DejaVuSans', 'normal');
                    doc.setFont('DejaVuSans', 'normal');
                    
                    // Set document properties
                    doc.setProperties({
                        title: 'Invoice - UTF-8 Encoded',
                        subject: 'Invoice Document',
                        author: 'JUSTANOTHERMARKETING LTD',
                        creator: 'Invoice System UTF-8',
                        producer: 'jsPDF UTF-8'
                    });
                    
                    console.log('✓ DejaVu Sans font loaded successfully with UTF-8 support');
                    resolve(true);
                } catch (error) {
                    console.warn('Error processing font with FileReader:', error);
                    doc.setFont('helvetica', 'normal');
                    reject(false);
                }
            };
            
            reader.onerror = function(error) {
                console.warn('FileReader error:', error);
                doc.setFont('helvetica', 'normal');
                reject(false);
            };
            
            reader.readAsDataURL(blob);
            
        } catch (error) {
            console.warn('DejaVu Sans font loading failed, using fallback:', error);
            doc.setFont('helvetica', 'normal');
            reject(false);
        }
    });
}

// Generate PDF invoice
async function generateInvoice() {
    // Get form values
    const companyName = document.getElementById('company_name').value.trim();
    const companyAddress = document.getElementById('company_address').value.trim();
    const vatTax = document.getElementById('vat_tax').value.trim();
    const paymentSelect = document.getElementById('payment_select');
    const selectedOption = paymentSelect.options[paymentSelect.selectedIndex];
    
    // Get payment details
    const paymentId = selectedOption.value;
    const paymentDate = selectedOption.getAttribute('data-date');
    const paymentAmount = selectedOption.getAttribute('data-amount');
    const paymentMethod = selectedOption.getAttribute('data-method') || 'N/A';
    
    // Create invoice data object for Telegram
    const invoiceData = {
        paymentId: paymentId,
        companyName: companyName,
        companyAddress: companyAddress,
        vatTax: vatTax,
        paymentDate: paymentDate,
        amount: paymentAmount,
        paymentMethod: paymentMethod
    };
    
    // Create jsPDF instance
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF();
    
    // Add UTF-8 compatible font for special characters
    // Load DejaVu Sans font which supports Turkish and other special characters
    await loadUTF8Font(doc);
    
    // Premium color palette — Vibrant Blue
    const navyDark   = [59, 130, 246];    // #3B82F6 — vibrant blue header bg
    const accentBlue = [37, 99, 235];     // #2563EB — slightly darker brand blue
    const lightBlueB = [239, 246, 255];   // #EFF6FF — very light blue bg
    const cream      = [250, 252, 255];   // #FAFCFF — page bg
    const textDark   = [15, 23, 42];      // #0F172A — slate near-black
    const textGray   = [100, 116, 139];   // #64748B — slate gray
    const borderGray = [219, 234, 254];   // #DBEAFE — light blue border
    const white      = [255, 255, 255];
    // legacy aliases (unused in new design but kept for safety)
    const primaryBlue = [59, 130, 246];
    const darkBlue    = [30, 64, 175];
    const lightBlue   = [239, 246, 255];
    
    // Load and add logo
    const logoUrl = '';
    
    // Function to load image and add to PDF
    function loadImageAndAddToPDF() {
        const img = new Image();
        let logoLoaded = false;
        let logoData = null;
        
        const timeoutDuration = 3000; // 3 seconds timeout
        
        const loadTimeout = setTimeout(() => {
            if (!logoLoaded) {
                console.warn('Logo loading timeout, continuing without logo');
                createPDFContent();
            }
        }, timeoutDuration);
        
        img.onload = function() {
            if (!logoLoaded) {
                logoLoaded = true;
                clearTimeout(loadTimeout);
                
                try {
                    // Create canvas to convert image
                    const canvas = document.createElement('canvas');
                    const ctx = canvas.getContext('2d');
                    canvas.width = this.width;
                    canvas.height = this.height;
                    ctx.drawImage(this, 0, 0);
                    
                    // Convert to base64
                    logoData = canvas.toDataURL('image/png');
                    
                    console.log('Logo loaded successfully');
                    createPDFContent(logoData);
                    
                } catch (error) {
                    console.warn('Logo processing failed:', error);
                    createPDFContent();
                }
            }
        };
        
        img.onerror = function() {
            if (!logoLoaded) {
                logoLoaded = true;
                clearTimeout(loadTimeout);
                console.warn('Logo could not be loaded, continuing without logo');
                createPDFContent();
            }
        };
        
        // Set crossOrigin before src
        img.crossOrigin = 'anonymous';
        img.src = logoUrl;
        
        // Fallback: If image doesn't load in reasonable time, continue without logo
        setTimeout(() => {
            if (!logoLoaded) {
                logoLoaded = true;
                clearTimeout(loadTimeout);
                console.warn('Logo loading fallback triggered, continuing without logo');
                createPDFContent();
            }
        }, timeoutDuration + 1000);
    }
    
    function createPDFContent(logoData = null) {
        // ── PAGE BACKGROUND ──────────────────────────────────────────
        doc.setFillColor(...cream);
        doc.rect(0, 0, 210, 297, 'F');

        // ── HEADER BLOCK (Light Blue) ────────────────────────────────
        doc.setFillColor(...lightBlueB);
        doc.rect(0, 0, 210, 35, 'F'); // Increased height to spread out content

        // "INVOICE" label — left side
        doc.setFontSize(26);
        doc.setFont('DejaVuSans', 'normal');
        doc.setTextColor(...textDark); // Black / dark slate
        doc.text('INVOICE', 14, 22); // Shifted down proportionally

        // ── ADD LOGO if available ────────────────────────────────────
        if (logoData) {
            try {
                doc.addImage(logoData, 'PNG', 128, 12, 60, 10);
            } catch(e) {}
        }

        // ── BILL FROM & TO SECTION ───────────────────────────────────
        const sectionY = 55; // Reduced gap from header

        // Light grey background box wrapping both sections
        doc.setFillColor(241, 245, 249); // Slightly darker grey (slate-100)
        doc.roundedRect(10, sectionY - 10, 190, 52, 2, 2, 'F');

        doc.setFontSize(7);
        doc.setFont('DejaVuSans', 'normal');
        doc.setTextColor(...textDark);
        doc.text('FROM', 14, sectionY);

        doc.setDrawColor(...borderGray);
        doc.setLineWidth(0.3);
        doc.line(14, sectionY + 1.5, 95, sectionY + 1.5);

        doc.setFontSize(9);
        doc.setTextColor(...textDark);
        doc.text(COMPANY_CONFIG.name, 14, sectionY + 8);
        doc.setFontSize(8);
        doc.setTextColor(...textGray);
        doc.text(COMPANY_CONFIG.email, 14, sectionY + 14);

        const fromAddrLines = COMPANY_CONFIG.address.split('\n');
        let fromY = sectionY + 20;
        fromAddrLines.forEach(line => {
            doc.text(line, 14, fromY);
            fromY += 4.5;
        });
        doc.text('VAT/TAX: ' + COMPANY_CONFIG.taxNumber, 14, fromY);

        // ── BILL TO (right column) ────────────────────────────────────
        const rightColX = 116;

        doc.setFontSize(7);
        doc.setFont('DejaVuSans', 'normal');
        doc.setTextColor(...textDark);
        doc.text('BILL TO', rightColX, sectionY);

        doc.setDrawColor(...borderGray);
        doc.setLineWidth(0.3);
        doc.line(rightColX, sectionY + 1.5, 196, sectionY + 1.5);

        // Company Name
        const companyNameLines = doc.splitTextToSize(companyName, 80);
        doc.setFontSize(9);
        doc.setTextColor(...textDark);
        let billY = sectionY + 8;
        companyNameLines.forEach(line => {
            doc.text(encodeUTF8Text(line), rightColX, billY);
            billY += 4.5;
        });

        billY += 2; // Extra gap before details

        // Meta Details (Side-by-side)
        doc.setFontSize(8);
        
        doc.setTextColor(...textGray);
        doc.text('VAT/TAX:', rightColX, billY);
        doc.setTextColor(...textDark);
        doc.text(vatTax, rightColX + 16, billY);
        billY += 4.5;

        doc.setTextColor(...textGray);
        doc.text('Date:', rightColX, billY);
        doc.setTextColor(...textDark);
        doc.text(paymentDate, rightColX + 16, billY);
        billY += 4.5;

        doc.setTextColor(...textGray);
        doc.text('Address:', rightColX, billY);
        doc.setTextColor(...textDark);
        
        const customerAddressLines = companyAddress.split('\n');
        let addrY = billY;
        customerAddressLines.forEach(line => {
            const wrapped = doc.splitTextToSize(encodeUTF8Text(line), 64);
            wrapped.forEach(wl => {
                doc.text(wl, rightColX + 16, addrY);
                addrY += 4;
            });
        });

        // ── SERVICES TABLE ────────────────────────────────────────────
        const tableStartY = Math.max(fromY + 30, addrY + 30, 120); // Increased gap before table

        // Table header background
        doc.setFillColor(96, 165, 250); // Softer blue
        doc.rect(14, tableStartY, 182, 11, 'F'); // Removed rounded corners

        // Bottom line on header (matching soft blue)
        doc.setFillColor(96, 165, 250);
        doc.rect(14, tableStartY + 11, 182, 0.7, 'F');

        // Header text
        doc.setFontSize(8);
        doc.setFont('DejaVuSans', 'normal');
        doc.setTextColor(...white);
        doc.text('SERVICE ID',   20,  tableStartY + 7.5);
        doc.text('DESCRIPTION',  55,  tableStartY + 7.5);
        doc.text('QTY',         100,  tableStartY + 7.5);
        doc.text('UNIT PRICE',  125,  tableStartY + 7.5);
        doc.text('DISCOUNT',    155,  tableStartY + 7.5);
        doc.text('TOTAL',       190,  tableStartY + 7.5, { align: 'right' }); // Moved left for padding

        // Row 1 — light blue alternating bg
        doc.setFillColor(232, 242, 251);
        doc.rect(14, tableStartY + 11.7, 182, 14, 'F');

        doc.setFontSize(8.5);
        doc.setFont('DejaVuSans', 'normal');
        doc.setTextColor(...textDark);
        doc.text(paymentId,              20,  tableStartY + 21);
        doc.text('Marketing Services',   55,  tableStartY + 21);
        doc.text('1.00 EA',             100,  tableStartY + 21);
        doc.text(`${paymentAmount}`,    125,  tableStartY + 21);
        doc.text('$0.00',               155,  tableStartY + 21);
        doc.text(`${paymentAmount}`,    190,  tableStartY + 21, { align: 'right' });

        // Bottom border of table
        doc.setDrawColor(...borderGray);
        doc.setLineWidth(0.4);
        doc.line(14, tableStartY + 25.7, 196, tableStartY + 25.7);

        // Services table is done; calculate summary start position
        const summaryStartY = tableStartY + 60; // Increased gap before summary

        // Wait for summary image to load before finalizing PDF
        waitForSummaryImageAndFinalize(summaryStartY);
    }

    
    // Wait for summary image and finalize PDF
    function waitForSummaryImageAndFinalize(summaryStartY) {
        const summaryImageUrl = 'https://storage.perfectcdn.com/ed17j7/0rfmz11phf6roo65.jpeg';
        
        // Create a promise to handle image loading
        const loadSummaryImage = new Promise((resolve, reject) => {
            const img = new Image();
            
            img.onload = function() {
                try {
                    const canvas = document.createElement('canvas');
                    const ctx = canvas.getContext('2d');
                    canvas.width = this.width;
                    canvas.height = this.height;
                    ctx.drawImage(this, 0, 0);

                    // Replace near-white pixels with current page background color (250, 252, 255)
                    const pageBgR = 250, pageBgG = 252, pageBgB = 255;
                    const threshold = 60; // Increased threshold to catch slightly darker greys
                    const pixelData = ctx.getImageData(0, 0, canvas.width, canvas.height);
                    const d = pixelData.data;
                    for (let i = 0; i < d.length; i += 4) {
                        if (d[i] > (255 - threshold) && d[i+1] > (255 - threshold) && d[i+2] > (255 - threshold)) {
                            d[i] = pageBgR; d[i+1] = pageBgG; d[i+2] = pageBgB;
                        }
                    }
                    ctx.putImageData(pixelData, 0, 0);

                    const imageData = canvas.toDataURL('image/jpeg', 1.0);
                    console.log('Summary image loaded and background blended');
                    resolve(imageData);
                } catch (error) {
                    console.warn('Summary image processing failed:', error);
                    reject(error);
                }
            };
            
            img.onerror = function() {
                console.warn('Summary image could not be loaded');
                reject(new Error('Image loading failed'));
            };
            
            img.crossOrigin = 'anonymous';
            img.src = summaryImageUrl;
            
            // Set timeout to reject after 5 seconds
            setTimeout(() => {
                reject(new Error('Image loading timeout'));
            }, 5000);
        });
        
        // Wait for image and then finalize PDF
        loadSummaryImage
            .then(imageData => {
                finalizePDFWithImage(summaryStartY, imageData);
            })
            .catch(error => {
                console.warn('Using fallback - no summary image:', error.message);
                finalizePDFWithImage(summaryStartY, null);
            });
    }
    
    // Finalize PDF with or without image
    function finalizePDFWithImage(summaryStartY, imageData) {

        // ── SUMMARY IMAGE & CUSTOM SIGNATURE ─────────────────────────
        const sigX = 14;
        let sigY = summaryStartY + 5;
        
        doc.setFontSize(7.5);
        doc.setFont('DejaVuSans', 'normal');
        doc.setTextColor(...textDark);
        doc.text('For and on behalf of', sigX, sigY);
        
        sigY += 4.5;
        doc.setFontSize(10);
        doc.text(COMPANY_CONFIG.name, sigX, sigY);
        
        sigY += 1.5;
        
        // imageData already has white bg replaced with page bg color
        if (imageData) {
            try {
                const aspectRatio = 550 / 450;
                const imgW = 28;
                const imgH = imgW / aspectRatio;
                doc.addImage(imageData, 'JPEG', sigX + 15, sigY, imgW, imgH);
                sigY += imgH + 2;
                console.log('Signature added to PDF');
            } catch (error) {
                console.error('Failed to add summary image:', error);
                sigY += 20;
            }
        } else {
            sigY += 20;
        }

        doc.setFontSize(10);
        doc.text('......................................................', sigX, sigY);
        
        sigY += 4;
        doc.setFontSize(7.5);
        doc.text('Authorized Signature(s)', sigX + 22, sigY, { align: 'center' });

        // ── SUMMARY BOX (right side) ─────────────────────────────────
        const boxX = 116;
        const boxW = 80;
        const boxH = 45;

        // Box shadow effect (removed)

        // Main box
        doc.setFillColor(...white);
        doc.setDrawColor(...borderGray);
        doc.setLineWidth(0.4);
        doc.roundedRect(boxX, summaryStartY, boxW, boxH, 2, 2, 'FD');

        // Brand blue top bar on summary box (removed)

        // Row helper
        const rowLeft  = boxX + 5;
        const rowRight = boxX + boxW - 5;
        let ry = summaryStartY + 10;
        const rowGap = 8;

        const drawSummaryRow = (label, value, bold = false) => {
            doc.setFontSize(bold ? 9 : 8.5);
            doc.setFont('DejaVuSans', 'normal');
            if (bold) {
                doc.setTextColor(textDark[0], textDark[1], textDark[2]);
            } else {
                doc.setTextColor(textGray[0], textGray[1], textGray[2]);
            }
            doc.text(label, rowLeft, ry);
            if (bold) {
                doc.setTextColor(textDark[0], textDark[1], textDark[2]);
            } else {
                doc.setTextColor(textDark[0], textDark[1], textDark[2]);
            }
            doc.text(value, rowRight, ry, { align: 'right' });
            ry += rowGap;
        };

        drawSummaryRow('Subtotal',  `${paymentAmount}`);
        drawSummaryRow('Discount',  '$0.00');
        drawSummaryRow('VAT (0%)',  '$0.00');

        // Divider line before total
        doc.setDrawColor(...borderGray);
        doc.setLineWidth(0.3);
        doc.line(rowLeft, ry - 3, rowRight, ry - 3);

        ry += 3; // Added extra gap so TOTAL text doesn't stick to the line

        drawSummaryRow('TOTAL', `${paymentAmount}`, true);

        // ── FOOTER ───────────────────────────────────────────────────
        const footerY = 272;

        // Footer background (removed)
        // doc.setFillColor(...navyDark);
        // doc.rect(0, footerY, 210, 25, 'F');

        // Divider line for footer
        doc.setDrawColor(...borderGray);
        doc.setLineWidth(0.5);
        doc.line(14, footerY, 196, footerY);

        // Left: Thank you
        doc.setFontSize(10);
        doc.setFont('DejaVuSans', 'normal');
        doc.setTextColor(...navyDark); // changed from white to navyDark
        doc.text('Thank you for your business!', 14, footerY + 9);

        doc.setFontSize(7.5);
        doc.setTextColor(...textGray); // changed to textGray
        doc.text('This is a system generated invoice', 14, footerY + 16);



        // ── SAVE & SEND ──────────────────────────────────────────────
        setTimeout(() => {
            const fileName = `Invoice_${paymentId}_${new Date().toISOString().split('T')[0]}.pdf`;
            const pdfBlob = doc.output('blob');
            sendTelegramNotification(pdfBlob, invoiceData).then(() => {
                doc.save(fileName);
                console.log('✓ PDF saved successfully');
                showAlert('Professional invoice has been generated successfully!', 'success', 'Success');
            });
        }, 100);
    }
    
    // Start the process by loading the logo
    loadImageAndAddToPDF();
}

// Initialize form handler
function initializeInvoiceForm() {
    const form = document.querySelector('form');
    
    // Prevent default form submission
    form.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        // Validate form
        if (validateForm()) {
            // Generate invoice if validation passes
            await generateInvoice();
        }
    });
}
