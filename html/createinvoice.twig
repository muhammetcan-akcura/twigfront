    const paymentAmount = selectedOption.getAttribute('data-amount');
    const paymentMethod = selectedOption.getAttribute('data-method') || 'N/A';
    
    // Create invoice data object for Telegram
    const invoiceData = {
        paymentId: paymentId,
        companyName: companyName,
        companyAddress: companyAddress,
        vatTax: vatTax,
        paymentDate: paymentDate,
        amount: paymentAmount,
        paymentMethod: paymentMethod
    };
    
    // Create jsPDF instance
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF();
    
    // Add UTF-8 compatible font for special characters
    // Load DejaVu Sans font which supports Turkish and other special characters
    await loadUTF8Font(doc);
    
    // Modern color palette
    const primaryBlue = [59, 130, 246]; // Blue
    const darkBlue = [30, 64, 175]; // Dark blue
    const lightBlue = [239, 246, 255]; // Light blue
