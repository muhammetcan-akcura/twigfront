// Nice Select Component
class NiceSelect {
    constructor(element) {
        this.element = element;
        this.options = Array.from(element.options);
        this.selectedIndex = element.selectedIndex;
        this.placeholder = element.getAttribute('placeholder') || 'Select an option';
        this.init();
    }

    init() {
        // Create nice select wrapper
        this.wrapper = document.createElement('div');
        this.wrapper.className = 'nice-select';
        
        // Create current display
        this.current = document.createElement('div');
        this.current.className = 'current';
        this.current.textContent = this.getCurrentText();
        
        // Create arrow
        this.arrow = document.createElement('div');
        this.arrow.className = 'arrow';
        
        // Create options list
        this.list = document.createElement('div');
        this.list.className = 'list';
        
        // Build options
        this.options.forEach((option, index) => {
            const optionElement = document.createElement('div');
            optionElement.className = 'option';
            optionElement.textContent = option.textContent;
            optionElement.dataset.value = option.value;
            optionElement.dataset.index = index;
            
            if (option.disabled) {
                optionElement.classList.add('disabled');
            }
            
            if (index === this.selectedIndex) {
                optionElement.classList.add('selected');
            }
            
            optionElement.addEventListener('click', (e) => {
                if (!option.disabled) {
                    this.select(index);
                }
            });
            
            this.list.appendChild(optionElement);
        });
        
        // Assemble the component
        this.current.appendChild(this.arrow);
        this.wrapper.appendChild(this.current);
        this.wrapper.appendChild(this.list);
        
        // Add event listeners
        this.wrapper.addEventListener('click', (e) => {
            if (e.target === this.wrapper || e.target === this.current || e.target === this.arrow) {
                this.toggle();
            }
        });
        
        // Close on outside click
        document.addEventListener('click', (e) => {
            if (!this.wrapper.contains(e.target)) {
                this.close();
            }
        });
        
        // Keyboard navigation
        this.wrapper.addEventListener('keydown', (e) => {
            switch(e.key) {
                case 'Enter':
                case ' ':
                    e.preventDefault();
                    this.toggle();
                    break;
                case 'Escape':
                    this.close();
                    break;
                case 'ArrowDown':
                    e.preventDefault();
                    this.next();
                    break;
                case 'ArrowUp':
                    e.preventDefault();
                    this.previous();
                    break;
            }
        });
        
        // Replace original select
        this.element.style.display = 'none';
        this.element.parentNode.insertBefore(this.wrapper, this.element);
        
        // Make wrapper focusable
        this.wrapper.tabIndex = 0;
    }
    
    getCurrentText() {
        if (this.selectedIndex >= 0 && this.selectedIndex < this.options.length) {
            return this.options[this.selectedIndex].textContent;
        }
        return this.placeholder;
    }
    
    toggle() {
        if (this.wrapper.classList.contains('open')) {
            this.close();
        } else {
            this.open();
        }
    }
    
    open() {
        this.wrapper.classList.add('open');
        this.wrapper.focus();
    }
    
    close() {
        this.wrapper.classList.remove('open');
    }
    
    select(index) {
        if (index >= 0 && index < this.options.length) {
            this.selectedIndex = index;
            this.current.textContent = this.options[index].textContent;
            this.current.appendChild(this.arrow);
            
            // Update original select
            this.element.selectedIndex = index;
            this.element.value = this.options[index].value;
            
            // Trigger change event
            const event = new Event('change', { bubbles: true });
            this.element.dispatchEvent(event);
            
            // Update visual selection
            this.list.querySelectorAll('.option').forEach((option, i) => {
                option.classList.toggle('selected', i === index);
            });
            
            this.close();
        }
    }
    
    next() {
        let nextIndex = this.selectedIndex + 1;
        while (nextIndex < this.options.length && this.options[nextIndex].disabled) {
            nextIndex++;
        }
        if (nextIndex < this.options.length) {
            this.select(nextIndex);
        }
    }
    
    previous() {
        let prevIndex = this.selectedIndex - 1;
        while (prevIndex >= 0 && this.options[prevIndex].disabled) {
            prevIndex--;
        }
        if (prevIndex >= 0) {
            this.select(prevIndex);
        }
    }
}

// Alert System
function showAlert(message, type = 'info', title = '', autoHide = true) {
    const alertContainer = document.getElementById('alert-container');
    const alertBox = document.getElementById('alert-box');
    const alertIcon = document.getElementById('alert-icon');
    const alertTitle = document.getElementById('alert-title');
    const alertMessage = document.getElementById('alert-message');
    const alertClose = document.getElementById('alert-close');
    
    // Clear previous classes
    alertBox.className = 'p-4 rounded-lg flex items-center justify-between shadow-md border-l-4 transition-all duration-300 transform';
    
    // Set icon and title based on type
    let icon = '';
    let alertTitleText = title;
    
    switch(type) {
        case 'success':
            alertBox.classList.add('alert-success');
            icon = '<i class="ri-check-circle-line text-xl alert-icon"></i>';
            if (!title) alertTitleText = 'Success!';
            break;
        case 'danger':
        case 'error':
            alertBox.classList.add('alert-danger');
            icon = '<i class="ri-error-warning-line text-xl alert-icon"></i>';
            if (!title) alertTitleText = 'Error!';
            break;
        case 'warning':
            alertBox.classList.add('alert-warning');
            icon = '<i class="ri-alert-line text-xl alert-icon"></i>';
            if (!title) alertTitleText = 'Warning!';
            break;
        default:
            alertBox.classList.add('alert-info');
            icon = '<i class="ri-information-line text-xl alert-icon"></i>';
            if (!title) alertTitleText = 'Info';
    }
    
    // Set content
    alertIcon.innerHTML = icon;
    alertTitle.textContent = alertTitleText;
    alertMessage.textContent = message;
    
    // Show alert
    alertContainer.classList.remove('hidden');
    alertBox.classList.add('alert-slide-in');
    
    // Close button event
    alertClose.onclick = () => hideAlert();
    
    // Auto hide after 5 seconds
    if (autoHide) {
        setTimeout(() => {
            hideAlert();
        }, 5000);
    }
    
    // Scroll to top to ensure alert is visible
    alertContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

function hideAlert() {
    const alertContainer = document.getElementById('alert-container');
    const alertBox = document.getElementById('alert-box');
    
    alertBox.classList.remove('alert-slide-in');
    alertBox.classList.add('alert-slide-out');
    
    setTimeout(() => {
        alertContainer.classList.add('hidden');
        alertBox.classList.remove('alert-slide-out');
    }, 300);
}

