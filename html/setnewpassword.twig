{% if site['resetPassword'] %}


<section class="page-header-ui">
    <div class="container mx-auto px-4 text-center pb-10">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-800 tracking-tight">Reset Password</h1>
        <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">Password reseting</p>
    </div>
</section>


<div class="container mx-auto px-4 py-8">
<div class="flex justify-center">
<div class="w-full md:w-8/12 lg:w-6/12">
<div class="bg-white rounded-lg shadow p-6">
<form {% if site['rtl'] %}class="rtl-form"{% endif %} method="post" action="">
<h3 class="text-xl font-semibold mb-4">{{ lang('resetpassword.setnewpassword.title') }}</h3>

{% if error %}
<div class="mb-4 rounded-md border border-red-200 bg-red-50 text-red-800 p-4 {% if site['rtl'] %} rtl-alert {% endif %}" role="alert">
<div class="flex items-start">
<div class="flex-1">
{{ errorMessage }}
</div>
<button type="button" class="ml-4 text-red-800/70 hover:text-red-900" onclick="this.closest('[role=alert]').remove()" aria-label="Close">&times;</button>
</div>
</div>
{% endif %}

{% if success %}
<div class="mb-4 rounded-md border border-green-200 bg-green-50 text-green-800 p-4 {% if site['rtl'] %} rtl-alert {% endif %}" role="alert">
<div class="flex items-start">
<div class="flex-1">
{{ successText }}
</div>
<button type="button" class="ml-4 text-green-800/70 hover:text-green-900" onclick="this.closest('[role=alert]').remove()" aria-label="Close">&times;</button>
</div>
</div>
{% endif %}

<div class="mb-4">
<label for="username" class="block text-sm font-medium text-gray-700 mb-1">{{ lang('resetpassword.username') }}</label>
<input type="text" class="block w-full rounded-md border border-gray-300 bg-white p-2.5 text-gray-900 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500" id="username" value="{{ user['username'] }}" readonly>
</div>

<div class="mb-4">
<label for="password_new" class="block text-sm font-medium text-gray-700 mb-1">{{ lang('resetpassword.new_password') }}</label>
<input type="password" class="block w-full rounded-md border border-gray-300 bg-white p-2.5 text-gray-900 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500" id="password_new" name="ResetPasswordForm[password]">
</div>

<div class="mb-6">
<label for="password_confirm" class="block text-sm font-medium text-gray-700 mb-1">{{ lang('resetpassword.confirm_new_password') }}</label>
<input type="password" class="block w-full rounded-md border border-gray-300 bg-white p-2.5 text-gray-900 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500" id="password_confirm" name="ResetPasswordForm[password_again]">
</div>

<button type="submit" class="inline-flex items-center rounded-md bg-blue-600 px-4 py-2 text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500">{{ lang('resetpassword.button.submit') }}</button>
<input type="hidden" name="_csrf" value="{{csrftoken}}">
</form>
</div>
</div>
</div> </div>
{% endif %}
{% if site['captcha'] %}
<script src='https://www.google.com/recaptcha/api.js?hl={{ site['iso_lang_code'] }}'></script>
{% endif %}