<script>
// Modal Functions
function openModal(modalId) {
    const modal = document.getElementById(modalId);
    if (modal) {
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden'; // Prevent body scroll when modal is open
        
        // Force a reflow to ensure display: flex is applied before opacity transition
        modal.offsetHeight;
        
        // Trigger fade in animation
        requestAnimationFrame(() => {
            modal.style.opacity = '1';
        });
    }
}

function closeModal(modalId) {
    const modal = document.getElementById(modalId);
    if (modal) {
        // Fade out animation
        modal.style.opacity = '0';
        
        // Hide modal after animation completes
        setTimeout(() => {
            modal.style.display = 'none';
            document.body.style.overflow = 'auto'; // Restore body scroll
        }, 300); // Matches the transition duration (0.3s)
    }
}

// Close modal when clicking outside of modal content
document.addEventListener('click', function(event) {
    if (event.target.classList.contains('modal-overlay')) {
        const modalId = event.target.id;
        closeModal(modalId);
    }
});

// Close modal with ESC key
document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
        const openModals = document.querySelectorAll('.modal-overlay[style*="flex"]');
        openModals.forEach(modal => {
            closeModal(modal.id);
        });
    }
});

document.addEventListener('DOMContentLoaded', function() {
    // Pricing Toggle Functionality
    const pricingToggle = document.getElementById('pricing-toggle');
    const pricingCards = document.querySelectorAll('[data-v0-t="card"]');
    let isYearly = false; // Default to monthly as toggle is in monthly position
    
    // Pricing data
    const pricingData = {
        'whatsapp-pro': {
            monthly: { price: '$49', period: '/month', save: '' },
            yearly: { price: '$490', period: '/year', save: 'Save $98/year' }
        },
        'telegram-pro': {
            monthly: { price: '$59', period: '/month', save: '' },
            yearly: { price: '$590', period: '/year', save: 'Save $118/year' }
        },
        'ultimate-pro': {
            monthly: { price: '$89', period: '/month', save: '' },
            yearly: { price: '$890', period: '/year', save: 'Save $178/year' }
        }
    };
    
    if (pricingToggle) {
        pricingToggle.addEventListener('click', function() {
            const toggleButton = this.querySelector('span');
            const monthlyLabel = document.getElementById('monthly-label');
            const yearlyLabel = document.getElementById('yearly-label');
            const saveBadge = document.getElementById('save-badge');
            
            if (isYearly) {
                // Switch to Monthly
                toggleButton.classList.remove('translate-x-6');
                toggleButton.classList.add('translate-x-1');
                // Change toggle background to gray
                this.style.backgroundColor = '#6B7280';
                // Make Monthly label bold/dark and Yearly label normal
                monthlyLabel.style.fontWeight = 'bold';
                monthlyLabel.style.color = 'var(--text-heading)';
                yearlyLabel.style.fontWeight = 'normal';
                yearlyLabel.style.color = 'var(--text-dark)';
                // Hide save badge when monthly is selected
                saveBadge.style.display = 'none';
                isYearly = false;
                updatePricing('monthly');
            } else {
                // Switch to Yearly
                toggleButton.classList.remove('translate-x-1');
                toggleButton.classList.add('translate-x-6');
                // Change toggle background to blue
                this.style.backgroundColor = 'var(--primary-blue)';
                // Make Yearly label bold/dark and Monthly label normal
                yearlyLabel.style.fontWeight = 'bold';
                yearlyLabel.style.color = 'var(--text-heading)';
                monthlyLabel.style.fontWeight = 'normal';
                monthlyLabel.style.color = 'var(--text-dark)';
                // Show save badge when yearly is selected
                saveBadge.style.display = 'inline-flex';
                isYearly = true;
                updatePricing('yearly');
            }
        });
    }
    
    function updatePricing(period) {
        // Update WhatsApp Pro pricing
        const whatsappCards = document.querySelectorAll('[data-v0-t="card"]');
        whatsappCards.forEach(card => {
            const priceElement = card.querySelector('.text-5xl');
            const periodElement = card.querySelector('.text-lg');
            const saveElement = card.querySelector('.text-green-600');
            
            if (priceElement && periodElement && saveElement) {
                if (card.innerHTML.includes('WhatsApp Pro')) {
                    priceElement.textContent = pricingData['whatsapp-pro'][period].price;
                    periodElement.textContent = pricingData['whatsapp-pro'][period].period;
                    saveElement.textContent = pricingData['whatsapp-pro'][period].save;
                    saveElement.style.display = pricingData['whatsapp-pro'][period].save ? 'block' : 'none';
                } else if (card.innerHTML.includes('Telegram Pro')) {
                    priceElement.textContent = pricingData['telegram-pro'][period].price;
                    periodElement.textContent = pricingData['telegram-pro'][period].period;
                    saveElement.textContent = pricingData['telegram-pro'][period].save;
                    saveElement.style.display = pricingData['telegram-pro'][period].save ? 'block' : 'none';
                } else if (card.innerHTML.includes('Ultimate Pro')) {
                    priceElement.textContent = pricingData['ultimate-pro'][period].price;
                    periodElement.textContent = pricingData['ultimate-pro'][period].period;
                    saveElement.textContent = pricingData['ultimate-pro'][period].save;
                    saveElement.style.display = pricingData['ultimate-pro'][period].save ? 'block' : 'none';
                }
            }
        });
    }
});

</script>

