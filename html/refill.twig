<div class="relative z-10 pb-16 md:pb-15 bg-white pt-6">
    <div class="mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Top bar -->
        <div class="space-y-6 mb-8">
            <!-- Filters and Search Row -->
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <!-- Filters -->
                <div class="flex flex-wrap items-center gap-3 {% if site['rtl'] %} rtl-nav {% endif %}">
                    <a href="{{ page['url'] }}" class="{% if 'all' == status %}filter-btn-active{% else %}flex items-center gap-2 px-4 py-2 text-gray-700 bg-white border border-gray-200 rounded-[25px] hover:bg-gray-50 font-medium{% endif %} flex items-center gap-2 px-4 py-2 font-medium">
                        <i class="ri-layout-grid-fill"></i>
                        <span>{{ lang('refill.all') }}</span>
                    </a>
                    <a href="{{ page['url'] }}/pending" class="{% if 'pending' == status %}filter-btn-active{% else %}flex items-center gap-2 px-4 py-2 text-gray-700 bg-white border border-gray-200 rounded-[25px] hover:bg-gray-50 font-medium{% endif %} flex items-center gap-2 px-4 py-2 font-medium">
                        <i class="ri-time-line"></i>
                        <span>{{ lang('refill.status.pending') }}</span>
                    </a>
                    <a href="{{ page['url'] }}/inprogress" class="{% if 'inprogress' == status %}filter-btn-active{% else %}flex items-center gap-2 px-4 py-2 text-gray-700 bg-white border border-gray-200 rounded-[25px] hover:bg-gray-50 font-medium{% endif %} flex items-center gap-2 px-4 py-2 font-medium">
                        <i class="ri-loader-4-line"></i>
                        <span>{{ lang('refill.status.inprogress') }}</span>
                    </a>
                    <a href="{{ page['url'] }}/completed" class="{% if 'completed' == status %}filter-btn-active{% else %}flex items-center gap-2 px-4 py-2 text-gray-700 bg-white border border-gray-200 rounded-[25px] hover:bg-gray-50 font-medium{% endif %} flex items-center gap-2 px-4 py-2 font-medium">
                        <i class="ri-check-double-line"></i>
                        <span>{{ lang('refill.status.completed') }}</span>
                    </a>
                    <a href="{{ page['url'] }}/rejected" class="{% if 'rejected' == status %}filter-btn-active{% else %}flex items-center gap-2 px-4 py-2 text-gray-700 bg-white border border-gray-200 rounded-[25px] hover:bg-gray-50 font-medium{% endif %} flex items-center gap-2 px-4 py-2 font-medium">
                        <i class="ri-close-circle-line"></i>
                        <span>{{ lang('refill.status.rejected') }}</span>
                    </a>
                    <a href="{{ page['url'] }}/error" class="{% if 'error' == status %}filter-btn-active{% else %}flex items-center gap-2 px-4 py-2 text-gray-700 bg-white border border-gray-200 rounded-[25px] hover:bg-gray-50 font-medium{% endif %} flex items-center gap-2 px-4 py-2 font-medium">
                        <i class="ri-error-warning-line"></i>
                        <span>{{ lang('refill.status.error') }}</span>
                    </a>
                </div>
                
                <!-- Search -->
                <div class="relative w-full sm:w-80">
                    <form action="{{ page['url'] }}" method="get" id="history-search" class="w-full">
                        <div class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none">
                            <i class="ri-search-line text-gray-400"></i>
                        </div>
                        <input type="text" name="search" value="{{ search }}" placeholder="{{ lang('general.search.placeholder') }}" class="w-full bg-white border border-gray-200 rounded-[20px] pl-10 pr-4 py-2 shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-400 transition">
                    </form>
                </div>
            </div>
        </div>

        <!-- Refill Table -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
            <!-- Desktop Table -->
            <div class="hidden md:block overflow-x-auto">
                <table class="w-full {% if site['rtl'] %} rtl-table {% endif %}">
                    <thead class="bg-gray-50 border-b border-gray-200">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ lang('refill.id') }}</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ lang('refill.date') }}</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ lang('refill.order_id') }}</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ lang('refill.link') }}</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ lang('refill.service') }}</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ lang('refill.status') }}</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200 font-medium">
                        {% for refill in refillList %}
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-blue-600">
                                <div class="flex items-center gap-2 group cursor-pointer" onclick="copyToClipboard('{{ refill['id'] }}')">
                                    <span>{{ refill['id'] }}</span>
                                    <i class="ri-clipboard-line text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-200 text-gray-400 group-hover:text-blue-600"></i>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">{{ refill['date'] }}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-blue-600">
                                <a href="{{ page_url('orders') }}?search={{ refill['order_id'] }}" class="hover:text-blue-800 transition-colors">{{ refill['order_id'] }}</a>
                            </td>
                            <td class="px-6 py-4 text-sm text-blue-600 w-[25%]">
                                <div class="flex items-center gap-2 group">
                                    <a href="{{ refill['link'] }}" target="_blank" class="break-all hover:text-blue-800 transition-colors">
                                        {{ refill['link'] }}
                                    </a>
                                    <i class="ri-external-link-line text-gray-400 opacity-0 group-hover:opacity-100 transition-opacity flex-shrink-0"></i>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-base font-medium text-gray-900 w-[30%]" data-service-name="{{ refill['service'] }}">
                                <div class="flex items-center gap-3">
                                    <i class="ri-star-fill text-2xl text-yellow-500 flex-shrink-0"></i>
                                    <div class="flex-1">
                                        <span class="break-words block" title="{{ refill['service'] }}">
                                            {{ refill['service'] }}
                                        </span>
                                        <div class="text-xs text-gray-500 mt-1 font-normal">{{ refill['date'] }}</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                {% if refill['status'] == 'Pending' %}
                                <div class="inline-flex items-center px-3 py-1 bg-yellow-100 border border-yellow-400 rounded-full">
                                    <i class="ri-time-line text-yellow-700 mr-2"></i>
                                    <span class="text-yellow-800 text-xs font-semibold">{{ refill['status'] }}</span>
                                </div>
                                {% elseif refill['status'] == 'Completed' %}
                                <div class="inline-flex items-center px-3 py-1 bg-green-100 border border-green-500 rounded-full">
                                    <i class="ri-check-line text-green-700 mr-2"></i>
                                    <span class="text-green-800 text-xs font-semibold">{{ refill['status'] }}</span>
                                </div>
                                {% elseif refill['status'] == 'In Progress' %}
                                <div class="inline-flex items-center px-3 py-1 bg-blue-100 border border-blue-500 rounded-full">
                                    <i class="ri-loader-4-line text-blue-700 mr-2"></i>
                                    <span class="text-blue-800 text-xs font-semibold">{{ refill['status'] }}</span>
                                </div>
                                {% elseif refill['status'] == 'Rejected' %}
                                <div class="inline-flex items-center px-3 py-1 bg-red-100 border border-red-500 rounded-full">
                                    <i class="ri-close-circle-line text-red-700 mr-2"></i>
                                    <span class="text-red-800 text-xs font-semibold">{{ refill['status'] }}</span>
                                </div>
                                {% elseif refill['status'] == 'Error' %}
                                <div class="inline-flex items-center px-3 py-1 bg-red-100 border border-red-500 rounded-full">
                                    <i class="ri-error-warning-line text-red-700 mr-2"></i>
                                    <span class="text-red-800 text-xs font-semibold">{{ refill['status'] }}</span>
                                </div>
                                {% else %}
                                <span class="text-gray-900 text-xs font-semibold">{{ refill['status'] }}</span>
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <!-- Mobile Cards -->
            <div class="md:hidden">
                {% for refill in refillList %}
                <div class="p-4 {% if not loop.last %}border-b border-gray-200{% endif %}">
                    <div class="flex justify-between items-start mb-3">
                        <div>
                            <h3 class="text-sm font-medium text-gray-900">Refill #{{ refill['id'] }}</h3>
                            <p class="text-xs text-gray-500">{{ refill['date'] }}</p>
                        </div>
                        {% if refill['status'] == 'Pending' %}
                        <div class="inline-flex items-center px-3 py-1 bg-yellow-100 border border-yellow-400 rounded-full">
                            <i class="ri-time-line text-yellow-700 mr-2"></i>
                            <span class="text-yellow-800 text-xs font-semibold">{{ refill['status'] }}</span>
                        </div>
                        {% elseif refill['status'] == 'Completed' %}
                        <div class="inline-flex items-center px-3 py-1 bg-green-100 border border-green-500 rounded-full">
                            <i class="ri-check-line text-green-700 mr-2"></i>
                            <span class="text-green-800 text-xs font-semibold">{{ refill['status'] }}</span>
                        </div>
                        {% elseif refill['status'] == 'In Progress' %}
                        <div class="inline-flex items-center px-3 py-1 bg-blue-100 border border-blue-500 rounded-full">
                            <i class="ri-loader-4-line text-blue-700 mr-2"></i>
                            <span class="text-blue-800 text-xs font-semibold">{{ refill['status'] }}</span>
                        </div>
                        {% elseif refill['status'] == 'Rejected' %}
                        <div class="inline-flex items-center px-3 py-1 bg-red-100 border border-red-500 rounded-full">
                            <i class="ri-close-circle-line text-red-700 mr-2"></i>
                            <span class="text-red-800 text-xs font-semibold">{{ refill['status'] }}</span>
                        </div>
                        {% elseif refill['status'] == 'Error' %}
                        <div class="inline-flex items-center px-3 py-1 bg-red-100 border border-red-500 rounded-full">
                            <i class="ri-error-warning-line text-red-700 mr-2"></i>
                            <span class="text-red-800 text-xs font-semibold">{{ refill['status'] }}</span>
                        </div>
                        {% endif %}
                    </div>
                    <div class="space-y-2 text-sm">
                        <div class="flex justify-between">
                            <span class="text-gray-500">Order ID:</span>
                            <span class="text-blue-600 font-medium">
                                <a href="{{ page_url('orders') }}?search={{ refill['order_id'] }}" class="hover:text-blue-800 transition-colors">{{ refill['order_id'] }}</a>
                            </span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-500">Service:</span>
                            <span class="text-gray-900">{{ refill['service'] }}</span>
                        </div>
                    </div>

                    <!-- Link -->
                    <div class="border-t border-gray-200 pt-4 mt-4">
                         <div class="flex items-start gap-3 text-gray-700">
                            <i class="ri-link text-lg text-gray-500 mt-1"></i>
                            <div>
                                <div class="text-sm text-gray-600 font-medium">Link</div>
                                <a href="{{ refill['link'] }}" target="_blank" class="text-blue-600 break-all font-medium hover:underline">{{ refill['link'] }}</a>
                            </div>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>

        <!-- Pagination -->
        {% if pagination['count'] > 100 %}
            {% if searchList %}
                {% set params = {} %}
                {% for search in searchList %}
                    {% set params = params | merge([search['name'] ~ '=' ~ search['value']]) %}
                {% endfor %}
                {% set params = '?' ~ params|join('&') %}
            {% endif %}
            <div class="flex justify-center mt-8">
                <ul class="inline-flex items-center space-x-1 {% if site['rtl'] %} rtl-pagination {% endif %}">
                    {% if pagination['current'] != 1 %}
                        <li>
                            <a href="{{ page['url'] }}/{{ status }}/{{ pagination['last'] }}{{ params }}" class="inline-flex items-center px-3 py-2 text-sm font-medium text-gray-500 bg-white border border-gray-300 rounded-l-lg hover:bg-gray-100 hover:text-gray-700">
                                <span aria-hidden="true">&laquo;</span>
                            </a>
                        </li>
                    {% endif %}

                    {% set r, l = 3, 3 %}
                    {% if pagination['current'] == 1 %}
                        {% set r = 6 %}
                    {% endif %}
                    {% if pagination['current'] == 2 %}
                        {% set r = 5 %}
                    {% endif %}
                    {% if pagination['current'] >= pagination['pages'] %}
                        {% set l = 5 %}
                    {% endif %}

                    {% for i in 1..ceil(pagination['pages']) %}
                        {% if i >= (pagination['current']-l) and i <= (pagination['current']+r) %}
                            <li>
                                <a href="{{ page['url'] }}/{{ status }}/{{ i }}{{ params }}" class="inline-flex items-center px-3 py-2 text-sm font-medium {% if i == pagination['current'] %}text-blue-600 bg-blue-50 border border-blue-300{% else %}text-gray-500 bg-white border border-gray-300 hover:bg-gray-100 hover:text-gray-700{% endif %}">
                                    {{ i }}
                                </a>
                            </li>
                        {% endif %}
                    {% endfor %}

                    {% if pagination['current'] < pagination['pages'] %}
                        <li>
                            <a href="{{ page['url'] }}/{{ status }}/{{ pagination['next'] }}{{ params }}" class="inline-flex items-center px-3 py-2 text-sm font-medium text-gray-500 bg-white border border-gray-300 rounded-r-lg hover:bg-gray-100 hover:text-gray-700">
                                <span aria-hidden="true">&raquo;</span>
                            </a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        {% endif %}
    </div>
</div>

<script>
    // Copy to clipboard function
    function copyToClipboard(text) {
        navigator.clipboard.writeText(text).then(function() {
            showNotification('ID copied: ' + text, 'success');
        }).catch(function(err) {
            showNotification('Copy failed', 'error');
        });
    }

    // Show notification function
    function showNotification(message, type = 'success') {
        // Remove existing notifications
        const existingNotifications = document.querySelectorAll('.notification');
        existingNotifications.forEach(notification => notification.remove());

        // Create notification element
        const notification = document.createElement('div');
        notification.className = `notification fixed top-4 right-4 z-[99999] px-4 py-3 rounded-lg shadow-lg transform transition-all duration-300 translate-x-full ${
            type === 'success' ? 'bg-green-500 text-white' : 'bg-red-500 text-white'
        }`;
        notification.innerHTML = `
            <div class="flex items-center gap-2">
                <i class="ri-${type === 'success' ? 'check-line' : 'close-line'}"></i>
                <span>${message}</span>
            </div>
        `;

        // Add to page
        document.body.appendChild(notification);

        // Animate in
        setTimeout(() => {
            notification.classList.remove('translate-x-full');
        }, 10);

        // Remove after 3 seconds
        setTimeout(() => {
            notification.classList.add('translate-x-full');
            setTimeout(() => {
                if (notification.parentNode) {
                    notification.parentNode.removeChild(notification);
                }
            }, 300);
        }, 3000);
    }

    function getRemixIconForCategory(categoryName) {
        categoryName = categoryName.toLowerCase();
        if (categoryName.includes('instagram')) {
            return { icon: 'ri-instagram-line', color: 'text-pink-500' };
        } else if (categoryName.includes('facebook')) {
            return { icon: 'ri-facebook-box-fill', color: 'text-blue-600' };
        } else if (categoryName.includes('twitter') || categoryName.includes(' x ')) {
            return { icon: 'ri-twitter-x-line', color: 'text-black' };
        } else if (categoryName.includes('tiktok')) {
            return { icon: 'ri-tiktok-fill', color: 'text-black' };
        } else if (categoryName.includes('telegram')) {
            return { icon: 'ri-telegram-fill', color: 'text-sky-500' };
        } else if (categoryName.includes('youtube')) {
            return { icon: 'ri-youtube-fill', color: 'text-red-600' };
        } else if (categoryName.includes('spotify')) {
            return { icon: 'ri-spotify-fill', color: 'text-green-500' };
        } else if (categoryName.includes('linkedin')) {
            return { icon: 'ri-linkedin-box-fill', color: 'text-blue-700' };
        } else if (categoryName.includes('twitch')) {
            return { icon: 'ri-twitch-fill', color: 'text-purple-600' };
        } else if (categoryName.includes('discord')) {
            return { icon: 'ri-discord-fill', color: 'text-indigo-500' };
        }
        // Add more mappings as needed
        return { icon: 'ri-star-fill', color: 'text-yellow-500' }; // Default icon
    }

    // Set icons based on service names when page loads
    document.addEventListener('DOMContentLoaded', function() {
        const serviceCells = document.querySelectorAll('[data-service-name]');
        serviceCells.forEach(cell => {
            const serviceName = cell.getAttribute('data-service-name');
            const iconElement = cell.querySelector('i');
            if (iconElement && serviceName) {
                const iconData = getRemixIconForCategory(serviceName);
                iconElement.className = `${iconData.icon} text-2xl ${iconData.color}`;
            }
        });
    });
</script>

<style>
.filter-btn-active {
    @apply bg-gradient-to-r from-blue-500 to-blue-600 text-white border-blue-600 shadow-md;
}
</style>
