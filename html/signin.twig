                                                    <span class="ml-5 text-xs font-medium text-gray-600 group-hover:text-gray-900 transition-colors">{{ lang('signin.remember_me') ? lang('signin.remember_me') : 'Remember me' }}</span>
                                                </label>
                                            </div>
