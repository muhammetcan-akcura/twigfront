                                                   data-theme="outline"
                                                   data-text="sign_in_with"
                                                   data-shape="rectangular"
                                                   data-logo_alignment="left">
                                                </div>
                                            </div>
                                        {% endif %}

                                        <p class="text-xs text-center text-gray-500 font-medium !mt-4">
                                            {{ lang('signin.text') ? lang('signin.text') : "Don't have an account?" }} <a href="{{ page_url('signup') }}" class="font-bold text-blue-600 hover:text-blue-700 transition-colors">{{ lang('signup.title') ? lang('signup.title') : 'Sign up now' }}</a>
                                        </p>
                                    </form>
                                </div>
