                                                <button type="button" id="toggle-password" class="absolute inset-y-0 right-0 flex items-center pr-3 text-gray-400 hover:text-blue-500 transition-colors focus:outline-none">
                                                    <i class="ri-eye-line text-base"></i>
                                                </button>
                                            </div>
                                        </div>
                                        
                                        {% if captcha %}
