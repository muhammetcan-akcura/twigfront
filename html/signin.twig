                                        <input type="hidden" name="_csrf" value="{{csrftoken}}">
                                        
                                        <button type="submit" class="w-full flex items-center justify-center gap-2 text-white bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 font-semibold rounded-xl text-sm px-4 py-2.5 text-center !mt-5 shadow-md shadow-blue-500/30 hover:shadow-blue-500/50 transform hover:-translate-y-0.5 transition-all duration-300 outline-none focus:ring-4 focus:ring-blue-500/20">
