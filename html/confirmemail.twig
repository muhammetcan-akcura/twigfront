<div class="max-w-screen-xl mx-auto px-4">
  <div class="flex flex-wrap">
    <div class="w-full md:w-2/3 md:mx-auto">
      <div class="bg-white border border-gray-200 rounded-lg shadow-md p-6 confirm-email">
        <form {% if site['rtl'] %}class="rtl-form"{% endif %} method="post" action="">
          <div class="flex flex-wrap">
            <div class="w-full text-center">
              {% if successResend %}
                <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4 {% if site['rtl'] %} rtl-alert {% endif %}">
                  <button type="button" class="absolute top-0 right-0 px-4 py-3 text-green-700 hover:text-green-900">&times;</button>
                  {{ successResendMessage }}
                </div>
              {% endif %}
              {% if errorResend %}
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4 {% if site['rtl'] %} rtl-alert {% endif %}">
                  <button type="button" class="absolute top-0 right-0 px-4 py-3 text-red-700 hover:text-red-900">&times;</button>
                  {{ errorResendMessage }}
                </div>
              {% endif %}
              <h3 class="text-2xl font-semibold mb-4">{{ lang('confirmemail.message.title') }}</h3>
            </div>
          </div>
          <div class="flex flex-wrap">
            <div class="w-full">
              <div class="confirm-email__description text-center mb-6">
                  {% if isSelfChangeEmail %}
                    <div class="mb-2">{{ lang('confirmemail.message.sent') }} {{ user['email'] }}</div>
                    <div>{{ lang('confirmemail.message.description') }}</div>
                  {% else %}
                      {{ lang('confirmemail.message.description') }}
                  {% endif %}
              </div>
            </div>
            <div class="confirm-email__action text-center w-full">
              <button class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded mr-2" id="resendEmailLink">{{ lang('confirmemail.button.resend') }}</button>
              {% if can_change_email == 1 %}
                <button class="text-blue-500 hover:text-blue-700 underline font-medium py-2 px-4" id="changeEmailLink">{{ lang('confirmemail.button.change') }}</button>
              {% endif %}
            </div>
          </div>

          <input type="hidden" name="_csrf" value="{{ csrftoken }}">
        </form>
      </div>
    </div>
  </div>
</div>

{% if can_change_email == 1 %}
  <!-- Change email -->
  <div class="fixed inset-0 z-50 overflow-auto bg-black bg-opacity-50 flex items-center justify-center hidden" id="changeEmailModal">
    <div class="bg-white rounded-lg shadow-lg max-w-md w-full mx-4">
      <form id="changeEmailForm" class="{% if site['rtl'] %} rtl-form{% endif %}" method="post" action="">
        <div class="flex justify-between items-center p-6 border-b border-gray-200">
          <h4 class="text-xl font-semibold">{{ lang('confirmemail.change_email.title') }}</h4>
          <button type="button" class="text-gray-400 hover:text-gray-600 text-2xl font-bold" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="p-6">
          <div id="changeEmailError" class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4 hidden{% if site['rtl'] %} rtl-alert {% endif %}"></div>
          <div class="mb-4">
            <label for="current-email" class="block text-gray-700 text-sm font-bold mb-2">{{ lang('confirmemail.change_email.current_email') }}</label>
            <span class="bg-gray-100 border border-gray-300 rounded w-full py-2 px-3 text-gray-700" id="current-email">{{ current_email }}</span>
          </div>
          <div class="mb-4">
            <label for="new-email" class="block text-gray-700 text-sm font-bold mb-2">{{ lang('confirmemail.change_email.new_email') }}</label>
            <input type="email" class="border border-gray-300 rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline focus:border-blue-500" id="new-email" name="ChangeConfirmationEmailForm[email]">
          </div>
          <div class="mb-4">
            <label for="current-password" class="block text-gray-700 text-sm font-bold mb-2">{{ lang('confirmemail.change_email.current_password') }}</label>
            <input type="password" class="border border-gray-300 rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline focus:border-blue-500" id="current-password" name="ChangeConfirmationEmailForm[password]">
          </div>
          <input type="hidden" name="_csrf" value="{{ csrftoken }}">
        </div>
        <div class="flex justify-end p-6 border-t border-gray-200 space-x-2">
          <button type="button" class="bg-gray-500 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded" data-dismiss="modal">{{ lang('confirmemail.change_email.close') }}</button>
          <button type="submit" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" id="changeEmailSubmitBtn">{{ lang('confirmemail.change_email.submit') }}</button>
        </div>
      </form>
    </div>
  </div>
{% endif %}
