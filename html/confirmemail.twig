<style>
    body, html {
        background: radial-gradient(ellipse at top right, #ffffff 0%, #eff6ff 50%, #bfdbfe 100%) !important;
        background-attachment: fixed !important;
        color: #1E293B;
        overflow-x: hidden;
    }
    .font-outfit { font-family: 'Outfit', sans-serif; }
    
    /* Hide dashboard elements */
    aside, #top-bar { display: none !important; }
    #main-content { margin-left: 0 !important; width: 100% !important; background: transparent !important; }
</style>

<!-- Abstract Background Wave Lines (SVG) -->
<svg class="absolute top-0 left-0 w-full h-full z-0 pointer-events-none hidden md:block opacity-60" viewBox="0 0 1440 800" fill="none" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M-100 600 C 300 800, 600 200, 1500 500" stroke="#ffffff" stroke-width="3" opacity="0.4"/>
    <path d="M-100 500 C 400 400, 800 900, 1500 300" stroke="#eff6ff" stroke-width="8" opacity="0.6"/>
    <path d="M-100 200 C 400 -50, 900 600, 1500 200" stroke="#bfdbfe" stroke-width="2" opacity="0.7"/>
    <path d="M-100 700 C 500 500, 1000 900, 1500 600" stroke="#60a5fa" stroke-width="4" opacity="0.3"/>
    
    <!-- Glow Dots -->
    <circle cx="200" cy="700" r="6" fill="#ffffff" opacity="0.6"/>
    <circle cx="900" cy="150" r="4" fill="#60a5fa" opacity="0.5"/>
    <circle cx="1300" cy="650" r="8" fill="#eff6ff" opacity="0.8"/>
</svg>

<!-- Floating 3D Spheres & Blurred Elements -->
<div class="absolute top-20 right-10 w-64 h-64 bg-blue-400 rounded-full mix-blend-multiply filter blur-[100px] opacity-20 pointer-events-none"></div>
<div class="absolute bottom-20 left-10 w-72 h-72 bg-indigo-300 rounded-full mix-blend-multiply filter blur-[100px] opacity-20 pointer-events-none"></div>

<!-- Mini Header -->
<div class="absolute top-0 left-0 w-full px-6 py-5 sm:px-10 flex justify-between items-center z-40">
    <a href="/" class="flex items-center">
        {% if site['logo'] %}
            <img src="{{ site['logo'] }}" alt="{{ site['name'] }}" class="h-6 sm:h-7 object-contain">
        {% else %}
            <span class="font-bold text-xl font-outfit text-blue-600">{{ site['name'] }}</span>
        {% endif %}
    </a>
    <a href="/logout" class="flex items-center gap-2 text-slate-500 hover:text-red-600 font-medium text-sm px-4 py-2 rounded-full hover:bg-red-50 border border-slate-200 hover:border-red-100 bg-white/50 backdrop-blur-sm transition-colors">
        <i class="ri-logout-box-r-line text-lg"></i>
        <span class="hidden sm:inline">Logout</span>
    </a>
</div>

<div class="min-h-screen flex flex-col items-center justify-center py-12 px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-lg w-full mt-4">
        <!-- Main Card -->
        <div class="bg-white border border-slate-200/60 rounded-3xl shadow-xl p-8 sm:p-10 confirm-email">
            <form id="confirm-email-form" {% if site['rtl'] %}class="rtl-form"{% endif %} method="post" action="">
                
                <!-- Icon Header -->
                <div class="flex justify-center mb-8">
                    <div class="w-20 h-20 bg-blue-50 border border-blue-100 rounded-full flex items-center justify-center">
                        <i class="ri-mail-send-line text-4xl text-blue-600"></i>
                    </div>
                </div>

                <!-- Alerts -->
                <div class="w-full text-center">
                    {% if successResend %}
                        <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 px-4 py-3 rounded-xl relative mb-6 text-sm font-medium flex items-center gap-3 {% if site['rtl'] %} rtl-alert {% endif %}">
                            <i class="ri-checkbox-circle-fill text-lg"></i>
                            <span class="flex-grow text-left">{{ successResendMessage }}</span>
                            <button type="button" class="text-emerald-500 hover:text-emerald-700 transition-colors" onclick="this.parentElement.style.display='none'">
                                <i class="ri-close-line text-lg"></i>
                            </button>
                        </div>
                    {% endif %}
                    
                    {% if errorResend %}
                        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl relative mb-6 text-sm font-medium flex items-center gap-3 {% if site['rtl'] %} rtl-alert {% endif %}">
                            <i class="ri-error-warning-fill text-lg"></i>
                            <span class="flex-grow text-left">{{ errorResendMessage }}</span>
                            <button type="button" class="text-red-500 hover:text-red-700 transition-colors" onclick="this.parentElement.style.display='none'">
                                <i class="ri-close-line text-lg"></i>
                            </button>
                        </div>
                    {% endif %}
                    
                    <h3 class="text-2xl sm:text-3xl font-bold font-outfit text-slate-800 mb-4">{{ lang('confirmemail.message.title') }}</h3>
                </div>

                <!-- Description -->
                <div class="w-full text-center mb-8">
                    <div class="confirm-email__description text-slate-500 text-sm sm:text-base leading-relaxed">
                        {% if isSelfChangeEmail %}
                            <div class="mb-4 bg-slate-50 border border-slate-100 py-3 px-4 rounded-xl inline-block">
                                <span class="text-slate-600">{{ lang('confirmemail.message.sent') }}</span>
                                <strong class="text-slate-800 ml-1">{{ user['email'] }}</strong>
                            </div>
                            <div class="text-slate-500">{{ lang('confirmemail.message.description') }}</div>
                        {% else %}
                            <div class="text-slate-500">{{ lang('confirmemail.message.description') }}</div>
                        {% endif %}
                    </div>
                </div>

                <!-- Actions -->
                <div class="confirm-email__action flex flex-col sm:flex-row items-center justify-center gap-4 w-full">
                    <button class="w-full sm:w-auto flex items-center justify-center gap-2 text-white bg-blue-600 hover:bg-blue-700 font-semibold rounded-xl text-sm px-8 py-3 transition-colors outline-none" id="resendEmailLink">
                        <i class="ri-refresh-line"></i>
                        {{ lang('confirmemail.button.resend') }}
                    </button>
                    
                    {% if can_change_email == 1 %}
                        <button type="button" class="w-full sm:w-auto flex items-center justify-center gap-2 text-slate-600 bg-white border border-slate-200 hover:bg-slate-50 hover:text-blue-600 font-semibold rounded-xl text-sm px-8 py-3 transition-colors outline-none" id="customChangeEmailBtn">
                            <i class="ri-edit-line"></i>
                            {{ lang('confirmemail.button.change') }}
                        </button>
                    {% endif %}
                </div>

                <input type="hidden" name="_csrf" value="{{ csrftoken }}">
            </form>
        </div>
    </div>
</div>

{% if can_change_email == 1 %}
    <!-- Change email Modal -->
    <div class="fixed inset-0 z-[100] flex items-center justify-center hidden bg-slate-900/40" id="changeEmailModalWrapper">
        <div class="bg-white rounded-3xl shadow-xl max-w-md w-full mx-4" id="changeEmailModalInner">
            
            <form id="changeEmailForm" class="{% if site['rtl'] %} rtl-form{% endif %}" method="post" action="">
                
                <!-- Modal Header -->
                <div class="flex justify-between items-center p-6 border-b border-slate-100">
                    <h4 class="text-lg font-bold font-outfit text-slate-800 flex items-center gap-2">
                        <i class="ri-mail-settings-line text-blue-600"></i>
                        {{ lang('confirmemail.change_email.title') }}
                    </h4>
                    <button type="button" class="text-slate-400 hover:text-slate-600 transition-colors w-8 h-8 flex items-center justify-center rounded-full hover:bg-slate-100" id="closeModalBtn">
                        <i class="ri-close-line text-xl"></i>
                    </button>
                </div>
                
                <!-- Modal Body -->
                <div class="p-6">
                    <div id="changeEmailError" class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl mb-6 hidden text-sm font-medium {% if site['rtl'] %} rtl-alert {% endif %}"></div>
                    
                    <div class="mb-5">
                        <label for="current-email" class="block text-xs font-semibold text-slate-500 mb-1.5 uppercase tracking-wider">{{ lang('confirmemail.change_email.current_email') }}</label>
                        <div class="w-full py-2.5 px-4 bg-slate-50 border border-slate-200 text-slate-600 text-sm font-medium rounded-xl">
                            {{ current_email }}
                        </div>
                    </div>
                    
                    <div class="mb-5">
                        <label for="new-email" class="block text-sm font-semibold text-slate-700 mb-1.5">{{ lang('confirmemail.change_email.new_email') }}</label>
                        <div class="relative group">
                            <div class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
                                <i class="ri-mail-line"></i>
                            </div>
                            <input type="email" class="w-full pl-10 pr-4 py-2.5 bg-white border border-slate-200 text-slate-900 text-sm rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none" id="new-email" name="ChangeConfirmationEmailForm[email]" placeholder="Enter new email address">
                        </div>
                    </div>
                    
                    <div class="mb-6">
                        <label for="current-password" class="block text-sm font-semibold text-slate-700 mb-1.5">{{ lang('confirmemail.change_email.current_password') }}</label>
                        <div class="relative group">
                            <div class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
                                <i class="ri-lock-password-line"></i>
                            </div>
                            <input type="password" class="w-full pl-10 pr-4 py-2.5 bg-white border border-slate-200 text-slate-900 text-sm rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none" id="current-password" name="ChangeConfirmationEmailForm[password]" placeholder="Enter current password">
                        </div>
                    </div>
                    
                    <input type="hidden" name="_csrf" value="{{ csrftoken }}">
                    
                    <div class="flex items-center gap-3 mt-8">
                        <button type="button" class="flex-1 bg-white border border-slate-200 hover:bg-slate-50 text-slate-600 font-semibold py-2.5 px-4 rounded-xl transition-colors text-sm" id="closeModalBtn2">
                            {{ lang('confirmemail.change_email.close') }}
                        </button>
                        <button type="submit" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 px-4 rounded-xl transition-colors text-sm" id="changeEmailSubmitBtn">
                            {{ lang('confirmemail.change_email.submit') }}
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const modalWrapper = document.getElementById('changeEmailModalWrapper');
            const openBtn = document.getElementById('customChangeEmailBtn');
            const closeBtn1 = document.getElementById('closeModalBtn');
            const closeBtn2 = document.getElementById('closeModalBtn2');

            // Original link if PerfectPanel uses it
            const originalLink = document.getElementById('changeEmailLink');
            
            function openModal() {
                modalWrapper.classList.remove('hidden');
            }

            function closeModal() {
                modalWrapper.classList.add('hidden');
            }

            if(openBtn) {
                openBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    if(originalLink) {
                        originalLink.click(); // Trigger native behavior if any
                    }
                    openModal();
                });
            }

            if(closeBtn1) closeBtn1.addEventListener('click', closeModal);
            if(closeBtn2) closeBtn2.addEventListener('click', closeModal);

            // Close on outside click
            modalWrapper.addEventListener('click', function(e) {
                if (e.target === modalWrapper) {
                    closeModal();
                }
            });
        });
    </script>
{% endif %}
