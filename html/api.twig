{% if user['auth'] %}{% else %}
<section class="page-header-ui">
    <div class="container mx-auto px-4 text-center pb-10">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-800 tracking-tight">API</h1>
        <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">API Documents</p>
    </div>
</section>
{% endif %}   

<div class="relative z-10 pb-16 md:pb-15 bg-white pt-6">
            <div class="container mx-auto px-4 relative z-10">
        
                <!-- Top Info Cards -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
                    <!-- HTTP Method -->
                    <div class="bg-white border border-gray-200 rounded-xl p-6 text-center transition-transform transform hover:-translate-y-1 flex flex-col justify-center">
                        <h3 class="text-sm font-medium text-gray-400 mb-2 uppercase tracking-wider">HTTP Method</h3>
                        <p class="text-3xl font-bold text-blue-600">POST</p>
                    </div>
                    <!-- API URL -->
                    <div class="bg-white border border-gray-200 rounded-xl p-6 text-center transition-transform transform hover:-translate-y-1">
                        <h3 class="text-sm font-medium text-gray-400 mb-2 uppercase tracking-wider">API URL</h3>
                        <p class="font-bold text-gray-800 whitespace-nowrap mt-4 text-xs sm:text-sm lg:text-base">{{site['protocol']}}://{{site['domain']}}/api/v2</p>
                    </div>
                    <!-- API Key -->
                    <div class="bg-white border border-gray-200 rounded-xl p-6 text-center transition-transform transform hover:-translate-y-1">
                        <h3 class="text-sm font-medium text-gray-400 mb-2 uppercase tracking-wider">API Key</h3>
                        <p class="text-md text-gray-600 mt-4">Get an API key on the <a href="{{site['protocol']}}://{{site['domain']}}/account" class="text-blue-600 font-semibold hover:underline">Account</a> page</p>
                    </div>
                    <!-- Response Format -->
                    <div class="bg-white border border-gray-200 rounded-xl p-6 text-center transition-transform transform hover:-translate-y-1 flex flex-col justify-center">
                        <h3 class="text-sm font-medium text-gray-400 mb-2 uppercase tracking-wider">Response format</h3>
                        <p class="text-3xl font-bold text-blue-600">JSON</p>
                    </div>
                </div>
        
   {% for method,methodDetails in methods %}
                <!-- {{methodDetails['title']}} Card -->
                <div class="bg-white border border-gray-200 rounded-xl w-full mx-auto mb-8 overflow-hidden">
                    <div class="px-6 py-4 bg-gray-50 border-b border-gray-200">
                        <h2 class="text-xl font-bold text-gray-800">{{methodDetails['title']}}</h2>
                    </div>
                    <div class="p-6 md:p-8">
                        <div class="grid grid-cols-1 lg:grid-cols-5 gap-8">
                            <div class="lg:col-span-2">
                                <h3 class="text-lg font-semibold text-gray-700 mb-4">Parameters</h3>
                                
                                {% if 'add' == method %}
                                    {% if methodDetails['types']|length > 1 %}
                                    <form class="mb-4">
                                        <div class="form-group">
                                            <select class="block w-full bg-white border border-gray-300 hover:border-gray-400 px-4 py-2 pr-8 rounded-lg shadow-sm leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" id="service_type">
                                                {% for type,label in methodDetails['types'] %}
                                                <option value="{{type}}">{{label}}</option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                    </form>
                                    {% endif %}
                                    
                                    {% for type,parameters in methodDetails['parameters'] %}
                                    <div id="type_{{type}}" style="display:none;" class="api-params-table">
                                        <div class="overflow-hidden rounded-lg border border-gray-200">
                                            <table class="min-w-full divide-y divide-gray-200">
                                                <thead class="bg-gray-100">
                                                    <tr class="text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                                        <th class="px-4 py-3">Parameter</th>
                                                        <th class="px-4 py-3">Description</th>
                                                    </tr>
                                                </thead>
                                                <tbody class="divide-y divide-gray-200">
                                                    {% for parameter,label in parameters %}
                                                    <tr>
                                                        <td class="px-4 py-3 text-sm font-mono text-gray-800">{{parameter}}</td>
                                                        <td class="px-4 py-3 text-sm text-gray-600">{{label}}</td>
                                                    </tr>
                                                    {% endfor %}
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                    {% endfor %}
                                    
                                {% else %}
                                    <div class="overflow-hidden rounded-lg border border-gray-200">
                                        <table class="min-w-full divide-y divide-gray-200">
                                            <thead class="bg-gray-100">
                                                <tr class="text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                                    <th class="px-4 py-3">Parameter</th>
                                                    <th class="px-4 py-3">Description</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-gray-200">
                                                {% for parameter,label in methodDetails['parameters'] %}
                                                <tr>
                                                    <td class="px-4 py-3 text-sm font-mono text-gray-800">{{parameter}}</td>
                                                    <td class="px-4 py-3 text-sm text-gray-600">{{label}}</td>
                                                </tr>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>
                                {% endif %}
                            </div>
                            <div class="lg:col-span-3">
                                <h3 class="text-lg font-semibold text-gray-700 mb-4">Example Response</h3>
                                <div class="bg-gray-900 p-4 rounded-lg text-sm font-mono overflow-x-auto">
<pre class="text-white"><code>{{methodDetails['examples']}}</code></pre>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                {% endfor %}
        
                <div class="mt-4 text-center">
                    <a href="/example.txt" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-lg transition-colors duration-300" target="_blank">View PHP Example Code</a>
                </div>
        
                <script>
                    document.addEventListener('DOMContentLoaded', function() {
                        const serviceTypeSelect = document.getElementById('service_type');
                        const typeDivs = document.querySelectorAll('.api-params-table');
        
                        function toggleTypeDivs() {
                            const selectedValue = serviceTypeSelect.value;
                            typeDivs.forEach(div => {
                                div.style.display = (div.id === 'type_' + selectedValue) ? 'block' : 'none';
                            });
                        }
        
                        serviceTypeSelect.addEventListener('change', toggleTypeDivs);
                        
                        // Set initial state
                        if(serviceTypeSelect.options.length > 0) {
                             const initialDiv = document.getElementById('type_' + serviceTypeSelect.value);
                             if(initialDiv) initialDiv.style.display = 'block';
                        }
                    });
                </script>
         </div>
         </div>
