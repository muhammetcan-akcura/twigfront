{% if site['resetPassword'] %}
<style>
    body, html {
        background: radial-gradient(ellipse at top right, #ffffff 0%, #eff6ff 50%, #bfdbfe 100%) !important;
        background-attachment: fixed !important;
        color: #1E293B;
        overflow-x: hidden;
    }
    .font-outfit { font-family: 'Outfit', sans-serif; }
    
    /* Hide layout elements */
    header, footer, nav, aside, #top-bar, .site-footer, .site-header { display: none !important; }
    #main-content { margin-left: 0 !important; width: 100% !important; background: transparent !important; }
</style>

<!-- Abstract Background Wave Lines (SVG) -->
<svg class="absolute top-0 left-0 w-full h-full z-0 pointer-events-none hidden md:block opacity-60" viewBox="0 0 1440 800" fill="none" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M-100 600 C 300 800, 600 200, 1500 500" stroke="#ffffff" stroke-width="3" opacity="0.4"/>
    <path d="M-100 500 C 400 400, 800 900, 1500 300" stroke="#eff6ff" stroke-width="8" opacity="0.6"/>
    <path d="M-100 200 C 400 -50, 900 600, 1500 200" stroke="#bfdbfe" stroke-width="2" opacity="0.7"/>
    <path d="M-100 700 C 500 500, 1000 900, 1500 600" stroke="#60a5fa" stroke-width="4" opacity="0.3"/>
    
    <!-- Glow Dots -->
    <circle cx="200" cy="700" r="6" fill="#ffffff" opacity="0.6"/>
    <circle cx="900" cy="150" r="4" fill="#60a5fa" opacity="0.5"/>
    <circle cx="1300" cy="650" r="8" fill="#eff6ff" opacity="0.8"/>
</svg>

<!-- Floating 3D Spheres & Blurred Elements -->
<div class="absolute top-20 right-10 w-64 h-64 bg-blue-400 rounded-full mix-blend-multiply filter blur-[100px] opacity-20 pointer-events-none"></div>
<div class="absolute bottom-20 left-10 w-72 h-72 bg-indigo-300 rounded-full mix-blend-multiply filter blur-[100px] opacity-20 pointer-events-none"></div>

<!-- Mini Header -->
<div class="absolute top-0 left-0 w-full px-6 py-5 sm:px-10 flex justify-between items-center z-40">
    <a href="/" class="flex items-center">
        {% if site['logo'] %}
            <img src="{{ site['logo'] }}" alt="{{ site['name'] }}" class="h-6 sm:h-7 object-contain">
        {% else %}
            <span class="font-bold text-xl font-outfit text-blue-600">{{ site['name'] }}</span>
        {% endif %}
    </a>
    <a href="/signin" class="flex items-center gap-2 text-slate-500 hover:text-blue-600 font-medium text-sm px-4 py-2 rounded-full hover:bg-blue-50 border border-slate-200 hover:border-blue-100 bg-white/50 backdrop-blur-sm transition-colors">
        <i class="ri-login-box-line text-lg"></i>
        <span class="hidden sm:inline">Sign In</span>
    </a>
</div>

<div class="min-h-screen flex flex-col items-center justify-center py-12 px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-md w-full mt-4">
        <!-- Main Card -->
        <div class="bg-white border border-slate-200/60 rounded-3xl shadow-xl p-8 sm:p-10 relative overflow-hidden">
            <form {% if site['rtl'] %}dir="rtl"{% endif %} method="post" action="">
                
                <!-- Icon Header -->
                <div class="flex justify-center mb-8">
                    <div class="w-20 h-20 bg-blue-50 border border-blue-100 rounded-full flex items-center justify-center">
                        <i class="ri-lock-password-line text-4xl text-blue-600"></i>
                    </div>
                </div>

                <div class="text-center mb-8">
                    <h3 class="text-2xl sm:text-3xl font-bold font-outfit text-slate-800 mb-2">{{ lang('resetpassword.title') }}</h3>
                    <p class="text-slate-500 text-sm">Enter your email address to reset your password.</p>
                </div>

                {% if error %}
                <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl mb-6 text-sm font-medium flex items-center gap-3 {% if site['rtl'] %} text-right {% endif %}">
                    <i class="ri-error-warning-fill text-lg"></i>
                    <span class="flex-grow text-left">{{ errorMessage }}</span>
                    <button type="button" class="text-red-500 hover:text-red-700 transition-colors" onclick="this.parentElement.style.display='none'">
                        <i class="ri-close-line text-lg"></i>
                    </button>
                </div>
                {% endif %}
                
                {% if success %}
                <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 px-4 py-3 rounded-xl mb-6 text-sm font-medium flex items-center gap-3 {% if site['rtl'] %} text-right {% endif %}">
                    <i class="ri-checkbox-circle-fill text-lg"></i>
                    <span class="flex-grow text-left">{{ successText }}</span>
                    <button type="button" class="text-emerald-500 hover:text-emerald-700 transition-colors" onclick="this.parentElement.style.display='none'">
                        <i class="ri-close-line text-lg"></i>
                    </button>
                </div>
                {% endif %}

                <div class="mb-6">
                    <label for="email" class="block text-xs font-semibold text-slate-700 mb-1.5 uppercase tracking-wider">{{ lang('resetpassword.email') }}</label>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
                            <i class="ri-mail-line"></i>
                        </div>
                        <input type="email" class="w-full pl-10 pr-4 py-3 bg-white border border-slate-200 text-slate-900 text-sm rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all" id="email" name="ResetPasswordForm[email]" required>
                    </div>
                </div>

                {% if site['captcha'] %}
                    <div class="mb-6 flex justify-center">
                        {{ captchaCode }}
                    </div>
                {% endif %}

                <button type="submit" class="w-full flex items-center justify-center gap-2 text-white bg-blue-600 hover:bg-blue-700 font-semibold rounded-xl text-sm px-8 py-3.5 transition-colors outline-none">
                    {{ lang('resetpassword.button.send') }}
                    <i class="ri-arrow-right-line"></i>
                </button>
                <input type="hidden" name="_csrf" value="{{csrftoken}}">
            </form>
        </div>
    </div>
</div>
{% endif %}
{% if site['captcha'] %}
<script src='https://www.google.com/recaptcha/api.js?hl={{ site['iso_lang_code'] }}'></script>
{% endif %}
