{% if site['resetPassword'] %}

<section class="page-header-ui">
    <div class="container mx-auto px-4 text-center pb-10">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-800 tracking-tight">Reset Password</h1>
        <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">Password reseting</p>
    </div>
</section>

<div class="container mx-auto px-4">
<div class="flex justify-center">
<div class="w-full md:w-8/12 md:mx-auto">
<div class="bg-white rounded-lg shadow p-6">
<form {% if site['rtl'] %}dir="rtl"{% endif %} method="post" action="">
<h3 class="text-xl font-semibold mb-4">{{ lang('resetpassword.title') }}</h3>
{% if error %}
<div class="relative mb-4 rounded border-l-4 border-red-500 bg-red-50 p-4 text-red-700 {% if site['rtl'] %} text-right {% endif %}">
<button type="button" class="absolute top-2 right-2 text-red-700 hover:text-red-900 focus:outline-none" data-dismiss="alert">&times;</button>
{{ errorMessage }}
</div>
{% endif %}
{% if success %}
<div class="relative mb-4 rounded border-l-4 border-green-500 bg-green-50 p-4 text-green-700 {% if site['rtl'] %} text-right {% endif %}">
<button type="button" class="absolute top-2 right-2 text-green-700 hover:text-green-900 focus:outline-none" data-dismiss="alert">&times;</button>
{{ successText }}
</div>
{% endif %}
<div class="mb-4">
<label for="email" class="block text-sm font-medium text-gray-700 mb-1">{{ lang('resetpassword.email') }}</label>
<input type="email" class="block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" id="email" name="ResetPasswordForm[email]">
</div>
{% if site['captcha'] %}
{{ captchaCode }}
{% endif %}
<button type="submit" class="inline-flex items-center rounded-md bg-blue-600 px-4 py-2 text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">{{ lang('resetpassword.button.send') }}</button>
<input type="hidden" name="_csrf" value="{{csrftoken}}">
</form>
</div>
</div>
</div>
</div>
{% endif %}
{% if site['captcha'] %}
<script src='https://www.google.com/recaptcha/api.js?hl={{ site['iso_lang_code'] }}'></script>
{% endif %}


