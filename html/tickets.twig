<script>
// Nice Select Component
class NiceSelect {
    constructor(element) {
        this.element = element;
        this.options = Array.from(element.options);
        this.selectedIndex = element.selectedIndex;
        this.placeholder = element.getAttribute('placeholder') || 'Select an option';
        this.init();
    }

    init() {
        // Create nice select wrapper
        this.wrapper = document.createElement('div');
        this.wrapper.className = 'nice-select';
        
        // Create current display
        this.current = document.createElement('div');
        this.current.className = 'current';
        this.current.textContent = this.getCurrentText();
        
        // Create arrow
        this.arrow = document.createElement('div');
        this.arrow.className = 'arrow';
        
        // Create options list
        this.list = document.createElement('div');
        this.list.className = 'list';
        
        this.options.forEach((option, index) => {
  // HIDDEN veya (value==='' ve disabled) ise listeye hiç ekleme
  if (option.hidden || (option.value === '' && option.disabled)) return;

  const optionElement = document.createElement('div');
  optionElement.className = 'option';
  optionElement.textContent = option.textContent;
  optionElement.dataset.value = option.value;
  optionElement.dataset.index = index;

  if (option.disabled) optionElement.classList.add('disabled');
  if (index === this.selectedIndex) optionElement.classList.add('selected');

  optionElement.addEventListener('click', () => {
    if (!option.disabled) this.select(index);
  });

  this.list.appendChild(optionElement);
});
        
        // Assemble the component
        this.current.appendChild(this.arrow);
        this.wrapper.appendChild(this.current);
        this.wrapper.appendChild(this.list);
        
        // Add event listeners
        this.wrapper.addEventListener('click', (e) => {
            if (e.target === this.wrapper || e.target === this.current || e.target === this.arrow) {
                this.toggle();
            }
        });
        
        // Close on outside click
        document.addEventListener('click', (e) => {
            if (!this.wrapper.contains(e.target)) {
                this.close();
            }
        });
        
        // Keyboard navigation
        this.wrapper.addEventListener('keydown', (e) => {
            switch(e.key) {
                case 'Enter':
                case ' ':
                    e.preventDefault();
                    this.toggle();
                    break;
                case 'Escape':
                    this.close();
                    break;
                case 'ArrowDown':
                    e.preventDefault();
                    this.next();
                    break;
                case 'ArrowUp':
                    e.preventDefault();
                    this.previous();
                    break;
            }
        });
        
        // Replace original select
        this.element.style.display = 'none';
        this.element.parentNode.insertBefore(this.wrapper, this.element);
        
        // Make wrapper focusable
        this.wrapper.tabIndex = 0;
    }
    
    getCurrentText() {
        if (this.selectedIndex >= 0 && this.selectedIndex < this.options.length) {
            return this.options[this.selectedIndex].textContent;
        }
        return this.placeholder;
    }
    
    toggle() {
        if (this.wrapper.classList.contains('open')) {
            this.close();
        } else {
            this.open();
        }
    }
    
    open() {
        this.wrapper.classList.add('open');
        this.wrapper.focus();
    }
    
    close() {
        this.wrapper.classList.remove('open');
    }
    
    select(index) {
        if (index >= 0 && index < this.options.length) {
            this.selectedIndex = index;
            this.current.textContent = this.options[index].textContent;
            this.current.appendChild(this.arrow);
            
            // Update original select
            this.element.selectedIndex = index;
            this.element.value = this.options[index].value;
            
            // Trigger change event
            const event = new Event('change', { bubbles: true });
            this.element.dispatchEvent(event);
            
            // Update visual selection
            this.list.querySelectorAll('.option').forEach((option, i) => {
                option.classList.toggle('selected', i === index);
            });
            
            this.close();
        }
    }
    
    next() {
        let nextIndex = this.selectedIndex + 1;
        while (nextIndex < this.options.length && this.options[nextIndex].disabled) {
            nextIndex++;
        }
        if (nextIndex < this.options.length) {
            this.select(nextIndex);
        }
    }
    
    previous() {
        let prevIndex = this.selectedIndex - 1;
        while (prevIndex >= 0 && this.options[prevIndex].disabled) {
            prevIndex--;
        }
        if (prevIndex >= 0) {
            this.select(prevIndex);
        }
    }
}

// Initialize nice selects
document.addEventListener('DOMContentLoaded', function() {
    // Initialize all select elements as nice selects
    const selects = document.querySelectorAll('select');
    selects.forEach(select => {
        new NiceSelect(select);
    });
});

// Issue type selection
document.querySelectorAll('.issue-type-btn').forEach(btn => {
    btn.addEventListener('click', function() {
        // Monochrome: styling handled by .issue-type-btn / .active in CSS
        document.querySelectorAll('.issue-type-btn').forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        const issueType = this.querySelector('.text-sm.font-semibold').textContent.trim();

        updateFormContent(issueType);
    });
});

// Function to update form content based on selected issue type
function updateFormContent(issueType) {
    const requestTypeSelect = document.getElementById('requestType');
    const orderIdField = document.getElementById('orderIdField');
    const paymentFields = document.getElementById('paymentFields');
    const cooperationFields = document.getElementById('cooperationFields');
    
    // Clear previous options
   // Clear previous options
requestTypeSelect.innerHTML = '';

// SADECE seçim yoksa placeholder ekle (listede görünmesin)
const needPlaceholder = !requestTypeSelect.value;
if (needPlaceholder) {
  const placeholder = document.createElement('option');
  placeholder.value = '';
  placeholder.textContent = 'Choose an issue type';
  placeholder.disabled = true;  // seçilemez
  placeholder.hidden = true;    // listede görünmez
  placeholder.selected = true;  // başlangıç değeri
  requestTypeSelect.appendChild(placeholder);
}

    
    // Hide all dynamic fields initially
    orderIdField.style.display = 'none';
    paymentFields.style.display = 'none';
    cooperationFields.style.display = 'none';
    
    // Remove existing nice select if it exists
    const existingNiceSelect = requestTypeSelect.parentNode.querySelector('.nice-select');
    if (existingNiceSelect) {
        existingNiceSelect.remove();
        requestTypeSelect.style.display = 'block';
    }
    
    // Update form based on selected issue type
    switch(issueType) {
        case 'Orders':
            // Add order-specific options
            const orderOptions = [
                { value: 'refill', text: 'Refill' },
                { value: 'cancel-partial', text: 'Cancel/Partial' },
                { value: 'speed-up', text: 'Speed up' },
                { value: 'mark-completed-without-done', text: 'Mark completed without done' },
                { value: 'stuck', text: 'Stuck' },
                { value: 'not-started', text: 'Not started' }
            ];
            orderOptions.forEach(option => {
                const optionElement = document.createElement('option');
                optionElement.value = option.value;
                optionElement.textContent = option.text;
                requestTypeSelect.appendChild(optionElement);
            });
            orderIdField.style.display = 'block';
            break;
            
        case 'Payment':
            // Add payment-specific options
            const paymentOptions = [
                { value: 'cant-add-funds', text: 'I can’t add funds' },
                { value: 'added-funds-but-not-updated', text: 'Added funds but not updated' },
                { value: 'payment-failed', text: 'Payment failed' },
                { value: 'underpaid-or-overpaid', text: 'Underpaid or overpaid' },
                { value: 'billing-issue', text: 'Billing issue' }
            ];
            paymentOptions.forEach(option => {
                const optionElement = document.createElement('option');
                optionElement.value = option.value;
                optionElement.textContent = option.text;
                requestTypeSelect.appendChild(optionElement);
            });
            paymentFields.style.display = 'block';
            break;
            
        case 'General':
            // Add general options
            const generalOptions = [
                { value: 'general-question', text: 'General question' },
                { value: 'technical-support', text: 'Technical support' },
                { value: 'account-issue', text: 'Account issue' },
                { value: 'feature-request', text: 'Feature request' },
                { value: 'bug-report', text: 'Bug report' }
            ];
            generalOptions.forEach(option => {
                const optionElement = document.createElement('option');
                optionElement.value = option.value;
                optionElement.textContent = option.text;
                requestTypeSelect.appendChild(optionElement);
            });
            break;
            
        case 'Cooperation':
            // Add cooperation options
            const cooperationOptions = [
                { value: 'partnership', text: 'Partnership inquiry' },
                { value: 'reseller-program', text: 'Reseller program' },
                { value: 'wholesale', text: 'Wholesale inquiry' },
                { value: 'api-integration', text: 'API integration' },
                { value: 'business-proposal', text: 'Business proposal' }
            ];
            cooperationOptions.forEach(option => {
                const optionElement = document.createElement('option');
                optionElement.value = option.value;
                optionElement.textContent = option.text;
                requestTypeSelect.appendChild(optionElement);
            });
            cooperationFields.style.display = 'block';
            break;
    }
    
    // Reinitialize nice select for the updated select element
    new NiceSelect(requestTypeSelect);
}

// Initialize form with default selection (Orders)
document.addEventListener('DOMContentLoaded', function() {
    updateFormContent('Orders');
});

// Priority selection
document.querySelectorAll('.priority-btn').forEach(btn => {
    btn.addEventListener('click', function() {
        // Monochrome: styling handled by .priority-btn / .active in CSS
        document.querySelectorAll('.priority-btn').forEach(b => b.classList.remove('active'));
        this.classList.add('active');
    });
});



    // Real-time update hidden inputs
    function updateHiddenInputs() {
        // Get selected priority
        const selectedPriority = document.querySelector('.priority-btn.active');
        let priority = 'LOW';
        if (selectedPriority) {
            priority = selectedPriority.textContent.trim().toUpperCase();
        }
        
        // Get selected issue type
        const selectedIssueType = document.querySelector('.issue-type-btn.active');
        let issueTypeText = 'Orders';
        if (selectedIssueType) {
            issueTypeText = selectedIssueType.querySelector('.text-sm.font-semibold').textContent.trim();
        }
        
        // Get selected request type
        const requestTypeSelect = document.getElementById('requestType');
        const selectedRequestTypeOption = requestTypeSelect.options[requestTypeSelect.selectedIndex];
        const requestTypeText = selectedRequestTypeOption ? selectedRequestTypeOption.textContent : '';
        
        // Build subject: "PRIORITY - Issue Type - Request Type"
        let subject = priority + ' - ' + issueTypeText;
        if (requestTypeText && requestTypeText !== 'Choose an issue type') {
            subject += ' - ' + requestTypeText;
        }
        
        // Build message content based on issue type
        let messageContent = '';
        
        // Add selected issue type to message
        if (requestTypeText && requestTypeText !== 'Choose an issue type') {
            messageContent += 'Issue Type: ' + requestTypeText + '\n';
        }
        
        if (issueTypeText === 'Orders') {
            const orderId = document.getElementById('orderId').value;
            if (orderId) {
                messageContent += 'Order ID: ' + orderId + '\n';
            }
        } else if (issueTypeText === 'Payment') {
            const transactionId = document.getElementById('transactionId').value;
            const paymentMethodSelect = document.getElementById('paymentMethod');
            const selectedPaymentOption = paymentMethodSelect.options[paymentMethodSelect.selectedIndex];
            const paymentMethodText = selectedPaymentOption ? selectedPaymentOption.textContent : '';
            
            if (transactionId) {
                messageContent += 'Transaction ID: ' + transactionId + '\n';
            }
            if (paymentMethodText && paymentMethodText !== 'Select payment method') {
                messageContent += 'Payment Method: ' + paymentMethodText + '\n';
            }
        } else if (issueTypeText === 'Cooperation') {
            const companyName = document.getElementById('companyName').value;
            const website = document.getElementById('website').value;
            const contactPerson = document.getElementById('contactPerson').value;
            const phone = document.getElementById('phone').value;
            
            if (companyName) {
                messageContent += 'Company Name: ' + companyName + '\n';
            }
            if (website) {
                messageContent += 'Website: ' + website + '\n';
            }
            if (contactPerson) {
                messageContent += 'Contact Person: ' + contactPerson + '\n';
            }
            if (phone) {
                messageContent += 'Phone Number: ' + phone + '\n';
            }
        }
        
        // Add main message
        const mainMessage = document.getElementById('message').value;
        if (messageContent) {
            messageContent += '\n' + mainMessage;
        } else {
            messageContent = mainMessage;
        }
        
        // Update hidden inputs
        document.getElementById('final-subject').value = subject;
        document.getElementById('final-message').value = messageContent;
    }
    
    // Form validation before submit
    document.getElementById('ticketsend').addEventListener('submit', function(e) {
        const message = document.getElementById('message').value.trim();
        const requestTypeSelect = document.getElementById('requestType');
        const selectedRequestType = requestTypeSelect.value;
        
        // Check if message is empty
        if (!message) {
            e.preventDefault();
            showValidationError('Please enter a message describing your issue.');
            return;
        }
        
        // Check if request type is selected
        if (!selectedRequestType || selectedRequestType === '') {
            e.preventDefault();
            showValidationError('Please select an issue type from the dropdown.');
            return;
        }
        
        // Update hidden inputs one final time before submit
        updateHiddenInputs();
    });
    
    // Add event listeners for real-time updates
    document.addEventListener('DOMContentLoaded', function() {
        // Update on form changes
        const form = document.getElementById('ticketsend');
        if (form) {
            form.addEventListener('input', updateHiddenInputs);
            form.addEventListener('change', updateHiddenInputs);
        }
        
        // Update on priority button clicks
        document.querySelectorAll('.priority-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                setTimeout(updateHiddenInputs, 100); // Small delay to ensure UI is updated
            });
        });
        
        // Update on issue type button clicks
        document.querySelectorAll('.issue-type-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                setTimeout(updateHiddenInputs, 100); // Small delay to ensure UI is updated
            });
        });
        
        // Initial update
        setTimeout(updateHiddenInputs, 500);
    });

    // Function to show validation errors as div with Tailwind CSS
    function showValidationError(message) {
        // Create or update error alert with Tailwind CSS
        let errorAlert = document.querySelector('#error-alert');
        if (!errorAlert) {
            errorAlert = document.createElement('div');
            errorAlert.id = 'error-alert';
            errorAlert.className = 'mb-6 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg relative';
            errorAlert.innerHTML = `
                <div class="flex items-center">
                    <svg class="w-5 h-5 mr-2 text-red-600" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                    </svg>
                    <span class="error-text font-medium"></span>
                    <button type="button" class="ml-auto text-red-500 hover:text-red-700" onclick="this.parentElement.parentElement.style.display='none'">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
