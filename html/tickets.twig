}

/* Focus styles */
.nice-select:focus-within {
    outline: none;
    border-color: #3b82f6;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
}

/* Animation for options */
.nice-select .option {
    transform: translateX(-10px);
