        function switchToList() {
            // Update tab styles
            listTab.className = 'tab-btn active flex items-center justify-center gap-[10px] py-[12px] px-[14px] rounded-full font-medium whitespace-nowrap text-[15px] leading-[160%] tracking-[-0.3px] !text-white border border-white/15 btn-custom-active shadow-[0px_0px_3px_0px_#0139ff,0px_0px_0px_1.182px_#0139ff] cursor-pointer';
            createTab.className = 'tab-btn flex items-center justify-center gap-[10px] py-[12px] px-[14px] rounded-full font-medium whitespace-nowrap text-[15px] leading-[160%] tracking-[-0.3px] text-gray-600 hover:bg-gray-200 hover:text-gray-800 cursor-pointer';
            
            // Show/hide content
            listContent.classList.remove('hidden');
            createContent.classList.add('hidden');
        }

        // Add event listeners
        createTab.addEventListener('click', function(e) {
            e.preventDefault();
            switchToCreate();
        });

        listTab.addEventListener('click', function(e) {
            e.preventDefault();
            switchToList();
        });
    });

    // Real-time update hidden inputs
    function updateHiddenInputs() {
        // Get selected priority
        const selectedPriority = document.querySelector('.priority-btn.active');
        let priority = 'LOW';
        if (selectedPriority) {
            priority = selectedPriority.textContent.trim().toUpperCase();
        }
        
        // Get selected issue type
        const selectedIssueType = document.querySelector('.issue-type-btn.active');
        let issueTypeText = 'Orders';
        if (selectedIssueType) {
            issueTypeText = selectedIssueType.querySelector('.text-sm.font-semibold').textContent.trim();
        }
        
        // Get selected request type
        const requestTypeSelect = document.getElementById('requestType');
        const selectedRequestTypeOption = requestTypeSelect.options[requestTypeSelect.selectedIndex];
        const requestTypeText = selectedRequestTypeOption ? selectedRequestTypeOption.textContent : '';
        
        // Build subject: "PRIORITY - Issue Type - Request Type"
        let subject = priority + ' - ' + issueTypeText;
        if (requestTypeText && requestTypeText !== 'Choose an issue type') {
            subject += ' - ' + requestTypeText;
        }
        
        // Build message content based on issue type
        let messageContent = '';
        
        // Add selected issue type to message
        if (requestTypeText && requestTypeText !== 'Choose an issue type') {
            messageContent += 'Issue Type: ' + requestTypeText + '\n';
        }
        
        if (issueTypeText === 'Orders') {
            const orderId = document.getElementById('orderId').value;
            if (orderId) {
                messageContent += 'Order ID: ' + orderId + '\n';
            }
        } else if (issueTypeText === 'Payment') {
            const transactionId = document.getElementById('transactionId').value;
            const paymentMethodSelect = document.getElementById('paymentMethod');
            const selectedPaymentOption = paymentMethodSelect.options[paymentMethodSelect.selectedIndex];
            const paymentMethodText = selectedPaymentOption ? selectedPaymentOption.textContent : '';
            
            if (transactionId) {
                messageContent += 'Transaction ID: ' + transactionId + '\n';
            }
            if (paymentMethodText && paymentMethodText !== 'Select payment method') {
                messageContent += 'Payment Method: ' + paymentMethodText + '\n';
            }
        } else if (issueTypeText === 'Cooperation') {
            const companyName = document.getElementById('companyName').value;
            const website = document.getElementById('website').value;
            const contactPerson = document.getElementById('contactPerson').value;
            const phone = document.getElementById('phone').value;
            
            if (companyName) {
                messageContent += 'Company Name: ' + companyName + '\n';
            }
            if (website) {
                messageContent += 'Website: ' + website + '\n';
            }
            if (contactPerson) {
                messageContent += 'Contact Person: ' + contactPerson + '\n';
            }
            if (phone) {
                messageContent += 'Phone Number: ' + phone + '\n';
            }
        }
        
        // Add main message
        const mainMessage = document.getElementById('message').value;
        if (messageContent) {
            messageContent += '\n' + mainMessage;
        } else {
            messageContent = mainMessage;
        }
        
        // Update hidden inputs
        document.getElementById('final-subject').value = subject;
        document.getElementById('final-message').value = messageContent;
    }
    
    // Form validation before submit
    document.getElementById('ticketsend').addEventListener('submit', function(e) {
        const message = document.getElementById('message').value.trim();
        const requestTypeSelect = document.getElementById('requestType');
        const selectedRequestType = requestTypeSelect.value;
        
        // Check if message is empty
        if (!message) {
            e.preventDefault();
            showValidationError('Please enter a message describing your issue.');
            return;
        }
        
        // Check if request type is selected
        if (!selectedRequestType || selectedRequestType === '') {
            e.preventDefault();
            showValidationError('Please select an issue type from the dropdown.');
            return;
        }
        
        // Update hidden inputs one final time before submit
        updateHiddenInputs();
    });
    
    // Add event listeners for real-time updates
    document.addEventListener('DOMContentLoaded', function() {
        // Update on form changes
        const form = document.getElementById('ticketsend');
        if (form) {
            form.addEventListener('input', updateHiddenInputs);
            form.addEventListener('change', updateHiddenInputs);
        }
        
        // Update on priority button clicks
        document.querySelectorAll('.priority-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                setTimeout(updateHiddenInputs, 100); // Small delay to ensure UI is updated
            });
        });
        
        // Update on issue type button clicks
        document.querySelectorAll('.issue-type-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                setTimeout(updateHiddenInputs, 100); // Small delay to ensure UI is updated
            });
        });
        
        // Initial update
        setTimeout(updateHiddenInputs, 500);
    });

    // Function to show validation errors as div with Tailwind CSS
    function showValidationError(message) {
        // Create or update error alert with Tailwind CSS
        let errorAlert = document.querySelector('#error-alert');
        if (!errorAlert) {
            errorAlert = document.createElement('div');
            errorAlert.id = 'error-alert';
            errorAlert.className = 'mb-6 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg relative';
            errorAlert.innerHTML = `
                <div class="flex items-center">
                    <svg class="w-5 h-5 mr-2 text-red-600" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                    </svg>
                    <span class="error-text font-medium"></span>
                    <button type="button" class="ml-auto text-red-500 hover:text-red-700" onclick="this.parentElement.parentElement.style.display='none'">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                        </svg>
                    </button>
                </div>
            `;
            const form = document.getElementById('ticketsend');
            if (form) {
                form.insertBefore(errorAlert, form.firstChild);
            }
        }
        
        const errorText = errorAlert.querySelector('.error-text');
        if (errorText) {
            errorText.textContent = message;
        }
        errorAlert.style.display = 'block';
        errorAlert.scrollIntoView({ behavior: 'smooth' });
    }
</script>
