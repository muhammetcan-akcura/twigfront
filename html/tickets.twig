// Function to update form content based on selected issue type
function updateFormContent(issueType) {
    const requestTypeSelect = document.getElementById('requestType');
    const orderIdField = document.getElementById('orderIdField');
    const paymentFields = document.getElementById('paymentFields');
    const cooperationFields = document.getElementById('cooperationFields');
    
    // Clear previous options
   // Clear previous options
requestTypeSelect.innerHTML = '';

// SADECE seçim yoksa placeholder ekle (listede görünmesin)
const needPlaceholder = !requestTypeSelect.value;
if (needPlaceholder) {
  const placeholder = document.createElement('option');
  placeholder.value = '';
  placeholder.textContent = 'Choose an issue type';
  placeholder.disabled = true;  // seçilemez
  placeholder.hidden = true;    // listede görünmez
  placeholder.selected = true;  // başlangıç değeri
  requestTypeSelect.appendChild(placeholder);
}

    
    // Hide all dynamic fields initially
    orderIdField.style.display = 'none';
    paymentFields.style.display = 'none';
    cooperationFields.style.display = 'none';
    
    // Remove existing nice select if it exists
    const existingNiceSelect = requestTypeSelect.parentNode.querySelector('.nice-select');
    if (existingNiceSelect) {
        existingNiceSelect.remove();
        requestTypeSelect.style.display = 'block';
    }
    
    // Update form based on selected issue type
    switch(issueType) {
        case 'Orders':
            // Add order-specific options
            const orderOptions = [
                { value: 'refill', text: 'Refill' },
                { value: 'cancel-partial', text: 'Cancel/Partial' },
                { value: 'speed-up', text: 'Speed up' },
                { value: 'mark-completed-without-done', text: 'Mark completed without done' },
                { value: 'stuck', text: 'Stuck' },
                { value: 'not-started', text: 'Not started' }
            ];
            orderOptions.forEach(option => {
                const optionElement = document.createElement('option');
                optionElement.value = option.value;
                optionElement.textContent = option.text;
                requestTypeSelect.appendChild(optionElement);
            });
            orderIdField.style.display = 'block';
            break;
            
        case 'Payment':
            // Add payment-specific options
            const paymentOptions = [
                { value: 'cant-add-funds', text: 'I can’t add funds' },
                { value: 'added-funds-but-not-updated', text: 'Added funds but not updated' },
                { value: 'payment-failed', text: 'Payment failed' },
                { value: 'underpaid-or-overpaid', text: 'Underpaid or overpaid' },
                { value: 'billing-issue', text: 'Billing issue' }
            ];
            paymentOptions.forEach(option => {
                const optionElement = document.createElement('option');
                optionElement.value = option.value;
                optionElement.textContent = option.text;
                requestTypeSelect.appendChild(optionElement);
            });
            paymentFields.style.display = 'block';
            break;
            
        case 'General':
            // Add general options
            const generalOptions = [
                { value: 'general-question', text: 'General question' },
                { value: 'technical-support', text: 'Technical support' },
                { value: 'account-issue', text: 'Account issue' },
                { value: 'feature-request', text: 'Feature request' },
                { value: 'bug-report', text: 'Bug report' }
            ];
            generalOptions.forEach(option => {
                const optionElement = document.createElement('option');
                optionElement.value = option.value;
                optionElement.textContent = option.text;
                requestTypeSelect.appendChild(optionElement);
            });
            break;
            
        case 'Cooperation':
            // Add cooperation options
            const cooperationOptions = [
                { value: 'partnership', text: 'Partnership inquiry' },
                { value: 'reseller-program', text: 'Reseller program' },
                { value: 'wholesale', text: 'Wholesale inquiry' },
                { value: 'api-integration', text: 'API integration' },
                { value: 'business-proposal', text: 'Business proposal' }
            ];
            cooperationOptions.forEach(option => {
                const optionElement = document.createElement('option');
                optionElement.value = option.value;
                optionElement.textContent = option.text;
                requestTypeSelect.appendChild(optionElement);
            });
            cooperationFields.style.display = 'block';
            break;
    }
    
    // Reinitialize nice select for the updated select element
    new NiceSelect(requestTypeSelect);
}

