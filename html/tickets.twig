<div class="tickets-page relative z-10 pb-16 md:pb-15 bg-white pt-6">
    <div class="container mx-auto px-4 relative z-10">
        
        <!-- Create Ticket (top) -->
        <div id="create-tab-content" class="max-w-[986px] mx-auto">
            
            <!-- Main Ticket Form Card -->
            <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
                <div class="border-b border-gray-200 px-5 py-3">
                    <h2 class="text-base font-semibold text-gray-800 flex items-center gap-2">
                        <i class="ri-customer-service-2-line tk-ink text-lg font-normal"></i>
                        Create Support Ticket
                    </h2>
                </div>
                
                <div class="p-5">
                    <form {% if site['rtl'] %}class="rtl-form"{% endif %} method="post" action="" id="ticketsend" class="space-y-4">
                        <div class="alert alert-dismissible alert-danger ticket-danger {% if site['rtl'] %} rtl-alert {% endif %}" style="display: none">
                            <button type="button" class="close">&times;</button>
                            <div></div>
                        </div>
                        
                        <!-- Hidden inputs for final subject and message -->
                        <input type="hidden" id="final-subject" name="TicketForm[subject]" value="">
                        <input type="hidden" id="final-message" name="TicketForm[message]" value="">
                        {% if additionalFieldsEnabled %}
                        <!-- Category Selection -->
                        <div>
                            <label for="ticket-category-field" class="block text-sm font-medium text-gray-700 mb-3">{{ lang('tickets.category') }}</label>
                            <select id="ticket-category-field" name="TicketForm[category]" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500/15 focus:border-blue-500 transition-colors text-sm font-normal min-h-[40px] leading-[1.5]">
                                {% for categoryField in additionalFields %}
                                  <option value="{{ categoryField.id }}">{{ categoryField.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div id="ticket-fields" data-ticket-fields="true"></div>
                        {% else %}
                        <!-- Issue Type Selection -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Select Issue Type</label>
                            <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
                                <button type="button" class="issue-type-btn active flex items-center gap-2.5 px-3 py-2.5 border rounded-lg transition-colors text-left group cursor-pointer min-w-0">
                                    <div class="tk-icon-circle w-8 h-8 shrink-0 rounded-full flex items-center justify-center">
                                        <i class="ri-shopping-cart-line text-base"></i>
                                    </div>
                                    <div class="min-w-0"><div class="text-sm font-semibold text-gray-700 leading-tight">Orders</div><div class="text-[11px] font-normal text-gray-500 leading-tight truncate">Problems with your orders</div></div>
                                </button>
                                <button type="button" class="issue-type-btn flex items-center gap-2.5 px-3 py-2.5 border rounded-lg transition-colors text-left group cursor-pointer min-w-0">
                                    <div class="tk-icon-circle w-8 h-8 shrink-0 rounded-full flex items-center justify-center">
                                        <i class="ri-bank-card-line text-base font-normal"></i>
                                    </div>
                                    <div class="min-w-0"><div class="text-sm font-semibold text-gray-700 leading-tight">Payment</div><div class="text-[11px] font-normal text-gray-500 leading-tight truncate">Billing and payment issues</div></div>
                                </button>
                                <button type="button" class="issue-type-btn flex items-center gap-2.5 px-3 py-2.5 border rounded-lg transition-colors text-left group cursor-pointer min-w-0">
                                    <div class="tk-icon-circle w-8 h-8 shrink-0 rounded-full flex items-center justify-center">
                                        <i class="ri-question-line text-base font-normal"></i>
                                    </div>
                                    <div class="min-w-0"><div class="text-sm font-semibold text-gray-700 leading-tight">General</div><div class="text-[11px] font-normal text-gray-500 leading-tight truncate">Other questions or concerns</div></div>
                                </button>
                                <button type="button" class="issue-type-btn flex items-center gap-2.5 px-3 py-2.5 border rounded-lg transition-colors text-left group cursor-pointer min-w-0">
                                    <div class="tk-icon-circle w-8 h-8 shrink-0 rounded-full flex items-center justify-center">
                                        <i class="ri-team-line text-base font-normal"></i>
                                    </div>
                                    <div class="min-w-0"><div class="text-sm font-semibold text-gray-700 leading-tight">Cooperation</div><div class="text-[11px] font-normal text-gray-500 leading-tight truncate">Cooperate with Smmexclusive</div></div>
                                </button>
                            </div>
                        </div>

                        <!-- Request Type + Order ID (side by side on desktop) -->
                        <div class="tk-req-row grid grid-cols-1 md:grid-cols-2 gap-4 items-start">
                        <div id="requestTypeContainer">
                            <label for="requestType" class="block text-sm font-semibold text-gray-700 mb-2 text-sm">Select issue type</label>
                            <select id="requestType" name="request_type_field" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500/15 focus:border-blue-500 transition-colors text-sm font-normal min-h-[40px] leading-[1.5]">
                               
                            </select>
                        </div>

                        <!-- Order ID (initially hidden, shown for Orders type) -->
                        <div id="orderIdField" style="display: none;">
                            <label for="orderId" class="block text-sm font-semibold text-gray-700 mb-2 text-sm">Order ID</label>
                            <input type="text" id="orderId" name="order_id_field" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500/15 focus:border-blue-500 transition-colors text-sm font-normal min-h-[40px] leading-[1.5] placeholder:text-gray-400 placeholder:font-normal" placeholder="Enter order ID">
                            <p class="text-xs text-gray-500 mt-1">For multiple orders, pls separate them with comma. (78565714,78565715)</p>
                        </div>
                        </div>

                        <!-- Dynamic Form Fields -->
                        <div id="dynamicFields">
                            <!-- Fields will be populated by JavaScript -->
                        </div>

                        <!-- Payment Fields (initially hidden) -->
                        <div id="paymentFields" style="display: none;">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label for="transactionId" class="block text-sm font-semibold text-gray-700 mb-2 text-sm">Transaction ID</label>
                                    <input type="text" id="transactionId" name="transaction_id_field" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500/15 focus:border-blue-500 transition-colors text-sm font-normal min-h-[40px] leading-[1.5] placeholder:text-gray-400 placeholder:font-normal" placeholder="Enter transaction ID">
                                </div>
                                <div>
                                    <label for="paymentMethod" class="block text-sm font-semibold text-gray-700 mb-2 text-sm">Payment Method</label>
                                    <select id="paymentMethod" name="payment_method_field" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500/15 focus:border-blue-500 transition-colors text-sm font-normal min-h-[40px] leading-[1.5]">
                                        <option value="credit-card">Credit Card</option>
                                        <option value="payeer">Payeer</option>
                                        <option value="cryptomus">Cryptomus</option>
                                        <option value="heleket">Heleket</option>
                                        <option value="payoneer">Payoneer</option>
                                        <option value="wise">Wise</option>
                                        <option value="binance">Binance</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Cooperation Fields (initially hidden) -->
                        <div id="cooperationFields" style="display: none;">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label for="companyName" class="block text-sm font-semibold text-gray-700 mb-2 text-sm">Company Name</label>
                                    <input type="text" id="companyName" name="company_name_field" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500/15 focus:border-blue-500 transition-colors text-sm font-normal min-h-[40px] leading-[1.5] placeholder:text-gray-400 placeholder:font-normal" placeholder="Enter your company name">
                                </div>
                                <div>
                                    <label for="website" class="block text-sm font-semibold text-gray-700 mb-2 text-sm">Website</label>
                                    <input type="url" id="website" name="website_field" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500/15 focus:border-blue-500 transition-colors text-sm font-normal min-h-[40px] leading-[1.5] placeholder:text-gray-400 placeholder:font-normal" placeholder="https://yourwebsite.com">
                                </div>
                                <div>
                                    <label for="contactPerson" class="block text-sm font-semibold text-gray-700 mb-2 text-sm">Contact Person</label>
                                    <input type="text" id="contactPerson" name="contact_person_field" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500/15 focus:border-blue-500 transition-colors text-sm font-normal min-h-[40px] leading-[1.5] placeholder:text-gray-400 placeholder:font-normal" placeholder="Enter contact person name">
                                </div>
                                <div>
                                    <label for="phone" class="block text-sm font-semibold text-gray-700 mb-2 text-sm">Phone Number</label>
                                    <input type="tel" id="phone" name="phone_field" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500/15 focus:border-blue-500 transition-colors text-sm font-normal min-h-[40px] leading-[1.5] placeholder:text-gray-400 placeholder:font-normal" placeholder="Enter phone number">
                                </div>
                            </div>
                        </div>

                        {% endif %}

                        <!-- Message -->
                        <div>
                            <label for="message" class="block text-sm font-semibold text-gray-700 mb-2 text-sm">{{ lang('tickets.message') }}</label>
                            <textarea id="message" name="message_field" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500/15 focus:border-blue-500 transition-colors resize-none text-sm font-normal min-h-[96px] leading-[1.5] placeholder:text-gray-400 placeholder:font-normal" placeholder="Describe your issue in detail..."></textarea>
                        </div>

                        <!-- Priority + Attachment row -->
                        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
                        <!-- Priority -->
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Priority</label>
                            <div class="flex gap-2">
                                <button type="button" class="priority-btn active px-3 py-1 rounded-full border font-medium transition-all duration-200 cursor-pointer text-xs">
                                    Low
                                </button>
                                <button type="button" class="priority-btn px-3 py-1 rounded-full border font-medium transition-all duration-200 cursor-pointer text-xs">
                                    Medium
                                </button>
                                <button type="button" class="priority-btn px-3 py-1 rounded-full border font-medium transition-all duration-200 cursor-pointer text-xs">
                                    High
                                </button>
                            </div>
                        </div>

                        <!-- File Upload -->
                        <div class="tickets-uploader" 
                             data-rtl="{% if site['rtl'] %}true{% else %}false{% endif %}"
                             data-lang-button-attach="{{ lang('tickets.button.attach') }}"
                             data-lang-file-format-incorrect="{{ lang('tickets.error.file_format.incorrect') }}"
                             data-lang-file-size-incorrect="{{ lang('tickets.error.file_size.incorrect') }}">
                            <input type="file" id="files-input" multiple="" accept="image/jpg,image/jpeg,image/png,image/gif,text/plain,text/csv,application/pdf" style="display: none;">
                            <div class="files-wrapper">
                                <button type="button" id="uploader-button" style="background: none;display: flex;align-items: center;align-self: flex-start;padding: 0;border: none; cursor: pointer;">
                                    <a href="#" onclick="event.preventDefault()" class="paperclip" style="display: flex;align-items: center;justify-content: center; cursor: pointer;">
                                        <svg width="24px" height="24px" fill="currentColor" viewBox="0 0 24 24" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                                            <title>paperclip</title>
                                            <g id="paperclip" stroke="none" stroke-width="1" fill-rule="evenodd">
                                                <path d="M15.4604059,6.38639442 C14.683645,5.60296995 13.4230004,5.60296995 12.6462396,6.38639442 L6.78869877,12.2941855 C5.44846797,13.6459138 5.44846797,15.8356494 6.78869877,17.1873777 C8.12892957,18.539106 10.3000398,18.539106 11.6402706,17.1873777 L16.4791086,12.3070285 C16.8261043,11.9570561 17.3927577,11.9570561 17.7397533,12.3070285 C18.0867489,12.657001 18.0867489,13.2285155 17.7397533,13.5784879 L12.9009152,18.4588371 C10.8635097,20.513721 7.56545961,20.513721 5.52805412,18.4588371 C3.49064863,16.4039532 3.49064863,13.07761 5.52805412,11.0227261 L11.3855949,5.11493503 C12.8595304,3.62835499 15.247115,3.62835499 16.7210505,5.11493503 C18.1949861,6.60151508 18.1949861,9.0095821 16.7210505,10.4961621 L11.1181854,16.1470928 C10.2077199,17.065369 8.73060088,17.065369 7.8201353,16.1470928 C6.90966972,15.2288165 6.90966972,13.7390257 7.8201353,12.8207495 L12.4042977,8.19726082 C12.7512933,7.84728842 13.3179467,7.84728842 13.6649423,8.19726082 C14.0119379,8.54723323 14.0119379,9.11874781 13.6649423,9.46872021 L9.08077994,14.0922089 C8.86748906,14.3073296 8.86748906,14.6605127 9.08077994,14.8756334 C9.29407083,15.090754 9.6442499,15.090754 9.85754079,14.8756334 L15.4604059,9.22470275 C16.2371667,8.44127828 16.2371667,7.16981889 15.4604059,6.38639442 Z" id="Path" fill-rule="nonzero"></path>
                                            </g>
                                        </svg>
                                    </a>
                                    <span style="margin: 0px 8px" class="files-label">{{ lang('tickets.button.attach') }}</span>
                                </button>
                            </div>
                        </div>

                        </div>

                        <input type="hidden" name="_csrf" value="{{csrftoken}}">
                        <!-- Submit Button -->
                        <button type="submit" class="tk-solid w-full border font-semibold text-sm py-2.5 px-6 rounded-lg transition-colors flex items-center justify-center gap-2" id="submitBtn">
                            <i class="ri-send-plane-line"></i>
                            {{ lang('tickets.button') }}
                        </button>
                    </form>
                </div>
            </div>

        </div>

        <!-- Ticket List (below the form) -->
        <div id="ticket-list-section" class="max-w-[986px] mx-auto mt-8">
            <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
                <!-- List Header + Search -->
                <div class="border-b border-gray-200 px-5 py-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                    <h2 class="text-base font-semibold text-gray-800 flex items-center gap-2">
                        <i class="ri-list-check tk-ink text-lg font-normal"></i>
                        My Tickets
                    </h2>
                    {% if ticketList or search %}
                    <form action="{{ page['url'] }}" method="get" id="history-search" class="relative w-full sm:w-auto">
                        <div class="relative">
                            <input type="text"
                                   class="w-full sm:w-[260px] h-[42px] pl-10 pr-4 py-2 border border-gray-300 rounded-full focus:ring-2 focus:ring-blue-500/15 focus:border-blue-500 transition-colors text-sm bg-white"
                                   name="search"
                                   value="{{ search }}"
                                   placeholder="{{ lang('general.search.placeholder') }}">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
                                <i class="ri-search-line text-gray-400 text-lg"></i>
                            </div>
                        </div>
                    </form>
                    {% endif %}
                </div>

                {% if ticketList %}
                <div class="overflow-x-auto hidden md:block">
                    <table class="w-full {% if site['rtl'] %} rtl-table {% endif %}">
                        <thead class="bg-gray-50 border-b border-gray-200">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">{{ lang('tickets.id') }}</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">{{ lang('tickets.subject') }}</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">{{ lang('tickets.status') }}</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">{{ lang('tickets.updated') }}</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            {% for ticket in ticketList %}
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-4 py-4 whitespace-nowrap text-sm font-medium text-gray-900">{{ ticket['id'] }}</td>
                                <td class="px-4 py-4 text-sm text-gray-900">
                                    {% if ticket['new'] == 1 %}
                                    <a href="{{ page_url('viewticket') }}/{{ ticket['id'] }}" class="tk-link font-medium hover:underline">
                                        <strong>{{ ticket['theme'] }}</strong>
                                    </a>
                                    {% else %}
                                    <a href="{{ page_url('viewticket') }}/{{ ticket['id'] }}" class="tk-link font-medium hover:underline">
                                        {{ ticket['theme'] }}
                                    </a>
                                    {% endif %}
                                </td>
                                <td class="px-4 py-4 whitespace-nowrap">
                                    {% if ticket['status']|lower == 'pending' %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium tk-badge-pending border">
                                            {{ ticket['status'] }}
                                        </span>
                                    {% elseif ticket['status']|lower == 'answered' %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium tk-badge-answered border">
                                            {{ ticket['status'] }}
                                        </span>
                                    {% elseif ticket['status']|lower == 'closed' %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium tk-badge-closed border">
                                            {{ ticket['status'] }}
                                        </span>
                                    {% else %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium tk-badge-pending border">
                                            {{ ticket['status'] }}
                                        </span>
                                    {% endif %}
                                </td>
                                <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-500">
                                    <span class="nowrap">{{ ticket['time'] }}</span>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                
                <!-- Mobile Card View -->
                <div class="md:hidden">
                    {% for ticket in ticketList %}
                    <div class="p-4 {% if not loop.last %}border-b border-gray-200{% endif %}">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-sm font-medium text-gray-900">#{{ ticket['id'] }}</span>
                            {% if ticket['status']|lower == 'pending' %}
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium tk-badge-pending border">
                                    {{ ticket['status'] }}
                                </span>
                            {% elseif ticket['status']|lower == 'answered' %}
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium tk-badge-answered border">
                                    {{ ticket['status'] }}
                                </span>
                            {% elseif ticket['status']|lower == 'closed' %}
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium tk-badge-closed border">
                                    {{ ticket['status'] }}
                                </span>
                            {% else %}
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium tk-badge-pending border">
                                    {{ ticket['status'] }}
                                </span>
                            {% endif %}
                        </div>
                        {% if ticket['new'] == 1 %}
                        <a href="{{ page_url('viewticket') }}/{{ ticket['id'] }}" class="tk-link font-medium hover:underline block mb-2">
                            <strong>{{ ticket['theme'] }}</strong>
                        </a>
                        {% else %}
                        <a href="{{ page_url('viewticket') }}/{{ ticket['id'] }}" class="tk-link font-medium hover:underline block mb-2">
                            {{ ticket['theme'] }}
                        </a>
                        {% endif %}
                        <div class="text-xs text-gray-500 mb-3">Last updated: {{ ticket['time'] }}</div>
                        <div class="flex gap-2">
                            <a href="{{ page_url('viewticket') }}/{{ ticket['id'] }}" class="tk-link hover:underline text-sm">
                                <i class="ri-eye-line mr-1"></i>View
                            </a>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <!-- Empty State -->
                <div class="px-6 py-10 text-center">
                    <div class="tk-icon-box w-12 h-12 border rounded-full flex items-center justify-center mx-auto mb-3">
                        <i class="ri-inbox-line text-xl"></i>
                    </div>
                    <div class="text-sm font-semibold text-gray-700">{% if search %}No tickets found{% else %}No tickets yet{% endif %}</div>
                    <div class="text-xs text-gray-500 mt-1">{% if search %}Try a different search term.{% else %}Tickets you create above will appear here.{% endif %}</div>
                </div>
                {% endif %}
            </div>

            {% if pagination['count'] > 50 %}
            <!-- Pagination -->
            <div class="flex justify-center mt-8">
                <div class="nav-pills">
                    <ul class="pagination {% if site['rtl'] %} rtl-pagination {% endif %} flex items-center space-x-1">
                        {% if pagination['current'] != 1 %}
                        <li>
                            <a href="{{ page['url'] }}/{{ pagination['last'] }}" 
                               class="flex items-center justify-center w-8 h-8 text-sm font-medium text-gray-500 bg-white border border-gray-300 rounded-lg hover:bg-gray-100 hover:text-gray-700">
                                <span>&laquo;</span>
                            </a>
                        </li>
                        {% endif %}

                        {% set r, l = 3, 3 %}
                        {% if pagination['current'] == 1 %}
                            {% set r = 6 %}
                        {% endif %}
                        {% if pagination['current'] == 2 %}
                            {% set r = 5 %}
                        {% endif %}
                        {% if pagination['current'] >= pagination['pages'] %}
                            {% set l = 5 %}
                        {% endif %}

                        {% for i in 1..ceil(pagination['pages']) %}
                            {% if i >= (pagination['current']-l) and i <= (pagination['current']+r) %}
                            <li>
                                <a href="{{ page['url'] }}/{{ i }}" 
                                   class="flex items-center justify-center w-8 h-8 text-sm font-medium {% if i == pagination['current'] %}tk-solid border{% else %}text-gray-500 bg-white border border-gray-300 hover:bg-gray-100 hover:text-gray-700{% endif %} rounded-lg">
                                    {{ i }}
                                </a>
                            </li>
                            {% endif %}
                        {% endfor %}

                        {% if pagination['current'] < pagination['pages'] %}
                        <li>
                            <a href="{{ page['url'] }}/{{ pagination['next'] }}" 
                               class="flex items-center justify-center w-8 h-8 text-sm font-medium text-gray-500 bg-white border border-gray-300 rounded-lg hover:bg-gray-100 hover:text-gray-700">
                                <span>&raquo;</span>
                            </a>
                        </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
            {% endif %}
        </div>

    </div>
</div>

{% if ticketsText %}
<div class="container mx-auto px-4 mt-8">
    <div class="max-w-4xl mx-auto">
        <div class="bg-white border border-gray-200 rounded-xl p-6 {% if site['rtl'] %} rtl-content {% endif %}">
            {{ ticketsText }}
        </div>
    </div>
</div>
{% endif %}

<style>

/* ===== Tickets page: overall scale (0.7 + 15%) without changing layout ===== */
.tickets-page { zoom: 0.805; }
/* Mobile: slightly less shrink so text and tap targets stay usable */
@media (max-width: 767px) {
    .tickets-page { zoom: 0.98; }
}

/* Request type takes the full row when Order ID is hidden (Payment / General / Cooperation) */
@media (min-width: 768px) {
