<!DOCTYPE html>
<html lang="{{site['iso_lang_code']}}">
	<head>
		<meta charset="utf-8">
		<meta http-equiv="X-UA-Compatible" content="IE=edge">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{{ page['title'] }}</title>
		<meta name="keywords" content="{{ site['seo_key'] }}">
		<meta name="description" content="{{ site['seo_desc'] }}">
		{% if site['favicon'] %}
			<link rel="shortcut icon" type="image/ico" href="{{ site['favicon'] }}"/>
		{% endif %}

		<!-- HTML5 shim and Respond.js for IE8 support of HTML5 elements and media queries -->
		<!--[if lt IE 9]>
		  <script src="https://oss.maxcdn.com/html5shiv/3.7.3/html5shiv.min.js"></script>
		  <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
		  <![endif]-->
		{{ site['custom_header'] }}

		{% for style in site['styles'] %}
			<link rel="stylesheet" type="text/css" href="{{ style['href'] }}">
		{% endfor %}
		<script>
			window.modules = {};
		</script>

    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&display=swap');

        body, html {
            /* Sol üst yumuşak kalırken sol alt biraz daha maviye dönük (blue-200 tonu) */
            background: radial-gradient(ellipse at top right, #ffffff 0%, #eff6ff 50%, #bfdbfe 100%) !important;
            background-attachment: fixed !important;
            color: #1E293B;
            overflow-x: hidden;
        }

        .font-outfit { font-family: 'Outfit', sans-serif; }

        /* Animations Disabled for Performance Optimization */
        .anim-float-slow, .anim-float-medium, .anim-float-fast { transform: none !important; animation: none !important; }

        /* Custom Button Gradients */
        .btn-gradient-blue {
            background: linear-gradient(90deg, #2563eb 0%, #3b82f6 100%);
            box-shadow: 0 10px 25px -5px rgba(59, 130, 246, 0.4);
        }
        
        /* Abstract Background Lines SVG */
        .bg-lines {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
            opacity: 0.6;
        }

        /* Mobile responsive shadow hiding */
        @media (max-width: 768px) {
            .shadow-2xl {
                box-shadow: none !important;
            }
        }

        /* Reduce gap to fit screen perfectly */
        .hero {
            padding-top: 2rem !important;
            padding-bottom: 3rem !important;
            min-height: calc(100vh - 100px);
            display: flex;
            align-items: center;
        }

        /* Old Signup Navbar CSS */
        .header {
            padding: 20px 0;
            position: sticky;
            top: 0;
            z-index: 100;
            width: 100%;
        }
        .header-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: relative;
            max-width: 1280px; /* max-w-7xl */
            width: 100%;
            margin: 0 auto;
            background: rgba(255, 255, 255, 0.75);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(0, 0, 0, 0.05);
            border-radius: 9999px;
            padding: 12px 25px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.07);
        }
        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 700;
            font-size: 1.1rem;
            color: #1e293b;
            text-decoration: none;
        }
        .logo-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border-radius: 8px;
            background-color: #2563eb;
            color: white;
            font-weight: 900;
            font-size: 1rem;
        }
        .logo-icon img {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            object-fit: contain;
        }
        .logo-text {
            font-weight: 600;
        }

        /* Fix PerfectPanel Backend Captcha Modal Styling - Simplified for Performance */
        .modal {
            display: none !important;
            position: fixed;
            inset: 0;
            z-index: 99999;
            background: rgba(0, 0, 0, 0.6);
            align-items: center;
            justify-content: center;
        }
        .modal.show-modal {
            display: flex !important;
        }
        .modal-dialog {
            width: 100%;
            max-width: 380px;
            margin: 0 auto;
            padding: 1rem;
        }
        .modal-content {
            background: #ffffff;
            border-radius: 0.5rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            padding: 1.5rem;
            position: relative;
        }
        .modal-header {
            text-align: center;
            margin-bottom: 1rem;
        }
        .modal-title {
            font-size: 1.125rem;
            font-weight: 600;
            color: #1e293b;
            margin: 0;
            font-family: inherit;
        }
        .modal-header .close {
            position: absolute;
            top: 1rem;
            right: 1rem;
            width: 2rem;
            height: 2rem;
            background: transparent;
            color: #64748b;
            border: none;
            font-size: 1.5rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .modal-body {
            display: flex;
            justify-content: center;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-700 {% if site['rtl'] %}rtl{% endif %}">
    
    <div class="relative z-10 flex min-h-screen flex-col">
        <header class="header">
            <div class="header-inner">
                <a href="/" class="inline-flex items-center justify-center rounded-full border border-blue-200 bg-[#2563eb0d] text-sm font-medium text-blue-600 shadow-sm transition hover:-translate-y-px hover:bg-[#2563eb1a] hover:shadow-md w-12 h-12 md:w-auto md:h-auto md:gap-x-2 md:px-5 md:py-3">
                    <i class="ri-arrow-left-line text-lg"></i>
                    <span class="hidden md:inline">Go Back to Website</span>
                </a>
                <div class="absolute left-1/2 -translate-x-1/2">
                    <a href="{{ page_url('index') }}" class="logo">
                        {% if site['logo'] %}
                            <img src="{{ site['logo'] }}" alt="{{ site['name'] }}" title="{{ site['name'] }}" style="
            height: 40px !important;
            width: auto !important;
            max-width: 150px !important;
            max-height: 40px !important;
            object-fit: contain !important;
            display: block !important;
            opacity: 1 !important;
            visibility: visible !important;
        ">
                        {% else %}
                            <div class="logo-icon">{{ site['name']|first|upper }}</div>
                            <span class="logo-text">{{ site['name'] }}</span>
                        {% endif %}
                    </a>
                </div>
                <a href="/howitworks" class="inline-flex items-center justify-center rounded-full border border-blue-200 bg-[#2563eb0d] text-sm font-medium text-blue-600 shadow-sm transition hover:-translate-y-px hover:bg-[#2563eb1a] hover:shadow-md w-12 h-12 md:w-auto md:h-auto md:gap-x-2 md:px-5 md:py-3">
                    <i class="ri-question-line text-blue-600 text-lg"></i>
                    <span class="hidden md:inline">How it Works</span>
                </a>
            </div>
        </header>
        
        <main class="flex-grow flex flex-col items-center justify-center relative w-full h-full">
            <!-- Abstract Background Wave Lines (SVG) -->
            <svg class="bg-lines hidden lg:block" width="100%" height="100%" viewBox="0 0 1440 800" fill="none" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" style="position:absolute; top:0; left:0; width:100%; height:100%; z-index:0; pointer-events:none;">
                <!-- Hareketsiz Dalga Çizgileri -->
                <path d="M-100 600 C 300 800, 600 200, 1500 500" stroke="#ffffff" stroke-width="3" opacity="0.4"/>
                <path d="M-100 500 C 400 400, 800 900, 1500 300" stroke="#eff6ff" stroke-width="8" opacity="0.6"/>
                <path d="M-100 200 C 400 -50, 900 600, 1500 200" stroke="#bfdbfe" stroke-width="2" opacity="0.7"/>
                <path d="M-100 700 C 500 500, 1000 900, 1500 600" stroke="#60a5fa" stroke-width="4" opacity="0.3"/>
                
                <!-- Glow Dots -->
                <circle cx="200" cy="700" r="6" fill="#ffffff" opacity="0.6"/>
                <circle cx="900" cy="150" r="4" fill="#60a5fa" opacity="0.5"/>
                <circle cx="1300" cy="650" r="8" fill="#eff6ff" opacity="0.8"/>
            </svg>

            <!-- Floating 3D Spheres & Blurred Elements -->
            <div class="absolute top-[15%] left-[1%] w-16 h-16 rounded-full bg-white/80 backdrop-blur-md shadow-[0_10px_20px_rgba(0,0,0,0.1)] border border-white/50 anim-float-slow z-0 hidden lg:flex items-center justify-center opacity-70 blur-[1px]">
                <img src="https://upload.wikimedia.org/wikipedia/commons/b/b8/2021_Facebook_icon.svg" alt="Facebook" class="w-8 h-8 object-contain">
            </div>
            <div class="absolute top-[60%] left-[45%] w-12 h-12 rounded-full bg-white/80 backdrop-blur-md shadow-[0_10px_20px_rgba(0,0,0,0.1)] border border-white/50 anim-float-medium z-0 hidden lg:flex items-center justify-center opacity-50 blur-[3px]">
                <img src="https://upload.wikimedia.org/wikipedia/commons/1/19/Spotify_logo_without_text.svg" alt="Spotify" class="w-6 h-6 object-contain">
            </div>
            <div class="absolute bottom-[20%] left-[10%] w-20 h-20 rounded-full bg-white/80 backdrop-blur-md shadow-[0_10px_20px_rgba(0,0,0,0.1)] border border-white/50 anim-float-slow z-0 hidden lg:flex items-center justify-center opacity-60 blur-[2px]">
                <img src="https://upload.wikimedia.org/wikipedia/commons/8/82/Telegram_logo.svg" alt="Telegram" class="w-10 h-10 object-contain ml-[-2px] mt-[2px]">
            </div>
            <div class="absolute bottom-[32%] left-[52%] w-16 h-16 rounded-full bg-white/80 backdrop-blur-md shadow-[0_10px_20px_rgba(0,0,0,0.1)] border border-white/50 anim-float-medium z-0 hidden lg:flex items-center justify-center opacity-80 blur-[1px] transform rotate-6">
                <img src="https://upload.wikimedia.org/wikipedia/commons/e/e7/Instagram_logo_2016.svg" alt="Instagram" class="w-8 h-8 object-contain">
            </div>
            <div class="absolute bottom-[85%] left-[48%] w-14 h-14 rounded-full bg-white/80 backdrop-blur-md shadow-[0_10px_20px_rgba(0,0,0,0.1)] border border-white/50 anim-float-slow z-0 hidden lg:flex items-center justify-center opacity-65 blur-[2px] transform -rotate-6">
                <img src="https://upload.wikimedia.org/wikipedia/commons/0/09/YouTube_full-color_icon_%282017%29.svg" alt="YouTube" class="w-7 h-7 object-contain">
            </div>
            <div class="absolute top-[12%] right-[28%] w-16 h-16 rounded-full bg-white/80 backdrop-blur-md shadow-[0_10px_20px_rgba(0,0,0,0.1)] border border-white/50 anim-float-slow z-0 hidden lg:flex items-center justify-center opacity-70 blur-[1px] transform -rotate-12">
                <img src="https://upload.wikimedia.org/wikipedia/commons/6/6b/WhatsApp.svg" alt="WhatsApp" class="w-9 h-9 object-contain">
            </div>
            <div class="absolute top-[25%] right-[18%] w-20 h-20 rounded-full bg-white/80 backdrop-blur-md shadow-[0_10px_20px_rgba(0,0,0,0.1)] border border-white/50 anim-float-medium z-0 hidden lg:flex items-center justify-center opacity-60 blur-[2px] transform rotate-12">
                <img src="https://upload.wikimedia.org/wikipedia/commons/d/d3/Twitch_Glitch_Logo_Purple.svg" alt="Twitch" class="w-10 h-10 object-contain">
            </div>

            <section class="hero relative z-10 w-full">
            <div class="container relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid lg:grid-cols-2 gap-8 lg:gap-16 items-stretch">
                    
                    <!-- Signup Form (Right Side) -->
                    <div class="lg:order-2 flex flex-col justify-center" style="margin: 0; padding: 0;">
                        <div class="login-container max-w-lg mx-auto lg:ml-auto lg:mr-0 w-full relative z-20 mt-12 md:mt-0">
                            
                            <div class="bg-white/95 backdrop-blur-2xl p-6 md:p-8 rounded-3xl shadow-[0_20px_50px_rgba(0,0,0,0.05)] border border-slate-100 w-full relative z-30 {% if site['rtl'] %} rtl-content {% endif %}">
                                
                                <!-- Header Inside Login Box -->
                                <div class="mb-5 text-center">
                                    <h2 class="text-2xl md:text-[1.75rem] font-bold text-slate-900 font-outfit tracking-tight mb-3">
                                        Create Account
                                    </h2>
                                    
                                    <!-- Sleek Tab Switcher -->
                                    <div class="h-[42px] w-full flex items-center p-1 bg-slate-50/80 border border-slate-100 rounded-xl">
                                        <a href="{{ page_url('signin') }}" class="w-1/2 h-full flex items-center justify-center text-[13px] font-medium text-slate-500 hover:text-slate-800 hover:bg-slate-200/30 rounded-lg transition-all">
                                            Sign In
                                        </a>
                                        <div class="w-1/2 h-full flex items-center justify-center bg-white rounded-lg shadow-[0_2px_8px_rgba(0,0,0,0.04)] text-[13px] font-bold text-slate-800 cursor-default">
                                            Sign Up
                                        </div>
                                    </div>
                                </div>

                                {% if error %}
                                    <div class="alert alert-dismissible alert-danger {% if site['rtl'] %} rtl-alert {% endif %} mb-3 p-3 bg-red-100 border border-red-300 text-red-700 rounded-lg text-sm">
                                        <button type="button" class="close float-right" data-dismiss="alert" onclick="this.parentElement.style.display='none'">&times;</button>
                                        {{ errorMessage }}
                                    </div>
                                {% endif %}

                                {% if success %}
                                    <div class="alert alert-success alert-dismissible mb-3 p-3 bg-green-100 border border-green-300 text-green-700 rounded-lg text-sm" role="alert">
                                        <button type="button" class="close float-right" data-dismiss="alert" aria-label="Close" onclick="this.parentElement.style.display='none'"><span aria-hidden="true">&times;</span></button>
                                        {{ successText }}
                                    </div>
                                {% endif %}

                                <form id="signup-form" {% if site['rtl'] %}class="rtl-form"{% endif %} action="{{ page_url('signup') }}" method="post" class="flex flex-col gap-3 text-left">
                                    
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                        {% for field in fields %}
                                            <div class="group">
                                                <label for="{{ field.code }}" class="block text-[11px] font-semibold text-gray-700 mb-1">{{ lang(field.label) }}</label>
                                                <div class="relative">
                                                    <div class="absolute inset-y-0 left-0 flex items-center pl-2.5 pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors">
                                                        <i class="{% if field.type == 'password' %}ri-lock-line{% elseif 'mail' in field.code|lower %}ri-mail-line{% elseif 'user' in field.code|lower %}ri-user-line{% elseif 'phone' in field.code|lower %}ri-phone-line{% else %}ri-edit-line{% endif %} text-[15px]"></i>
                                                    </div>
                                                    <input type="{{ field.type }}" id="{{ field.code }}" name="RegistrationForm[{{ field.code }}]" value="{{ field.value }}" placeholder="{{ lang(field.label) }}" required 
                                                           class="w-full pl-8 pr-8 py-2 bg-gray-50/50 border border-gray-200 text-gray-900 text-xs rounded-xl focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all duration-300 outline-none">
                                                    
                                                    {% if field.type == 'password' %}
                                                        <button type="button" class="absolute inset-y-0 right-0 flex items-center pr-2.5 text-gray-400 hover:text-blue-500 transition-colors focus:outline-none" onclick="togglePasswordVisibility('{{ field.code }}')">
                                                            <i class="ri-eye-line text-[15px]"></i>
                                                        </button>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>

                                    {% if site['captcha'] %}
                                        <div class="mt-1">
                                            {{ captchaCode }}
                                        </div>
                                    {% endif %}

                                    {% if check_agreement %}
                                        <div class="flex items-center justify-between mt-1">
                                            <div class="flex items-center">
                                                <label class="custom-checkbox flex items-center cursor-pointer group">
                                                    <input type="checkbox" name="RegistrationForm[termsofservice]" value="1" id="terms" class="peer hidden" required>
                                                    <span class="checkmark border-gray-300 group-hover:border-blue-500 transition-colors flex items-center justify-center rounded w-4 h-4 peer-checked:bg-blue-600 peer-checked:border-blue-600 text-white border">
                                                        <i class="ri-check-line text-xs opacity-0 peer-checked:opacity-100 transition-opacity"></i>
                                                    </span>
                                                    <span class="ml-2.5 text-[11px] font-medium text-gray-600 group-hover:text-gray-900 transition-colors">{{ lang('signup.accept_terms_text') }} <a href="{{ page_url('terms') }}" target="_blank" class="font-semibold text-blue-600 hover:text-blue-700 transition-colors">{{ lang('terms.signup_checkbox') }}</a></span>
                                                </label>
                                            </div>
                                        </div>
                                    {% endif %}

                                    <input type="hidden" name="_csrf" value="{{csrftoken}}">
                                    
                                    <button id="submit-btn" type="submit" class="w-full flex items-center justify-center gap-2 text-white bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 font-semibold rounded-xl text-sm px-4 py-2.5 text-center mt-2 shadow-md shadow-blue-500/30 hover:shadow-blue-500/50 transform hover:-translate-y-0.5 transition-all duration-300 outline-none focus:ring-4 focus:ring-blue-500/20">
                                        <span>{{ lang('signup.button') }}</span>
                                        <i class="ri-user-add-line text-lg"></i>
                                    </button>

                                    {% if googleSignIn %}
                                        <div class="flex items-center my-2">
                                            <hr class="flex-grow border-gray-200">
                                            <span class="px-3 text-[10px] font-semibold text-gray-400 uppercase tracking-wider">OR</span>
                                            <hr class="flex-grow border-gray-200">
                                        </div>

                                        <div class="w-full mb-1">
                                            <div id="g_id_onload"
                                               data-client_id="{{ googleClientId }}"
                                               data-login_uri="{{ googleSignInRedirectUrl }}"
                                               data-auto_prompt="false"
                                               data-_csrf="{{csrftoken}}">
                                            </div>
                                            <div class="g_id_signin w-full flex items-center justify-center transition-colors"
                                               data-type="standard"
                                               data-size="large"
                                               data-theme="outline"
                                               data-text="signup_with"
                                               data-shape="rectangular"
                                               data-logo_alignment="left">
                                            </div>
                                        </div>
                                    {% endif %}

                                    <p class="text-xs text-center text-gray-500 font-medium mt-1">
                                        {{ lang('signup.text') }} <a href="{{ page_url('signin') }}" class="font-bold text-blue-600 hover:text-blue-700 transition-colors">{{ lang('signin.title') }}</a>
                                    </p>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Typography & Features (Left Side on Desktop) -->
                    <div class="relative hidden lg:flex flex-col lg:order-1 pr-4 xl:pr-12 text-left h-full">
                        
                        <!-- Topline Badge (Absolute Top aligned with Login Form) -->
                        <div class="absolute top-0 left-0 w-full z-30 pt-2 lg:pt-0">
                            <span class="text-xs font-bold tracking-wider text-blue-600 uppercase font-outfit">{{ site['name'] }}</span>
                            <span class="text-xs font-medium text-slate-500 ml-1.5">— #1 Premium SMM Panel For Everyone</span>
                        </div>

                        <div class="relative z-10 w-full max-w-xl mt-12 lg:mt-[44px]">
                            
                            <!-- Headline -->
                            <h1 class="text-[2.4rem] lg:text-[2.8rem] xl:text-[3.2rem] leading-tight tracking-tight mb-6 text-left font-outfit text-slate-800 font-bold flex flex-nowrap items-center gap-x-2 whitespace-nowrap">
                                <span>Stand Out, Stay</span>
                                <div class="flex items-center">
                                    <img src="https://storage.perfectcdn.com/ed17j7/pbbaj5xaof1yfx3d.png" alt="E" class="h-11 lg:h-[3.2rem] xl:h-[3.8rem] object-contain relative top-0.5">
                                    <span class="text-[#2b79b8] -ml-1">xclusive</span>
                                </div>
                            </h1>
                            
                            <!-- Paragraph -->
                            <p class="text-sm lg:text-base text-slate-500 mb-6 max-w-[450px] leading-relaxed font-medium font-outfit text-left">
                                Welcome to our panel! <br>
                              We have been serving to our clients with uninterrupted services for years.
You can access to premium services by using our panel.
Our services updating everyday by our technical team.
Also you can get 24/7 VIP support from ticket, telegram and whatsapp.

<br>Enjoy!
                            </p>
                            <!-- Trust Signals (Colorless / Monochrome) -->
                            {# <div class="flex flex-col gap-3.5 mb-2 max-w-[450px]">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-full bg-white/80 flex items-center justify-center text-slate-500 text-sm shadow-sm border border-slate-200/60">
                                        <i class="ri-flashlight-fill"></i>
                                    </div>
                                    <span class="text-[13px] lg:text-[14px] font-semibold text-slate-600 font-outfit">Lightning Fast Automated Delivery</span>
