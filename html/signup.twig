    <script>
        // Robust Polyfill for Bootstrap modal and auto-submit
        document.addEventListener('DOMContentLoaded', function() {
            var polyfillInterval = setInterval(function() {
                if (typeof window.jQuery !== 'undefined') {
                    window.jQuery.fn.modal = function(action) {
                        if (action === 'show') {
                            this.addClass('show-modal');
                        } else if (action === 'hide') {
                            this.removeClass('show-modal');
                        }
                        return this;
                    };
                    clearInterval(polyfillInterval);
                }
            }, 50);

            // Handle close button clicks for the backend generated modal
            document.addEventListener('click', function(e) {
                if (e.target.closest('.close') || e.target.closest('[data-dismiss="modal"]')) {
                    var modal = e.target.closest('.modal');
                    if (modal) {
                        modal.classList.remove('show-modal');
                    }
                }
            });
        });

        function togglePasswordVisibility(id) {
            const input = document.getElementById(id);
            const iconContainer = input.nextElementSibling;
            const icon = iconContainer.querySelector('i');
            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove('ri-eye-line');
                icon.classList.add('ri-eye-off-line');
                iconContainer.classList.add('text-blue-500');
            } else {
                input.type = "password";
                icon.classList.remove('ri-eye-off-line');
                icon.classList.add('ri-eye-line');
                iconContainer.classList.remove('text-blue-500');
            }
        }
    </script>

