                            <!-- Action Buttons -->
                            <div class="flex flex-wrap items-center gap-3 mb-6 mt-6 lg:mt-[24px] xl:mt-[40px]">
                                <a href="https://smmexclusive.com/signup" class="btn-gradient-blue text-white text-sm font-semibold font-outfit rounded-full px-6 py-2.5 flex items-center gap-2 hover:shadow-lg transition-all duration-300 transform hover:-translate-y-0.5">
                                    <i class="ri-rocket-line"></i>
                                    Get Started
                                    <i class="ri-arrow-right-line ml-1"></i>
                                </a>
                                <a href="https://smmexclusive.com/services" class="bg-white border border-slate-200 text-slate-700 text-sm font-semibold font-outfit rounded-full px-6 py-2.5 flex items-center gap-2 hover:bg-slate-50 hover:shadow-md transition-all duration-300">
                                    <i class="ri-list-check-2"></i>
                                    View Services
                                </a>
                            </div>
                        </div>

                            <!-- Stats Row (API Driven) -->
                            <div class="absolute bottom-0 left-0 flex flex-nowrap items-center justify-between gap-5 lg:gap-10 bg-white/90 backdrop-blur-sm border border-slate-100 rounded-[1.25rem] p-4 lg:py-5 lg:pl-8 lg:pr-12 shadow-[0_10px_40px_rgba(0,0,0,0.04)] w-max max-w-[130%] z-20">
                                <div class="flex items-center gap-3 lg:gap-3.5">
                                    <div class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center text-blue-600 text-base border border-blue-100">
                                        <i class="ri-history-line"></i>
                                    </div>
