    // Filter and search functions
    function getAllServices() {
        const allServices = [];
        servicesData.categories.forEach(category => {
            category.services.forEach(service => {
                allServices.push({
                    ...service,
                    category_name: category.name
                });
            });
        });
        return allServices;
    }

    function filterServices() {
        const searchTerm = $searchInput.val().toLowerCase().trim();
        const socialNameToMatch = activeSocialFilter === 'x' ? 'twitter' : activeSocialFilter;
        
        let filtered = getAllServices();

        // Apply social filter
        if (activeSocialFilter !== 'all') {
            filtered = filtered.filter(service =>
                service.name.toLowerCase().includes(socialNameToMatch)
            );
        }

        // Apply category filter
        if (activeCategoryFilter !== 'all') {
            if (activeCategoryFilter === 'favorites') {
                filtered = filtered.filter(service => service.favorite);
            } else {
                filtered = filtered.filter(service => service.category_name === activeCategoryFilter);
            }
        }

        // Apply search filter
        if (searchTerm) {
            filtered = filtered.filter(service =>
                service.name.toLowerCase().includes(searchTerm) ||
                service.id.toString().includes(searchTerm)
            );
        }

        return filtered;
    }

    function renderServices(services, append = false) {
        if (!append) {
            $servicesList.empty();
            currentPage = 0;
            allServicesLoaded = false;
        }

        if (services.length === 0) {
            $noResultsMessage.show();
            $endOfList.hide();
            return;
        }

        $noResultsMessage.hide();

        // Group services by category
        const servicesByCategory = {};
        services.forEach(service => {
            if (!servicesByCategory[service.category_name]) {
                servicesByCategory[service.category_name] = [];
            }
            servicesByCategory[service.category_name].push(service);
        });

        // Get category entries
        let categoryEntries = Object.entries(servicesByCategory);
        
        // Apply category limit if not showing all categories and no filters are active
        if (!showAllCategories && activeSocialFilter === 'all' && activeCategoryFilter === 'all' && !$searchInput.val().trim()) {
            categoryEntries = categoryEntries.slice(0, maxCategoriesOnLoad);
        }

        // Render each category with batch processing
        categoryEntries.forEach(([categoryName, categoryServices]) => {
            const category = servicesData.categories.find(cat => cat.name === categoryName);
            if (!category) return;

            let $categoryContainer = $(`.service-category-container[data-category-id="${category.id}"]`);
            
            if ($categoryContainer.length === 0) {
                // Create new category container
                $servicesList.append(renderCategoryHeader(category));
                $categoryContainer = $(`.service-category-container[data-category-id="${category.id}"]`);
            }

            const $categoryServicesList = $categoryContainer.find('.category-services-list');
            
            // Batch render services for better performance
            const servicesHtml = categoryServices.map(service =>
                renderService(service, category)
            ).join('');
            
            $categoryServicesList.append(servicesHtml);
        });

        // Buton kaldırıldı - scroll ile otomatik yükleme
    }

    function loadMoreServices() {
        if (isLoading || allServicesLoaded) return;

        isLoading = true;
        $loadingIndicator.show();

        // Use requestAnimationFrame for smoother rendering
        requestAnimationFrame(() => {
            const startIndex = currentPage * itemsPerPage;
            const endIndex = startIndex + itemsPerPage;
            const servicesToLoad = filteredServices.slice(startIndex, endIndex);

            if (servicesToLoad.length === 0) {
                allServicesLoaded = true;
                $endOfList.show();
            } else {
                renderServices(servicesToLoad, true);
                currentPage++;
            }

            $loadingIndicator.hide();
            isLoading = false;
        });
    }

    function applyFiltersAndReload() {
        // Her durumda false olsun - her zaman ilk 10 kategori göster
        showAllCategories = false;
        
        filteredServices = filterServices();
        currentPage = 0;
        allServicesLoaded = false;
        $servicesList.empty();
        $endOfList.hide();
        
        // Filtrelenmiş servisleri kategori bazında grupla
        const servicesByCategory = {};
        filteredServices.forEach(service => {
            if (!servicesByCategory[service.category_name]) {
                servicesByCategory[service.category_name] = [];
            }
            servicesByCategory[service.category_name].push(service);
        });
        
        // İlk 25 kategoriyi al ve render et
        const categoryEntries = Object.entries(servicesByCategory).slice(0, 25);
        
        categoryEntries.forEach(([categoryName, categoryServices]) => {
            const category = servicesData.categories.find(cat => cat.name === categoryName);
            if (!category) return;

            // Kategori header'ını ekle
            $servicesList.append(renderCategoryHeader(category));
            
            // Bu kategorinin servislerini ekle
            const $categoryContainer = $(`.service-category-container[data-category-id="${category.id}"]`);
            const $categoryServicesList = $categoryContainer.find('.category-services-list');
            
            const servicesHtml = categoryServices.map(service =>
                renderService(service, category)
            ).join('');
            
            $categoryServicesList.append(servicesHtml);
        });
        
        // Global değişkenleri güncelle
        window.filteredServicesByCategory = servicesByCategory;
        window.loadedFilteredCategories = 25;
        
        // Eğer 25'ten az kategori varsa bitmiş demektir
        const totalCategories = Object.keys(servicesByCategory).length;
        if (totalCategories <= 25) {
            allServicesLoaded = true;
            if (totalCategories > 0) {
                $endOfList.show();
            }
        } else {
            allServicesLoaded = false;
        }
        
        if (filteredServices.length === 0) {
            $noResultsMessage.show();
        } else {
            $noResultsMessage.hide();
        }
    }
    
