    $('.social-filter-button').each(function() {
        const $icon = $(this).find('i');
        if ($icon.length) {
            const colorClass = Array.from($icon.attr('class').split(' ')).find(cls =>
                cls.startsWith('text-') &&
                !['text-white', 'text-base', 'text-lg', 'text-xl', 'text-2xl', 'text-sm'].includes(cls)
            );
            if (colorClass) {
                $icon.data('original-color', colorClass);
            }
        }
    });

    // Set initial active category in dropdown
    $('#category-list li[data-category-target="all"]').addClass('active');

    // Category Dropdown Logic
    const $categoriesButton = $('#categories-button');
    const $categoriesMenu = $('#categories-menu');
    const $categoryList = $('#category-list');
    
    if ($categoriesButton.length && $categoriesMenu.length && $categoryList.length) {
        $categoriesButton.on('click', function(event) {
            event.stopPropagation();
            $categoriesMenu.toggleClass('hidden');
        });

        $(document).on('click', function(event) {
            if (!$categoriesMenu.is(event.target) && $categoriesMenu.has(event.target).length === 0 && !$categoriesButton.is(event.target) && $categoriesButton.has(event.target).length === 0) {
                $categoriesMenu.addClass('hidden');
            }
        });

        $('#category-search').on('input', function() {
            const searchTerm = $(this).val().toLowerCase();
            $categoryList.find('li').each(function() {
                const text = $(this).text().toLowerCase();
                $(this).toggle(text.includes(searchTerm));
            });
        });

        $categoryList.on('click', 'li.category-filter-item', function() {
            const $item = $(this);
            activeCategoryFilter = $item.data('category-target');

            $categoryList.find('li.category-filter-item').removeClass('active');
            $item.addClass('active');
            
            $categoriesMenu.addClass('hidden');
            
            applyFiltersAndReload();
        });
    }

    // Currency Dropdown Logic
    const $currencyButton = $('#currency-button');
    const $currencyMenu = $('#currency-menu');
    
    if ($currencyButton.length && $currencyMenu.length) {
        $currencyButton.on('click', function(event) {
            event.stopPropagation();
            $currencyMenu.toggleClass('hidden');
        });

        $(document).on('click', function(event) {
            if (!$currencyMenu.is(event.target) && $currencyMenu.has(event.target).length === 0 && !$currencyButton.is(event.target) && $currencyButton.has(event.target).length === 0) {
                $currencyMenu.addClass('hidden');
            }
        });

        $('#currencies-list').on('click', 'li', function() {
            const $item = $(this);
            const rateKey = $item.data('rate-key');
            const rateSymbol = $item.data('rate-symbol');
            
            $currencyButton.find('span').first().text(rateKey + ' ' + rateSymbol);
            $currencyMenu.addClass('hidden');
        });
    }

    // Service List Toggling - Delegated events for dynamic content
    $(document).on('click', '.category-toggle-button', function() {
        const $button = $(this);
        const $servicesTableContent = $button.next('.services-table-content');
        if (!$servicesTableContent.length) return;

        const isExpanding = !$servicesTableContent.is(':visible');
        const $icon = $button.find('button i');
        const $buttonText = $button.find('button span');
        
        $icon.toggleClass('rotate-90', isExpanding).toggleClass('expand-icon', !isExpanding);
        $button.toggleClass('border-b', isExpanding);
        if ($buttonText.length) {
            $buttonText.text(isExpanding ? 'Collapse' : 'Expand').toggleClass('expand-text', !isExpanding);
        }

        $servicesTableContent.slideToggle(200);
    });

    // Modal Logic
    const $modal = $('#service-details-modal');
    if ($modal.length) {
        const $modalContent = $('#modal-content');
        
        const openModal = function(serviceData) {
            const serviceId = serviceData.id;
            const fullServiceName = serviceData.name;
            const parts = fullServiceName.split(' | ');
            const title = parts[0];
            const subtitle = parts.slice(1).join(' | ');
            const iconUrl = getIconForService(fullServiceName);

            $('#modal-service-name').html(`<span class="font-semibold text-gray-500">${serviceId}</span> - ${title}`);
            $('#modal-service-icon').attr('src', iconUrl);
            $('#modal-service-subtitle').text(subtitle);
            $('#modal-service-description').html(serviceData.description || '');
            $('#modal-order-button').attr('href', `/?service=${serviceId}`);

            // Arka plan kaydırmayı kilitle
            $('body').addClass('modal-open');
            $modal.removeClass('hidden').addClass('flex').css('opacity', 0).animate({ opacity: 1 }, 150);
            $modalContent.css({ opacity: 0, transform: 'translateY(-1rem)' }).animate({ opacity: 1, transform: 'translateY(0)' }, 150);
        };

        const closeModal = function() {
            $modal.animate({ opacity: 0 }, 150, function() {
                $(this).addClass('hidden').removeClass('flex');
            });
            $modalContent.animate({ opacity: 0, transform: 'translateY(-1rem)' }, 150);
            // Kilidi kaldır
            $('body').removeClass('modal-open');
        };

        $(document).on('click', '.details-button', function(e) {
            e.preventDefault();
            const $serviceRow = $(this).closest('.service-row');
            const serviceId = parseInt($serviceRow.data('service-id'));
            
            // Find service data from JSON
            let serviceData = null;
            servicesData.categories.forEach(category => {
                const service = category.services.find(s => s.id === serviceId);
                if (service) serviceData = service;
            });
            
            if (serviceData) {
                openModal(serviceData);
            }
        });

        $('#modal-close-button').on('click', closeModal);
        $modal.on('click', function(event) {
            if (event.target === this) {
                closeModal();
            }
        });
        $(document).on('keydown', function(event) {
            if (event.key === 'Escape' && !$modal.hasClass('hidden')) {
                closeModal();
            }
        });
    }

    // Optimized debounced search input
    $searchInput.on('input', function() {
        clearTimeout(searchTimeout);
        const searchValue = $(this).val();
        
        // Immediate clear if empty
        if (!searchValue.trim()) {
            applyFiltersAndReload();
            return;
        }
        
        // Debounce for non-empty searches
        searchTimeout = setTimeout(applyFiltersAndReload, 250);
    });

    // Social filter buttons - Using delegated event for dropdown buttons
    $(document).on('click', '.social-filter-button', function(e) {
        e.preventDefault();
        const $button = $(this);
        activeSocialFilter = $button.data('social');

        $('.social-filter-button').each(function() {
            const $btn = $(this);
            $btn.removeClass('active');
            const $icon = $btn.find('i');
            if ($icon.length && $icon.data('original-color')) {
                $icon.removeClass('text-white').addClass($icon.data('original-color'));
            }
        });

        $button.addClass('active');
        const $clickedIcon = $button.find('i');
        const isInDropdown = $button.closest('#more-filters-dropdown').length > 0;

        if (!isInDropdown) {
            if ($clickedIcon.length && $clickedIcon.data('original-color')) {
                $clickedIcon.removeClass($clickedIcon.data('original-color')).addClass('text-white');
            }
        }

        if (isInDropdown) {
            $('#more-filters-dropdown').addClass('hidden');
        }

        applyFiltersAndReload();
    });

    // More filters dropdown - Using delegated event for better reliability
    $(document).on('click', '#more-filters-button', function(e) {
        e.preventDefault();
        e.stopPropagation();
        const $dropdown = $('#more-filters-dropdown');
        
        // Close other dropdowns first
        $('#categories-menu').addClass('hidden');
        $('#currency-menu').addClass('hidden');
        
        // Toggle this dropdown
        $dropdown.toggleClass('hidden');
        
        // Ensure z-index is high enough
        if (!$dropdown.hasClass('hidden')) {
            $dropdown.css({
                'z-index': '9999',
                'position': 'absolute'
            });
        }
    });

    $(document).on('click', function(event) {
        const $target = $(event.target);
        if (!$target.closest('#more-filters-button').length && !$target.closest('#more-filters-dropdown').length) {
            $('#more-filters-dropdown').addClass('hidden');
        }
    });

    // Collapse/Expand All functionality
    let allExpanded = false;
    
    $('#collapse-expand-all-button').on('click', function() {
        const $button = $(this);
        const $icon = $button.find('i');
        const $text = $('#collapse-expand-text');
        
        if (allExpanded) {
            // Collapse all categories
            $('.service-category-container').each(function() {
                const $container = $(this);
                const $toggleButton = $container.find('.category-toggle-button');
                const $content = $container.find('.services-table-content');
                const $toggleIcon = $toggleButton.find('button i');
                const $toggleText = $toggleButton.find('button span');
                
                if ($content.is(':visible')) {
                    $toggleIcon.removeClass('rotate-90').addClass('expand-icon');
                    $toggleButton.removeClass('border-b');
                    if ($toggleText.length) {
                        $toggleText.text('Expand').addClass('expand-text');
                    }
                    $content.hide();
                }
            });
            
            $icon.removeClass('ri-arrow-up-s-line').addClass('ri-arrow-down-s-line');
            $text.text('Expand All');
            allExpanded = false;
        } else {
            // Expand all categories
            $('.service-category-container').each(function() {
                const $container = $(this);
                const $toggleButton = $container.find('.category-toggle-button');
                const $content = $container.find('.services-table-content');
                const $toggleIcon = $toggleButton.find('button i');
                const $toggleText = $toggleButton.find('button span');
                
                if (!$content.is(':visible')) {
                    $toggleIcon.removeClass('expand-icon').addClass('rotate-90');
                    $toggleButton.addClass('border-b');
                    if ($toggleText.length) {
                        $toggleText.text('Collapse').removeClass('expand-text');
                    }
                    $content.show();
                }
            });
            
            $icon.removeClass('ri-arrow-down-s-line').addClass('ri-arrow-up-s-line');
            $text.text('Collapse All');
            allExpanded = true;
        }
    });

    // Show More Categories button handler
    $(document).on('click', '#show-more-categories-btn', function() {
        showAllCategories = true;
        $(this).closest('.show-more-categories-wrapper').remove();
        applyFiltersAndReload();
    });

    // Like button functionality
    $(document).on('click', '.like-button', function(e) {
        e.preventDefault();
        const $button = $(this);
        const $icon = $button.find('[data-favorite-icon]');
        const isActive = $button.attr('data-favorite-active') === 'true';
        
        if (isActive) {
            // Remove active classes
            $icon.removeClass('fas fa-star text-yellow-500').addClass('far fa-star text-gray-500');
            $button.removeAttr('data-favorite-active');
        } else {
            // Add active classes
            $icon.removeClass('far fa-star text-gray-500').addClass('fas fa-star text-yellow-500');
            $button.attr('data-favorite-active', 'true');
        }
    });

    // Initialize scroll handler
    $(window).on('scroll', handleScroll);

    // Set initial active button and load initial data
    $('.social-filter-button[data-social="all"]').addClass('active');
    
    // Initial load - özel fonksiyon kullan
    initialLoad();
});
</script>
