    // Yeni kategorileri yüklemek için fonksiyon
    function loadMoreCategories() {
        if (!window.allServicesByCategory || isLoading) return;
        
        const totalCategories = Object.keys(window.allServicesByCategory).length;
        const remainingCategories = totalCategories - window.loadedCategories;
        
        if (remainingCategories <= 0) {
            allServicesLoaded = true;
            $endOfList.show();
            return;
        }
        
        isLoading = true;
        $loadingIndicator.show();
        
        // Sıradaki 10 kategoriyi yükle
        const categoriesToLoad = Math.min(10, remainingCategories);
        const categoryEntries = Object.entries(window.allServicesByCategory)
            .slice(window.loadedCategories, window.loadedCategories + categoriesToLoad);
        
        // Her kategoriyi render et
        categoryEntries.forEach(([categoryName, categoryServices]) => {
            const category = servicesData.categories.find(cat => cat.name === categoryName);
            if (!category) return;

            // Kategori header'ını ekle
            $servicesList.append(renderCategoryHeader(category));
            
            // Bu kategorinin servislerini ekle
            const $categoryContainer = $(`.service-category-container[data-category-id="${category.id}"]`);
            const $categoryServicesList = $categoryContainer.find('.category-services-list');
            
            const servicesHtml = categoryServices.map(service =>
                renderService(service, category)
            ).join('');
            
            $categoryServicesList.append(servicesHtml);
        });
        
        window.loadedCategories += categoriesToLoad;
        
        // Eğer tüm kategoriler yüklendiyse
        if (window.loadedCategories >= totalCategories) {
            allServicesLoaded = true;
            $endOfList.show();
        }
        
        $loadingIndicator.hide();
        isLoading = false;
    }

