<style>
#modal-service-description{
    max-height: 250px;
    overflow: auto;
}
/* Modal açıkken arka plan kaydırmayı kilitle */
body.modal-open {
    overflow: hidden !important;
    height: 100vh;
}
</style>

{% if user['auth'] %}{% else %}
<section class="page-header-ui">
    <div class="container mx-auto px-4 text-center pb-10">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-800 tracking-tight">Services</h1>
        <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">Find the best services for your needs.</p>
    </div>
</section>
{% endif %}

{% if user['auth'] %}

<div class="relative z-10 pb-16 md:pb-15 bg-white pt-6">
    <div class="container mx-auto px-4 relative z-10 {% if site['rtl'] %} rtl-nav {% endif %}">

        <!-- Blank Card -->
        <div class="bg-white p-4 border border-gray-200 rounded-xl w-full mx-auto mb-8">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between">
              {% else %}
              <main class="relative z-10 pb-16 md:pb-15 bg-white pt-12">
    <div class="container mx-auto px-4 relative z-10">

        <!-- Blank Card -->
        <div class="bg-white p-4 border border-gray-200 rounded-xl w-full mx-auto mb-8 mt-[-80px]">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between">
              {% endif %}

                <!-- Search -->
                <div class="relative flex-grow mb-4 md:mb-0 md:mr-4">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3">
                        <svg class="w-5 h-5 text-gray-400" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M21 21L16.65 16.65M19 11C19 15.4183 15.4183 19 11 19C6.58172 19 3 15.4183 3 11C3 6.58172 6.58172 3 11 3C15.4183 3 19 6.58172 19 11Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg>
                    </span>
                    <input type="text" id="service-search-input" placeholder="{{ lang('general.search.placeholder') }}" class="w-full pl-10 pr-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" data-search-service="#service-table">
                </div>
                <!-- Categories Dropdown -->
                <div class="relative" id="categories-dropdown-container">
                    <button id="categories-button" class="flex items-center px-4 py-2 border rounded-lg text-gray-600 hover:bg-gray-100 w-full md:w-auto justify-center">
                        <span class="fal fa-filter"></span>
                        <span data-filter-active-category="true"></span>
                        <span class="caret"></span>
                    </button>
                    <div id="categories-menu" class="hidden absolute z-20 mt-2 w-full md:w-96 bg-white rounded-lg shadow-lg border border-gray-200 right-0">
                        <div class="p-2">
                            <input type="text" id="category-search" placeholder="Search Categories" class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                        </div>
                        <ul class="max-h-60 overflow-y-auto" id="category-list">
                            {% if serviceCategoryList is empty %}
                            {% else %}
                                <li class="px-4 py-2 hover:bg-gray-100 cursor-pointer category-filter-item" data-category-target="all" data-filter-category-id="All">{{ lang('services.all') }}</li>
                            {% endif %}
                            {% if user.favorite_services %}
                                <li class="px-4 py-2 hover:bg-gray-100 cursor-pointer category-filter-item" data-category-target="favorites" data-filter-category-id="favorites" data-filter-category-name="{{ lang('services.favorite') }}">
                                    <span class="fas fa-star"></span>
                                    <span>{{ lang('services.favorite') }}</span>
                                </li>
                            {% endif %}
                            {% for category in serviceCategoryList %}
                                {% if category.name %}
                                    <li class="px-4 py-2 hover:bg-gray-100 cursor-pointer category-filter-item" data-category-target="{{ category.name }}" data-filter-category-id="{{ category.id }}" data-filter-category-name="{{ category.name }}">
                                        <span>{{ category['name'] }}</span>
                                    </li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                    </div>
                </div>
                <!-- Currency Dropdown -->
                {% if site.currencies and not user['auth'] %}
                    <div class="relative ml-2" id="currency-dropdown-container">
                        <button id="currency-button" class="flex items-center px-4 py-2 border rounded-lg text-gray-600 hover:bg-gray-100 w-full md:w-auto justify-center">
                            <span>
                                {% if user.currency %}
                                    {{ user.currency.label }}
                                {% else %}
                                    {{ site.currency.label }}
                                {% endif %}
                            </span>
                            <span class="caret"></span>
                        </button>
                        <div id="currency-menu" class="hidden absolute z-20 mt-2 w-full md:w-48 bg-white rounded-lg shadow-lg border border-gray-200 right-0">
                            <ul class="max-h-60 overflow-y-auto" id="currencies-list">
                                {% for key, rate in site.currencies %}
                                    <li class="px-4 py-2 hover:bg-gray-100 cursor-pointer" id="currencies-item" data-rate-key="{{ key }}" data-rate-symbol="{{ rate.symbol }}">{{ key }} {{ rate.symbol }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                {% endif %}
            </div>
            <!-- Social Filters -->
            <div id="social-filters" class="mt-4 flex flex-wrap items-center gap-2">
                <button data-social="all" class="social-filter-button px-4 py-2 rounded-lg text-sm font-semibold flex items-center gap-2 transition-colors">
                    <i class="ri-apps-line text-base font-normal"></i><span class="hidden md:inline">All</span>
                </button>
                <button data-social="instagram" class="social-filter-button px-4 py-2 rounded-lg text-sm font-semibold flex items-center gap-2 transition-colors">
                    <i class="ri-instagram-line text-pink-500 text-base font-normal"></i><span class="hidden md:inline">Instagram</span>
                </button>
                <button data-social="tiktok" class="social-filter-button px-4 py-2 rounded-lg text-sm font-semibold flex items-center gap-2 transition-colors">
                    <i class="ri-tiktok-fill text-black text-base font-normal"></i><span class="hidden md:inline">TikTok</span>
                </button>
                <button data-social="youtube" class="social-filter-button px-4 py-2 rounded-lg text-sm font-semibold flex items-center gap-2 transition-colors">
                    <i class="ri-youtube-fill text-red-600 text-base font-normal"></i><span class="hidden md:inline">YouTube</span>
                </button>
                <button data-social="facebook" class="social-filter-button px-4 py-2 rounded-lg text-sm font-semibold flex items-center gap-2 transition-colors">
                    <i class="ri-facebook-box-fill text-blue-600 text-base font-normal"></i><span class="hidden md:inline">Facebook</span>
                </button>
                <button data-social="twitter" class="social-filter-button px-4 py-2 rounded-lg text-sm font-semibold flex items-center gap-2 transition-colors">
                    <i class="ri-twitter-x-line text-black text-base font-normal"></i><span class="hidden md:inline">Twitter</span>
                </button>
                <button data-social="telegram" class="social-filter-button px-4 py-2 rounded-lg text-sm font-semibold flex items-center gap-2 transition-colors">
                    <i class="ri-telegram-fill text-sky-500 text-base font-normal"></i><span class="hidden md:inline">Telegram</span>
                </button>
                <div class="flex items-center gap-2 ml-auto">
  <div class="relative">
    <button id="more-filters-button" class="px-4 py-2 rounded-lg bg-gray-100 text-gray-700 text-sm font-semibold flex items-center hover:bg-gray-200 transition-colors">
      More 
      <svg class="w-4 h-4 ml-1" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path>
      </svg>
    </button>

    <div id="more-filters-dropdown" class="hidden absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 z-20 border border-gray-200">
      <a href="#" data-social="linkedin" class="social-filter-button flex items-center gap-2 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-100 transition-colors">
        <i class="ri-linkedin-box-fill text-blue-700 text-base font-normal"></i>LinkedIn
      </a>
      <a href="#" data-social="twitch" class="social-filter-button flex items-center gap-3 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-100">
        <img src="https://storage.perfectcdn.com/ed17j7/26xp9ng9n4ykf8u4.png" alt="Twitch" class="h-4 w-auto">Twitch
      </a>
      <a href="#" data-social="rumble" class="social-filter-button flex items-center gap-3 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-100">
        <img src="https://storage.perfectcdn.com/ed17j7/qca62hwq1k70riht.png" alt="Rumble" class="h-4 w-auto">Rumble
      </a>
      <a href="#" data-social="kwai" class="social-filter-button flex items-center gap-3 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-100">
        <img src="https://storage.perfectcdn.com/ed17j7/6w1735blhfq5ce4f.png" alt="Kwai" class="h-4 w-auto">Kwai
      </a>
      <a href="#" data-social="snackvideo" class="social-filter-button flex items-center gap-3 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-100">
        <img src="https://storage.perfectcdn.com/ed17j7/rs4mesfy5mjlfilr.png" alt="SnackVideo" class="h-4 w-auto">SnackVideo
      </a>
      <a href="#" data-social="threads" class="social-filter-button flex items-center gap-3 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-100">
        <img src="https://storage.perfectcdn.com/ed17j7/fxm1jrdli8ajwbxw.jpeg" alt="Threads" class="h-4 w-auto">Threads
      </a>
      <a href="#" data-social="spotify" class="social-filter-button flex items-center gap-3 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-100">
        <img src="https://storage.perfectcdn.com/ed17j7/0hdxcj369y1huz5q.png" alt="Spotify" class="h-4 w-auto">Spotify
      </a>
      <a href="#" data-social="rednote" class="social-filter-button flex items-center gap-3 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-100">
        <img src="https://storage.perfectcdn.com/ed17j7/zzhlpxzlmzao00r6.png" alt="rednote" class="h-4 w-4 rounded-sm object-contain">Rednote
      </a>
    </div>
  </div>


                    <button id="collapse-expand-all-button" class="px-4 py-2 rounded-lg bg-blue-100 text-blue-700 text-sm font-semibold flex items-center hover:bg-blue-200 transition-colors">
                        <i class="ri-arrow-down-s-line mr-1"></i>
                        <span id="collapse-expand-text">Expand All</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- No Results Message -->
        <div id="no-results-message" class="hidden text-center py-10 px-4">
            <i class="ri-emotion-sad-line text-5xl text-gray-400"></i>
            <h3 class="mt-4 text-xl font-semibold text-gray-700">No Services Found</h3>
            <p class="mt-1 text-gray-500">We couldn't find any services matching your search. Please try again.</p>
        </div>

        <!-- JSON Data for JavaScript -->
        <script type="application/json" id="services-data">
        {
            "categories": [
                {% for category in serviceCategoryList %}
                {% if category['name'] %}
                {
                    "id": {{ category.id }},
                    "name": {{ category.name|json_encode }},
                    "icon": {
                        "type": {% if category['icon'] %}{{ category['icon']['icon_type']|json_encode }}{% else %}"default"{% endif %},
                        "value": {% if category['icon'] %}{{ category['icon']['icon']|json_encode }}{% else %}""{% endif %},
                        "url": {% if category['icon'] and category['icon']['icon_type'] == 'image' %}{{ category['icon']['url']|json_encode }}{% else %}null{% endif %}
                    },
                    "services": [
                        {% for service in category['services'] %}
                        {
                            "id": {{ service.id }},
                            "name": {{ service.name|json_encode }},
                            "rate": {{ service.rate|json_encode }},
                            "min": "{{ service.min }}",
                            "max": "{{ service.max }}",
                            "category_id": {{ category.id }},
                            "favorite": {% if user.favorite_services and service.favorite %}true{% else %}false{% endif %},
                            "original_rate": {% if converted and service.original_rate %}{{ service.original_rate|json_encode }}{% else %}null{% endif %},
                            "average_time": {% if site['average_time'] and service.average_time %}{{ service.average_time|json_encode }}{% else %}null{% endif %},
                            "description": {% if service.description %}{{ service.description|json_encode }}{% else %}null{% endif %}
                        }{% if not loop.last %},{% endif %}
                        {% endfor %}
                    ]
                }{% if not loop.last %},{% endif %}
                {% endif %}
                {% endfor %}
            ],
            "config": {
                "user_favorites_enabled": {% if user.favorite_services %}true{% else %}false{% endif %},
                "average_time_enabled": {% if site['average_time'] %}true{% else %}false{% endif %},
                "service_description_enabled": {% if serviceDescription %}true{% else %}false{% endif %},
                "converted_rates": {% if converted %}true{% else %}false{% endif %},
                "rtl": {% if site['rtl'] %}true{% else %}false{% endif %},
                "pagination": {
                    "items_per_page": 20,
                    "initial_load": 20
                },
                "lang": {
                    "services_id": {{ lang('services.id')|json_encode }},
                    "services_name": {{ lang('services.name')|json_encode }},
                    "services_rate": {{ lang('services.rate')|json_encode }},
                    "services_min": {{ lang('services.min')|json_encode }},
                    "services_max": {{ lang('services.max')|json_encode }},
                    "services_all": {{ lang('services.all')|json_encode }},
                    "services_favorite": {{ lang('services.favorite')|json_encode }},
                    "general_search_placeholder": {{ lang('general.search.placeholder')|json_encode }},
                    "services_average_time": {% if site['average_time'] %}{{ lang('services.average_time')|json_encode }}{% else %}null{% endif %},
                    "services_average_time_description": {% if site['average_time'] %}{{ lang('services.average_time.description')|json_encode }}{% else %}null{% endif %},
                    "services_description": {% if serviceDescription %}{{ lang('services.description')|json_encode }}{% else %}null{% endif %}
                }
            }
        }
        </script>

        <!-- Services Container -->
        <div id="services-container">
            <!-- Loading Indicator -->
            <div id="loading-indicator" class="hidden">
                <div class="flex justify-center items-center py-8">
                    <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div>
                </div>
            </div>
            
            <!-- Services List will be populated by JavaScript -->
            <div id="services-list"></div>
            
            <!-- End of List Message -->
            <div id="end-of-list" class="hidden text-center py-8">
                <p class="text-gray-500">End</p>
            </div>
        </div>
    </div>
</div>

<!-- Service Details Modal -->
<div id="service-details-modal" class="fixed inset-0 bg-black bg-opacity-60 backdrop-blur-sm z-[99999] hidden items-center justify-center p-4 transition-opacity duration-300" style="z-index: 99999;">
    <div id="modal-content" class="bg-white rounded-xl shadow-2xl w-full max-w-md mx-auto transform transition-all duration-300 opacity-0 -translate-y-4">
        <!-- Modal Header -->
        <div class="p-4 border-b flex justify-between items-center">
            <h2 class="text-lg font-semibold text-gray-800 flex items-center gap-3">
                <i class="ri-information-line text-blue-700 text-2xl"></i>
                Service Description
            </h2>
            <button id="modal-close-button" class="text-gray-500 hover:text-gray-800">
                <i class="ri-close-line text-2xl"></i>
            </button>
        </div>

        <!-- Modal Body -->
        <div class="p-6">
            <div class="text-center">
                <img id="modal-service-icon" src="" alt="Service Icon" class="w-16 h-16 mx-auto mb-4 rounded-lg p-1 border">
                <h3 id="modal-service-name" class="text-xl font-bold text-gray-800"></h3>
                <p id="modal-service-subtitle" class="text-sm text-gray-500 mt-1"></p>
            </div>

            <div class="mt-6">
                <div id="modal-service-description" class="text-sm text-gray-600 bg-gray-100 p-4 rounded-lg text-center">
                    <!-- Dynamic content here -->
                </div>
                <a href="#" id="modal-order-button" class="mt-6 text-sm font-semibold text-white bg-blue-700 hover:bg-blue-800 rounded-full px-8 py-2.5 transition-colors flex items-center justify-center gap-2 w-full md:w-auto mx-auto">
                    Order Now <i class="ri-shopping-cart-line"></i>
                </a>
            </div>
        </div>
    </div>
</div>

{% if servicesText %}
    <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
            <div class="bg-white p-6 rounded-lg border border-gray-200 {% if site['rtl'] %} rtl-content {% endif %}">
                {{ servicesText }}
            </div>
        </div>
    </div>
{% endif %}

<style>
@keyframes wiggle {
  0%, 100% {
    transform: translateX(0);
  }
  25% {
    transform: translateX(-2px);
  }
  75% {
    transform: translateX(2px);
  }
}
.group:hover .expand-text,
.group:hover .expand-icon {
  animation: wiggle 1.5s ease-in-out infinite;
}

.category-toggle-button::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2rem;
    height: 2rem;
    background: rgba(0, 0, 0, 0.05);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition: width 0.4s ease-out, height 0.4s ease-out;
    z-index: 0;
    opacity: 0;
}

.category-toggle-button:hover::before {
    width: 250%; 
    height: 500px;
    opacity: 1;
}

/* Social Filter Button Styles */
.social-filter-button {
    background-color: #f3f4f6; /* gray-100 */
    color: #374151; /* gray-700 */
}
.social-filter-button:hover {
    background-color: #e5e7eb; /* gray-200 */
}
.social-filter-button.active {
    background-color: #1d4ed8; /* blue-700 */
    color: #ffffff; /* white */
}
.social-filter-button.active:hover {
    background-color: #1e40af; /* blue-800 */
}
/* Styles for dropdown links */
#more-filters-dropdown .social-filter-button {
    background-color: transparent;
    color: #374151; /* gray-700 */
}
#more-filters-dropdown .social-filter-button:hover {
    background-color: #f3f4f6; /* gray-100 */
}
#more-filters-dropdown .social-filter-button.active {
    background-color: #e5e7eb; /* gray-200 */
}

/* Active state for category dropdown item */
#category-list .category-filter-item.active {
    background-color: #f3f4f6; /* gray-100 */
    font-weight: 600; /* semibold */
}

/* More Filters Dropdown Styles */
#more-filters-dropdown {
    z-index: 9999 !important;
    position: absolute !important;
    right: 0;
    top: 100%;
    margin-top: 0.5rem;
    min-width: 12rem;
    background: white;
    border-radius: 0.375rem;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    border: 1px solid #e5e7eb;
    padding: 0.25rem 0;
}

#more-filters-dropdown.hidden {
    display: none !important;
}

#more-filters-dropdown:not(.hidden) {
    display: block !important;
}

/* More filters button container positioning */
.relative {
    position: relative !important;
}

</style>

<script>
$(function() {
    // Description sanitizer function
    function sanitizeServiceDescriptions(servicesData) {
        if (!servicesData || !servicesData.categories) {
            return servicesData;
        }

        // Varsayılan açıklama metni
        const defaultDescription = "🚨⚠ Your profile or your post must be public!<br>🚨⚠ When the service is overloaded, described start time and daily speed can change!<br>🚨⚠ Do not place multiple order to the same link before your order is completed on the system.";

        servicesData.categories.forEach(category => {
            if (category.services && Array.isArray(category.services)) {
                category.services.forEach(service => {
                    // Eğer açıklama yoksa veya boşsa varsayılan açıklamayı ekle
                    if (!service.description || service.description === null || service.description.trim() === '') {
                        service.description = defaultDescription;
                    } else if (typeof service.description === 'string') {
                        // " karakterlerini ' karakterine çevir
                        service.description = service.description.replace(/"/g, "'");
                    }
                });
            }
        });

        return servicesData;
    }

    // Parse JSON data from script tag
    let servicesData = {};
    try {
        const jsonText = $('#services-data').text();
        servicesData = JSON.parse(jsonText);
        
        // Description alanlarını temizle
        servicesData = sanitizeServiceDescriptions(servicesData);
    } catch (e) {
        console.error('JSON parse error:', e);
        console.error('JSON Text causing error:', $('#services-data').text());
        
        // Fallback empty data structure
        servicesData = {
            categories: [],
            config: {
                user_favorites_enabled: false,
                average_time_enabled: false,
                service_description_enabled: false,
                converted_rates: false,
                rtl: false,
                pagination: {
                    items_per_page: 20,
                    initial_load: 20
                },
                lang: {
                    services_id: "ID",
                    services_name: "Name",
                    services_rate: "Rate",
                    services_min: "Min",
                    services_max: "Max",
                    services_all: "All",
                    services_favorite: "Favorites",
                    general_search_placeholder: "Search services..."
                }
            }
        };
    }

    // Cache DOM elements for performance
    const $searchInput = $('#service-search-input');
    const $noResultsMessage = $('#no-results-message');
    const $servicesContainer = $('#services-container');
    const $servicesList = $('#services-list');
    const $loadingIndicator = $('#loading-indicator');
    const $endOfList = $('#end-of-list');

    // Application state
    let currentPage = 0;
    let isLoading = false;
    let allServicesLoaded = false;
    let activeSocialFilter = 'all';
    let activeCategoryFilter = 'all';
    let searchTimeout;
    let filteredServices = [];
    let showAllCategories = false; // İlk yüklemede 10 kategori göstermek için false

    // Configuration
    const itemsPerPage = servicesData.config.pagination.items_per_page || 20;
    const maxCategoriesOnLoad = 25; // İlk yüklemede 25 kategori göster

    // Icon mappings cache
    const iconCache = new Map();
    
    function getRemixIconForCategory(categoryName) {
        if (iconCache.has(categoryName)) return iconCache.get(categoryName);
        
        categoryName = categoryName.toLowerCase();
        let result;
        
        if (categoryName.includes('instagram')) {
            result = { icon: 'ri-instagram-line', color: 'text-pink-500' };
        } else if (categoryName.includes('facebook')) {
            result = { icon: 'ri-facebook-box-fill', color: 'text-blue-600' };
        } else if (categoryName.includes('twitter') || categoryName.includes(' x ')) {
            result = { icon: 'ri-twitter-x-line', color: 'text-black' };
        } else if (categoryName.includes('tiktok')) {
            result = { icon: 'ri-tiktok-fill', color: 'text-black' };
        } else if (categoryName.includes('telegram')) {
            result = { icon: 'ri-telegram-fill', color: 'text-sky-500' };
        } else if (categoryName.includes('youtube')) {
            result = { icon: 'ri-youtube-fill', color: 'text-red-600' };
        } else if (categoryName.includes('spotify')) {
            result = { icon: 'ri-spotify-fill', color: 'text-green-500' };
        } else if (categoryName.includes('linkedin')) {
            result = { icon: 'ri-linkedin-box-fill', color: 'text-blue-700' };
        } else if (categoryName.includes('twitch')) {
            result = { icon: 'ri-twitch-fill', color: 'text-purple-600' };
