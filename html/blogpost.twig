
        <section class="page-header-ui">
            <div class="container mx-auto px-4 text-center pb-8">
                <h1 class="text-4xl md:text-5xl font-bold text-gray-800 tracking-tight">{{ post['title'] }}</h1>
                <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">{{ post['date'] }}</p>
            </div>
        </section>

        <main class="relative z-10 pb-16 md:pb-24 bg-white">
            <div class="container px-4 mx-auto relative z-10 -mt-[25px]">
                <div class="bg-white border border-gray-200 rounded-2xl shadow-lg overflow-hidden">
                    <div class="relative">
                        {% if post['image'] %}
                        <img src="{{ post['image'] }}" alt="{{ post['title'] }}" class="w-full h-[378px] object-cover">
                        {% endif %}
                        <a href="{{ page_url('blog') }}" class="absolute top-5 left-5 bg-white/80 text-gray-900 backdrop-blur-sm rounded-full py-2 px-4 hover:bg-white transition-all duration-300 shadow-md flex items-center gap-2">
                            <i data-feather="arrow-left" class="w-5 h-5"></i>
                            <span class="font-semibold text-sm">{{ lang('blog.back')}}</span>
                        </a>
                    </div>
                    <div class="p-6 sm:p-8 md:p-10">
                        <div class="mx-auto">
                             <h1 class="mt-1 text-2xl font-bold text-gray-900 tracking-tight sm:text-3xl">{{ post['title'] }}</h1>
                         
                             <hr class="my-6">
                             <article class="prose lg:prose-lg max-w-none">
                                {{ post['content'] }}
                            </article>
                        </div>
                    </div>
                </div>
            </div>
        </main>
