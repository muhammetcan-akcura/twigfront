    const levelRequirements = Object.fromEntries(
        Object.entries(levelData).map(([level, data]) => [level, data.required])
    );
    

    

    
    function getCurrentLevel() {
        const levels = Object.keys(levelRequirements).sort((a, b) => levelRequirements[b] - levelRequirements[a]);
        for (let level of levels) {
            if (userSpent >= levelRequirements[level]) {
                return level;
            }
        }
        return levels[levels.length - 1];
    }
    
    function getNextLevel() {
        const current = getCurrentLevel();
        const levels = Object.keys(levelRequirements).sort((a, b) => levelRequirements[a] - levelRequirements[b]);
        const currentIndex = levels.indexOf(current);
        if (currentIndex < levels.length - 1) {
            return levels[currentIndex + 1];
        }
        return current;
    }
    
    function getProgress() {
        const current = getCurrentLevel();
        const next = getNextLevel();
        const currentReq = levelRequirements[current];
        const nextReq = levelRequirements[next];
        const progress = ((userSpent - currentReq) / (nextReq - currentReq)) * 100;
        return Math.min(progress, 100);
    }
    
    function getRemaining() {
        const next = getNextLevel();
        const nextReq = levelRequirements[next];
        return nextReq - userSpent;
    }

    
    levelButtons.forEach(button => {
        button.addEventListener('click', function() {

            levelButtons.forEach(btn => {
                btn.classList.remove('active', 'text-white');
                btn.classList.add('bg-white', 'text-gray-700', 'border', 'border-gray-200', 'hover:bg-gray-50');
                btn.style.backgroundColor = '';
            });
            

            this.classList.remove('bg-white', 'text-gray-700', 'border', 'border-gray-200', 'hover:bg-gray-50');
            this.classList.add('active', 'text-white', 'border', 'border-gray-200');
            this.style.backgroundColor = '#134de2';
            

            const spanElement = this.querySelector('span');
            let levelName = spanElement.textContent.trim();
            updateLevelDetails(levelName);
        });
    });
    

    
    function updateLevelDetails(level) {
        const data = levelData[level];
        if (!data) return;
        
        const badgeContainer = detailsCard.querySelector('.w-16.h-16');
        const badgeIcon = detailsCard.querySelector('.w-16.h-16 img');
        
        badgeContainer.className = 'w-16 h-16 bg-gradient-to-br from-blue-50 to-blue-100 rounded-full flex items-center justify-center mr-4 shadow-sm border border-blue-200';
        
        badgeIcon.src = data.badge;
        badgeIcon.alt = data.status;
        badgeIcon.className = 'w-10 h-10';
        
        const levelNameElement = detailsCard.querySelector('.text-2xl.font-bold');
        if (levelNameElement) {
            levelNameElement.textContent = data.status;
        }
        

        const requiredAmountElement = document.getElementById('level-required-amount');
        const progressInfoElement = document.getElementById('level-progress-info');
        
        if (requiredAmountElement && progressInfoElement) {
            requiredAmountElement.textContent = `$${data.required.toLocaleString()}`;
            
            if (userSpent >= data.required) {
                progressInfoElement.textContent = '✓ Already achieved';
                progressInfoElement.className = 'text-xs font-medium px-3 py-1.5 rounded-full bg-green-100 text-green-700 border border-green-200';
                requiredAmountElement.className = 'text-2xl font-bold text-green-600';
            } else {
                const remaining = data.required - userSpent;
                progressInfoElement.textContent = `$${remaining.toLocaleString()} more needed`;
                progressInfoElement.className = 'text-xs font-medium px-3 py-1.5 rounded-full bg-orange-100 text-orange-700 border border-orange-200';
                requiredAmountElement.className = 'text-2xl font-bold text-gray-800';
            }
        }
        

        const benefitsContainer = detailsCard.querySelector('.grid.grid-cols-1.md\\:grid-cols-2');
        if (benefitsContainer) {
            benefitsContainer.innerHTML = '';
            
            // Display only the benefits available for this level
            data.availableBenefits.forEach((benefit) => {
                const benefitDiv = document.createElement('div');
                benefitDiv.className = `bg-gradient-to-r ${benefit.gradient} p-4 rounded-xl border ${benefit.border}`;
                benefitDiv.innerHTML = `
                    <div class="flex items-center">
                        <div class="w-8 h-8 ${benefit.bg} rounded-full flex items-center justify-center mr-3">
                            <i class="${benefit.icon} text-white text-sm"></i>
                        </div>
                        <span class="font-semibold text-gray-800">${benefit.name}</span>
                    </div>
                `;
                
                benefitsContainer.appendChild(benefitDiv);
            });
        }
    }
    

    

    function updateCurrentBenefits() {
        const currentLevel = getCurrentLevel();
        const currentBenefitsContainer = document.getElementById('current-benefits-list');
        
        if (currentBenefitsContainer) {
            currentBenefitsContainer.innerHTML = '';
            
            const currentLevelData = levelData[currentLevel];
            if (currentLevelData && currentLevelData.availableBenefits) {
                currentLevelData.availableBenefits.forEach(benefit => {
                    const benefitDiv = document.createElement('div');
                    benefitDiv.className = 'flex items-center';
                    benefitDiv.innerHTML = `
                        <div class="w-1.5 h-1.5 bg-green-500 rounded-full mr-2"></div>
                        <span class="text-sm text-gray-700">${benefit.name}</span>
                    `;
                    currentBenefitsContainer.appendChild(benefitDiv);
                });
            }
        }
    }
    
    function updateNextLevelBenefits() {
        const currentLevel = getCurrentLevel();
        const nextLevel = getNextLevel();
        const nextBenefitsContainer = document.getElementById('next-level-benefits');
        
        if (nextBenefitsContainer) {
            nextBenefitsContainer.innerHTML = '';
            
            const currentLevelData = levelData[currentLevel];
            const nextLevelData = levelData[nextLevel];
            
            if (currentLevelData && nextLevelData && currentLevelData.availableBenefits && nextLevelData.availableBenefits) {
                // Find benefits that are in next level but not in current level
                const currentBenefitNames = currentLevelData.availableBenefits.map(b => b.name);
                const additionalBenefits = nextLevelData.availableBenefits.filter(benefit => 
                    !currentBenefitNames.includes(benefit.name)
                );
                
                additionalBenefits.forEach(benefit => {
                    const benefitDiv = document.createElement('div');
                    benefitDiv.className = 'flex items-center text-sm';
                    benefitDiv.innerHTML = `
                        <div class="w-1.5 h-1.5 bg-yellow-500 rounded-full mr-2"></div>
                        <span class="text-gray-700">+${benefit.name}</span>
                    `;
                    nextBenefitsContainer.appendChild(benefitDiv);
                });
            }
        }
    }
    
    function updateAllContent() {
        const currentLevel = getCurrentLevel();
        const nextLevel = getNextLevel();
        const progress = getProgress();
        const remaining = getRemaining();
        

        document.getElementById('current-level-name').textContent = currentLevel;
        document.getElementById('current-level-spent').textContent = `$${userSpent} spent`;
        

        document.getElementById('next-level-name').textContent = nextLevel;
        document.getElementById('next-level-required').textContent = `$${levelRequirements[nextLevel]} required`;
        

        document.getElementById('progress-current').textContent = `Current: $${userSpent}`;
        document.getElementById('progress-target').textContent = `Target: $${levelRequirements[nextLevel]}`;
        document.getElementById('progress-bar').style.width = `${progress}%`;
        document.getElementById('progress-remaining').textContent = `$${remaining} more to unlock`;
        

        document.getElementById('current-level-icon').src = levelData[currentLevel].badge;
        document.getElementById('next-level-icon').src = levelData[nextLevel].badge;
        
        // Update current benefits from config
        updateCurrentBenefits();
        
        // Update next level benefits from config
        updateNextLevelBenefits();
    }
    
    updateAllContent();
    

    updateLevelDetails('New Account');
});
</script>

