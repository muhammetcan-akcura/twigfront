<div class="relative z-10 pb-16 md:pb-15 bg-white pt-6">
    <div class="container mx-auto px-4 relative z-10">
    {% if panelsList %}
        <div class="max-w-6xl mx-auto">
            {% if error %}
                <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6 relative">
                    <button type="button" class="absolute top-2 right-2 text-red-600 hover:text-red-800" onclick="this.parentElement.style.display='none'">&times;</button>
                    <div class="text-red-800">{{ errorMessage }}</div>
                </div>
            {% endif %}
            {% if success %}
                <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-6 relative">
                    <button type="button" class="absolute top-2 right-2 text-green-600 hover:text-green-800" onclick="this.parentElement.style.display='none'">&times;</button>
                    <div class="text-green-800">{{ successMessage }}</div>
                </div>
            {% endif %}
            {% if renew %}
                <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
                    <div class="flex justify-between items-center">
                        <div class="text-red-800">{{ renewMessage }}</div>
                        <a href="{{ renewUrl }}" class="bg-white border border-gray-300 rounded-md px-3 py-1 text-sm text-gray-700 hover:bg-gray-50" id="child-panels-renew">{{ lang('child_panel.button.renew') }}</a>
                    </div>
                </div>
            {% endif %}
            {% if restore %}
                <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
                    <div class="text-right">
                        <a href="{{ restoreUrl }}" class="bg-white border border-gray-300 rounded-md px-3 py-1 text-sm text-gray-700 hover:bg-gray-50" id="child-panels-restore">{{ lang('child_panel.button.restore') }}</a>
                    </div>
                </div>
            {% endif %}
            
            <!-- Existing Panels Card -->
            <div class="bg-white border border-gray-200 rounded-[20px] w-full mx-auto mb-8 overflow-hidden">
                <div class="px-6 md:px-8 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-semibold text-gray-800">{{ lang('child_panel.existing_panels') | default('Existing Child Panels') }}</h3>
                </div>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50/80">
                            <tr>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ lang('child_panel.domain') }}</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ lang('child_panel.status') }}</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ lang('child_panel.created') }}</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ lang('child_panel.expiry') }}</th>
                                <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">{{ lang('child_panel.action') | default('Action') }}</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            {% for panel in panelsList %}
                                <tr>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">{{ panel['domain'] }}</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                        {% set statusLower = panel['status']|lower %}
                                        {% if statusLower == 'active' %}
                                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">{{ panel['status'] }}</span>
                                        {% elseif statusLower == 'suspended' or statusLower == 'suspended' %}
                                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">{{ panel['status'] }}</span>
                                        {% elseif statusLower == 'pending' %}
                                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">{{ panel['status'] }}</span>
                                        {% else %}
                                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">{{ panel['status'] }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ panel['created'] }}</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ panel['expiry'] }}</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-right">
                                        {% if panel['admin'] %}
                                            <a href="{{ panel['admin_url'] }}" class="text-blue-600 hover:text-blue-800" target="_blank">{{ lang('child_panel.button.admin') | default('Manage') }}</a>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% endif %}
</div>
</div>
