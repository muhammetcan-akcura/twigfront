<div class="relative z-10 pb-16 md:pb-15 bg-white pt-6">
    <div class="mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Top Status Tabs & Full-Width Search Card -->
        <div class="mb-6">
            <!-- Status Filter Tabs -->
            <div class="flex items-center gap-1.5 sm:gap-2 overflow-x-auto scrollbar-hide pb-1 {% if site['rtl'] %} rtl-nav {% endif %}">
                <a href="{{ page['url'] }}" class="{% if 'all' == status %}filter-btn-active !rounded-xl{% else %}orders-status-tab text-gray-600 hover:text-blue-600 hover:bg-blue-50/70 rounded-xl{% endif %} flex items-center gap-1.5 px-3.5 py-2 text-sm font-semibold whitespace-nowrap shrink-0 transition-all">
                    <span>{{ lang('orders.all') }}</span>
                </a>
                <a href="{{ page['url'] }}/pending" class="{% if 'pending' == status %}filter-btn-active !rounded-xl{% else %}orders-status-tab text-gray-600 hover:text-blue-600 hover:bg-blue-50/70 rounded-xl{% endif %} flex items-center gap-1.5 px-3.5 py-2 text-sm font-semibold whitespace-nowrap shrink-0 transition-all">
                    <span>{{ lang('orders.status.pending') }}</span>
                </a>
                <a href="{{ page['url'] }}/inprogress" class="{% if 'inprogress' == status %}filter-btn-active !rounded-xl{% else %}orders-status-tab text-gray-600 hover:text-blue-600 hover:bg-blue-50/70 rounded-xl{% endif %} flex items-center gap-1.5 px-3.5 py-2 text-sm font-semibold whitespace-nowrap shrink-0 transition-all">
                    <span>{{ lang('orders.status.inprogress') }}</span>
                </a>
                <a href="{{ page['url'] }}/completed" class="{% if 'completed' == status %}filter-btn-active !rounded-xl{% else %}orders-status-tab text-gray-600 hover:text-blue-600 hover:bg-blue-50/70 rounded-xl{% endif %} flex items-center gap-1.5 px-3.5 py-2 text-sm font-semibold whitespace-nowrap shrink-0 transition-all">
                    <span>{{ lang('orders.status.completed') }}</span>
                </a>
                <a href="{{ page['url'] }}/partial" class="{% if 'partial' == status %}filter-btn-active !rounded-xl{% else %}orders-status-tab text-gray-600 hover:text-blue-600 hover:bg-blue-50/70 rounded-xl{% endif %} flex items-center gap-1.5 px-3.5 py-2 text-sm font-semibold whitespace-nowrap shrink-0 transition-all">
                    <span>{{ lang('orders.status.partial') }}</span>
                </a>
                <a href="{{ page['url'] }}/processing" class="{% if 'processing' == status %}filter-btn-active !rounded-xl{% else %}orders-status-tab text-gray-600 hover:text-blue-600 hover:bg-blue-50/70 rounded-xl{% endif %} flex items-center gap-1.5 px-3.5 py-2 text-sm font-semibold whitespace-nowrap shrink-0 transition-all">
                    <span>{{ lang('orders.status.processing') }}</span>
                </a>
                <a href="{{ page['url'] }}/canceled" class="{% if 'canceled' == status %}filter-btn-active !rounded-xl{% else %}orders-status-tab text-gray-600 hover:text-blue-600 hover:bg-blue-50/70 rounded-xl{% endif %} flex items-center gap-1.5 px-3.5 py-2 text-sm font-semibold whitespace-nowrap shrink-0 transition-all">
                    <span>{{ lang('orders.status.canceled') }}</span>
                </a>
            </div>

            <!-- Full-Width Search Card -->
            <div id="orders-search-card" class="mt-3 bg-white border border-gray-200 rounded-[16px] p-3 sm:p-4 shadow-sm">
                <form action="{{ page['url'] }}" method="get" id="history-search" class="w-full">
                    <div id="orders-search-group" class="flex items-stretch w-full rounded-[10px] border border-gray-200 bg-gray-50/90 focus-within:bg-white focus-within:border-blue-500 focus-within:ring-2 focus-within:ring-blue-500/15 overflow-hidden transition-all">
                        <input
                            type="text"
                            name="search"
                            value="{{ search }}"
                            placeholder="{{ lang('general.search.placeholder') }}"
                            class="flex-1 min-w-0 bg-transparent border-0 px-4 py-2.5 text-sm font-medium text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-0"
                        >
                        <button type="submit" aria-label="Search" class="w-12 sm:w-14 flex items-center justify-center btn-custom-active text-white hover:opacity-95 transition-opacity shrink-0">
                            <i class="ri-search-line text-lg"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Sticky Bulk Copy Action Bar (appears when 1+ orders selected) -->
        <div id="orders-bulk-bar" class="hidden sticky top-3 z-30 mb-4 bg-white border border-blue-200 rounded-[16px] p-3 shadow-lg transition-all">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-2.5">
                <div class="flex items-center justify-between lg:justify-start gap-3">
                    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-blue-50 text-blue-700 font-semibold text-xs sm:text-sm" id="selected-badge">
                        <i class="ri-checkbox-multiple-fill text-base"></i>
                        <span><strong id="selected-orders-count">0</strong> Selected</span>
                    </div>
                    <button type="button" id="mobile-select-all-btn" class="md:hidden inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg border border-gray-200 text-xs font-semibold text-gray-700 hover:bg-gray-50">
                        <i class="ri-check-double-line"></i>
                        <span>Select All</span>
                    </button>
                </div>

                <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
                    <span class="text-xs font-semibold text-gray-400 mr-1 hidden sm:inline">Copy:</span>
                    <button type="button" data-copy-type="id" class="bulk-copy-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs sm:text-[13px] font-semibold btn-custom-active text-white hover:opacity-95 transition">
                        <i class="ri-hashtag"></i>
                        <span>Order ID</span>
                    </button>
                    <button type="button" data-copy-type="service_id" class="bulk-copy-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs sm:text-[13px] font-semibold bg-gray-100 hover:bg-gray-200 text-gray-800 border border-gray-200 transition">
                        <i class="ri-price-tag-3-line text-blue-600"></i>
                        <span>Service ID</span>
                    </button>
                    <button type="button" data-copy-type="service_name" class="bulk-copy-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs sm:text-[13px] font-semibold bg-gray-100 hover:bg-gray-200 text-gray-800 border border-gray-200 transition">
                        <i class="ri-stack-line text-blue-600"></i>
                        <span>Service Name</span>
                    </button>
                    <button type="button" data-copy-type="link" class="bulk-copy-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs sm:text-[13px] font-semibold bg-gray-100 hover:bg-gray-200 text-gray-800 border border-gray-200 transition">
                        <i class="ri-link text-blue-600"></i>
                        <span>Link</span>
                    </button>
                    <button type="button" id="clear-selected-orders" class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl text-xs sm:text-[13px] font-semibold text-red-600 hover:bg-red-50 border border-transparent hover:border-red-200 transition ml-auto sm:ml-1" title="Clear selection">
                        <i class="ri-close-line text-base leading-none"></i>
                        <span>Clear</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Orders Table -->
        <div class="bg-white rounded-[14px] shadow-sm border border-gray-200 overflow-hidden">
            <!-- Desktop Table -->
            <div class="hidden md:block">
                <table class="w-full table-fixed orders-desktop-table {% if site['rtl'] %} rtl-table {% endif %}">
                    <colgroup>
                        <col class="col-select">
                        <col class="col-id">
                        <col class="col-link">
                        <col class="col-charge">
                        <col class="col-start">
                        <col class="col-qty">
                        <col class="col-service">
                        <col class="col-status">
                        {% if task == 1 %}<col class="col-action">{% endif %}
                    </colgroup>
                    <thead class="bg-gray-50 border-b border-gray-200">
                        <tr>
                            <th class="px-1.5 py-2 text-center">
                                <input type="checkbox" id="select-all-orders" aria-label="Select all orders" class="w-3.5 h-3.5 rounded border-gray-300 text-blue-600 focus:ring-blue-500 cursor-pointer align-middle">
                            </th>
                            <th class="px-2 xl:px-3 py-2 text-left text-[9.5px] xl:text-[10.5px] font-semibold text-gray-500 uppercase tracking-wider">{{ lang('orders.id') }}</th>
                            <th class="px-2 xl:px-3 py-2 text-left text-[9.5px] xl:text-[10.5px] font-semibold text-gray-500 uppercase tracking-wider">{{ lang('orders.link') }}</th>
                            <th class="px-2 xl:px-3 py-2 text-left text-[9.5px] xl:text-[10.5px] font-semibold text-gray-500 uppercase tracking-wider">{{ lang('orders.charge') }}</th>
                            <th class="px-2 xl:px-3 py-2 text-left text-[9.5px] xl:text-[10.5px] font-semibold text-gray-500 uppercase tracking-wider break-words">{{ lang('orders.startcount') }}</th>
                            <th class="px-2 xl:px-3 py-2 text-left text-[9.5px] xl:text-[10.5px] font-semibold text-gray-500 uppercase tracking-wider">{{ lang('orders.quantity') }}</th>
                            <th class="px-2 xl:px-3 py-2 text-left text-[9.5px] xl:text-[10.5px] font-semibold text-gray-500 uppercase tracking-wider">{{ lang('orders.service') }}</th>
                            <th class="px-2 xl:px-3 py-2 text-center text-[9.5px] xl:text-[10.5px] font-semibold text-gray-500 uppercase tracking-wider">{{ lang('orders.status') }}</th>
                            {% if task == 1 %}<th class="px-2 xl:px-3 py-2 text-center text-[9.5px] xl:text-[10.5px] font-semibold text-gray-500 uppercase tracking-wider">&nbsp;</th>{% endif %}
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200 font-medium">
                        {% for order in orderList %}
                        <tr class="order-item-row hover:bg-gray-50 transition-colors" data-row-order-id="{{ order['id'] }}">
                            <td class="px-1.5 py-2.5 text-center">
                                <input
                                    type="checkbox"
                                    class="order-select-checkbox w-3.5 h-3.5 rounded border-gray-300 text-blue-600 focus:ring-blue-500 cursor-pointer align-middle"
                                    data-order-id="{{ order['id'] }}"
                                    data-service-id="{{ order['service_id'] }}"
                                    data-service-name="{{ order['service'] }}"
                                    data-order-link="{{ order['link'] }}"
                                    aria-label="Select order {{ order['id'] }}"
                                >
                            </td>
                            <td class="px-2 xl:px-3 py-2.5 whitespace-nowrap text-[10px] xl:text-[11px] font-bold text-blue-600 truncate" title="{{ order['id'] }}">
                                {{ order['id'] }}
                            </td>
                            <td class="px-2 xl:px-3 py-2.5 text-[10px] xl:text-[11px] text-blue-600">
                                <div class="flex items-center gap-1 group min-w-0">
                                    <a href="{{ order['link'] }}" target="_blank" title="{{ order['link'] }}" class="block truncate min-w-0 hover:text-blue-800 transition-colors">{{ order['link'] }}</a>
                                    <i class="ri-external-link-line text-[11px] text-gray-400 opacity-0 group-hover:opacity-100 transition-opacity flex-shrink-0"></i>
                                </div>
                            </td>
                            <td class="px-2 xl:px-3 py-2.5 whitespace-nowrap text-[10px] xl:text-[11px] font-bold text-gray-900 truncate">{{ order['charge'] }}</td>
                            <td class="px-2 xl:px-3 py-2.5 whitespace-nowrap text-[10px] xl:text-[11px] font-medium text-gray-900 truncate">
                                {% if order['start_count'] != '' %}{{ order['start_count'] }}{% else %}<span class="text-gray-400">-</span>{% endif %}
                            </td>
                            <td class="px-2 xl:px-3 py-2.5 whitespace-nowrap text-[10px] xl:text-[11px] font-medium text-gray-900 truncate">{{ order['quantity'] }}</td>
                            <td class="px-2 xl:px-3 py-2.5 text-[10px] xl:text-[11px] font-medium text-gray-900" data-service-name="{{ order['service'] }}">
                                <div class="flex items-center gap-2 min-w-0">
                                    <i class="ri-star-fill text-[15px] xl:text-[18px] text-yellow-500 flex-shrink-0"></i>
                                    <div class="flex-1 min-w-0">
                                        <div class="leading-snug break-words" title="{{ order['service_id'] }} - {{ order['service'] }}">
                                            <span class="orders-service-badge inline-flex items-center px-1 py-[1px] text-[9.5px] xl:text-[10px] font-bold text-blue-700 bg-blue-50 border border-blue-200 rounded mr-1 align-middle">{{ order['service_id'] }}</span><span class="align-middle font-semibold text-gray-900">{{ order['service'] }}</span>
                                        </div>
                                        <div class="text-[9.5px] xl:text-[10px] text-gray-500 mt-0.5 font-normal truncate">{{ order['date'] }}</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-1.5 xl:px-2.5 py-2.5 text-center">
                                {% if order['status'] == 'Pending' %}
                                <div class="inline-flex items-center max-w-full px-2 py-0.5 bg-yellow-100 border border-yellow-400 rounded-full">
                                    <i class="ri-time-line text-yellow-700 mr-1 text-[10px] xl:text-[11px] shrink-0"></i>
                                    <span class="text-yellow-800 text-[9.5px] xl:text-[10.5px] font-semibold truncate">{{ order['status'] }}</span>
                                </div>
                                {% elseif order['status'] == 'Completed' %}
                                <div class="inline-flex items-center max-w-full px-2 py-0.5 bg-green-100 border border-green-500 rounded-full">
                                    <i class="ri-check-line text-green-700 mr-1 text-[10px] xl:text-[11px] shrink-0"></i>
                                    <span class="text-green-800 text-[9.5px] xl:text-[10.5px] font-semibold truncate">{{ order['status'] }}</span>
                                </div>
                                {% elseif order['status'] == 'In Progress' %}
                                <div class="flex flex-col items-center">
                                    <span class="text-blue-700 text-[9.5px] xl:text-[10.5px] font-semibold mb-0.5 truncate max-w-full">{{ order['status'] }}</span>
                                    <div class="w-12 xl:w-16 bg-gray-200 rounded-full h-1">
                                        <div class="bg-blue-600 h-1 rounded-full" style="width: 60%"></div>
                                    </div>
                                </div>
                                {% elseif order['status'] == 'Processing' %}
                                <div class="inline-flex items-center max-w-full px-2 py-0.5 bg-blue-100 border border-blue-500 rounded-full">
                                    <i class="ri-loader-4-line text-blue-700 mr-1 text-[10px] xl:text-[11px] shrink-0"></i>
                                    <span class="text-blue-800 text-[9.5px] xl:text-[10.5px] font-semibold truncate">{{ order['status'] }}</span>
                                </div>
                                {% elseif order['status'] == 'Partial' %}
                                <div class="inline-flex items-center max-w-full px-2 py-0.5 bg-orange-100 border border-orange-500 rounded-full">
                                    <i class="ri-pie-chart-line text-orange-700 mr-1 text-[10px] xl:text-[11px] shrink-0"></i>
                                    <div class="flex flex-col items-center leading-tight min-w-0">
                                        <span class="text-orange-800 text-[9.5px] xl:text-[10.5px] font-semibold truncate">{{ order['status'] }}</span>
                                        <span class="text-orange-800 text-[9px] xl:text-[10px] font-bold">{{ order['remains'] }}</span>
                                    </div>
                                </div>
                                {% elseif order['status'] == 'Canceled' %}
                                <div class="inline-flex items-center max-w-full px-2 py-0.5 bg-red-100 border border-red-500 rounded-full">
                                    <i class="ri-close-circle-line text-red-700 mr-1 text-[10px] xl:text-[11px] shrink-0"></i>
                                    <span class="text-red-800 text-[9.5px] xl:text-[10.5px] font-semibold truncate">{{ order['status'] }}</span>
                                </div>
                                {% else %}
                                <span class="text-gray-900 text-[9.5px] xl:text-[10.5px] font-semibold break-words">{{ order['status'] }}</span>
                                {% endif %}
                                {% if order['cancelReason'] %}<i class="fas fa-comment-alt-lines ml-1 text-[10px]" data-toggle="tooltip" data-placement="top" title="{{ order['cancelReason'] }}"></i>{% endif %}
                            </td>
                            {% if task == 1 %}
                            <td class="px-1.5 xl:px-2.5 py-2.5 whitespace-nowrap text-center text-[10px] xl:text-[10.5px] font-medium">
                                <div class="order-actions flex flex-wrap items-center justify-center gap-1">
                                    {% if order['refilling'] == 1 %}
                                        <span class="text-blue-600 text-[10px] xl:text-[10.5px]">{{ lang('orders.refilling') }}</span>
                                    {% else %}
                                        {% if order['refill'] == 1 %}
                                            <a href="{{ page['url'] }}/{{ order['id'] }}/refill" class="inline-flex items-center px-2 py-1 bg-green-600 text-white text-[10px] xl:text-[10.5px] font-medium rounded-md hover:bg-green-700 transition-colors shadow-sm">
                                                <i class="ri-refresh-line mr-1"></i>
                                                {{ lang('orders.button.refill') }}
                                            </a>
                                        {% endif %}
                                        {% if order['refillAvailableTime'] %}
                                            <button type="button" class="inline-flex items-center px-2 py-1 bg-gray-300 text-gray-600 text-[10px] xl:text-[10.5px] font-medium rounded-md cursor-not-allowed" data-toggle="tooltip" data-placement="top" title="{{ order['refillAvailableTime'] }}">
                                                <i class="ri-refresh-line mr-1"></i>
                                                {{ lang('orders.button.refill') }}
                                            </button>
                                        {% endif %}
                                        {% if order['cancel'] == 1 %}
                                            <a href="{{ page['url'] }}/{{ order['id'] }}/cancel" class="inline-flex items-center px-2 py-1 bg-red-600 text-white text-[10px] xl:text-[10.5px] font-medium rounded-md hover:bg-red-700 transition-colors shadow-sm">
                                                <i class="ri-close-line mr-1"></i>
                                                {{ lang('orders.button.cancel') }}
                                            </a>
                                        {% endif %}
                                        {% if order['hasCancelTask'] == 1 %}
                                            <span class="text-red-600 text-[10px] xl:text-[10.5px]">{{ lang('orders.cancel_requested') }}</span>
                                        {% endif %}
                                    {% endif %}
                                </div>
                            </td>
                            {% endif %}
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <!-- Mobile Cards -->
            <div class="md:hidden">
                {% for order in orderList %}
                <div class="order-item-row bg-white border border-gray-200 rounded-xl p-3 m-2 shadow-sm transition-colors" data-row-order-id="{{ order['id'] }}">
                    <!-- Select Checkbox + ID Header -->
                    <div class="flex items-center justify-between mb-2.5">
                        <label class="inline-flex items-center gap-1.5 cursor-pointer text-[11px] font-semibold text-gray-500">
                            <input
                                type="checkbox"
                                class="order-select-checkbox w-3.5 h-3.5 rounded border-gray-300 text-blue-600 focus:ring-blue-500 cursor-pointer"
                                data-order-id="{{ order['id'] }}"
                                data-service-id="{{ order['service_id'] }}"
                                data-service-name="{{ order['service'] }}"
                                data-order-link="{{ order['link'] }}"
                            >
                            <span>Select</span>
                        </label>
                        <div class="bg-blue-600 text-white text-[11px] font-bold px-2.5 py-1 rounded-full">
                            ID: {{ order['id'] }}
                        </div>
                    </div>

                    <!-- Service Name -->
                    <div class="text-center mb-2.5">
                        <h3 class="text-gray-800 font-bold text-xs leading-snug break-words">
                            <span class="orders-service-badge inline-block px-1.5 py-0.5 text-[10px] font-bold text-blue-700 bg-blue-50 border border-blue-200 rounded mr-1">{{ order['service_id'] }}</span>
                            {{ order['service'] }}
                        </h3>
                    </div>

                    <!-- Charge and Status -->
                    <div class="flex justify-center mb-2.5">
                        <div class="flex items-center border border-gray-300 px-3 py-1.5 text-xs rounded-l-[25px]">
                            <i class="ri-money-dollar-circle-line text-green-600 mr-1.5 text-sm"></i>
                            <span class="text-gray-600 font-medium">Charge:</span>
                            <span class="text-gray-900 font-bold ml-1">{{ order['charge'] }}</span>
                        </div>
                        {% if order['status'] == 'Pending' %}
                        <div class="inline-flex items-center px-2.5 py-1.5 bg-yellow-100 border border-yellow-400 text-yellow-800 rounded-r-[25px] text-xs font-semibold">
                            <i class="ri-time-line mr-1.5"></i>
                            <span>{{ order['status'] }}</span>
                        </div>
                        {% elseif order['status'] == 'Completed' %}
                        <div class="inline-flex items-center px-2.5 py-1.5 bg-green-100 border border-green-500 text-green-800 rounded-r-[25px] text-xs font-semibold">
                            <i class="ri-check-line mr-1.5"></i>
                            <span>{{ order['status'] }}</span>
                        </div>
                        {% elseif order['status'] == 'In Progress' %}
                        <div class="inline-flex items-center px-2.5 py-1.5 bg-blue-100 border border-blue-500 text-blue-800 rounded-r-[25px] text-xs font-semibold">
                            <i class="ri-loader-4-line mr-1.5"></i>
                            <span>{{ order['status'] }}</span>
                        </div>
                        {% elseif order['status'] == 'Processing' %}
                        <div class="inline-flex items-center px-2.5 py-1.5 bg-indigo-100 border border-indigo-500 text-indigo-800 rounded-r-[25px] text-xs font-semibold">
                            <i class="ri-settings-3-line mr-1.5"></i>
                            <span>{{ order['status'] }}</span>
                        </div>
                        {% elseif order['status'] == 'Partial' %}
                        <div class="inline-flex items-center px-2.5 py-1.5 bg-orange-100 border border-orange-500 text-orange-800 rounded-r-[25px] text-xs font-semibold">
                            <i class="ri-pie-chart-line mr-1.5"></i>
                            <span>{{ order['status'] }}</span>
                        </div>
                        {% elseif order['status'] == 'Canceled' %}
                        <div class="inline-flex items-center px-2.5 py-1.5 bg-red-100 border border-red-500 text-red-800 rounded-r-[25px] text-xs font-semibold">
                            <i class="ri-close-circle-line mr-1.5"></i>
                            <span>{{ order['status'] }}</span>
                        </div>
                        {% endif %}
                    </div>

                    <!-- Details Grid: Start, Remains, Date, Quantity -->
                    <div class="border-t border-gray-200 pt-2.5 space-y-2.5">
                        <div class="grid grid-cols-2 gap-2.5">
                            <div class="flex items-center gap-2 text-gray-700">
                                <i class="ri-play-line text-sm text-gray-500"></i>
                                <div>
                                    <div class="text-[11px] text-gray-600 font-medium">Start</div>
                                    <div class="font-bold text-gray-900 text-xs">{% if order['start_count'] != '' %}{{ order['start_count'] }}{% else %}-{% endif %}</div>
                                </div>
                            </div>
                            <div class="flex items-center gap-2 text-gray-700">
                                <i class="ri-pie-chart-line text-sm text-gray-500"></i>
                                <div>
                                    <div class="text-[11px] text-gray-600 font-medium">Remains</div>
                                    <div class="font-bold text-gray-900 text-xs">{% if order['remains'] != '' %}{{ order['remains'] }}{% else %}-{% endif %}</div>
                                </div>
                            </div>
                        </div>
                        <div class="grid grid-cols-2 gap-2.5">
                            <div class="flex items-center gap-2 text-gray-700">
                                <i class="ri-calendar-2-line text-sm text-gray-500"></i>
                                <div>
                                    <div class="text-[11px] text-gray-600 font-medium">Date</div>
                                    <div class="font-bold text-gray-900 text-[11px]">{{ order['date'] }}</div>
                                </div>
                            </div>
                            <div class="flex items-center gap-2 text-gray-700">
                                <i class="ri-hashtag text-sm text-gray-500"></i>
                                <div>
                                    <div class="text-[11px] text-gray-600 font-medium">Quantity</div>
                                    <div class="font-bold text-gray-900 text-xs">{{ order['quantity'] }}</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Link -->
                    <div class="border-t border-gray-200 pt-2.5 mt-2.5">
                        <div class="flex items-start gap-2 text-gray-700">
                            <i class="ri-link text-sm text-gray-500 mt-0.5"></i>
                            <div class="min-w-0 flex-1">
                                <div class="text-[11px] text-gray-600 font-medium">Link</div>
                                <a href="{{ order['link'] }}" target="_blank" class="text-blue-600 text-xs break-all font-medium hover:underline">{{ order['link'] }}</a>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    {% if task == 1 and (order['refilling'] == 1 or order['refill'] == 1 or order['cancel'] == 1 or order['hasCancelTask'] == 1) %}
                    <div class="border-t border-gray-200 pt-2.5 mt-2.5 flex gap-2">
                        {% if order['refilling'] == 1 %}
                            <span class="flex-1 text-center bg-blue-100 text-blue-800 px-3 py-1.5 rounded-lg font-semibold text-xs">{{ lang('orders.refilling') }}</span>
                        {% else %}
                            {% if order['refill'] == 1 %}
                                <a href="{{ page['url'] }}/{{ order['id'] }}/refill" class="flex-1 text-center bg-green-600 border border-green-600 text-white px-3 py-1.5 rounded-lg font-semibold hover:bg-green-700 text-xs transition">
                                    {{ lang('orders.button.refill') }}
                                </a>
                            {% endif %}
                            {% if order['cancel'] == 1 %}
                                <a href="{{ page['url'] }}/{{ order['id'] }}/cancel" class="flex-1 text-center bg-red-600 border border-red-600 text-white px-3 py-1.5 rounded-lg font-semibold hover:bg-red-700 text-xs transition">
                                    {{ lang('orders.button.cancel') }}
                                </a>
                            {% endif %}
                            {% if order['hasCancelTask'] == 1 %}
                                <span class="flex-1 text-center bg-red-100 text-red-700 px-3 py-1.5 rounded-lg font-semibold text-xs">{{ lang('orders.cancel_requested') }}</span>
                            {% endif %}
                        {% endif %}
                    </div>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
        </div>

        <!-- Pagination -->
        {% if pagination['count'] > 100 %}
            {% if searchList %}
                {% set params = {} %}
                {% for search in searchList %}
                    {% set params = params | merge([search['name'] ~ '=' ~ search['value']]) %}
                {% endfor %}
                {% set params = '?' ~ params|join('&') %}
            {% endif %}
            <div class="flex justify-center mt-8">
                <ul class="inline-flex items-center space-x-1 {% if site['rtl'] %} rtl-pagination {% endif %}">
                    {% if pagination['current'] != 1 %}
                        <li>
                            <a href="{{ page['url'] }}/{{ status }}/{{ pagination['last'] }}{{ params }}" class="inline-flex items-center px-3 py-2 text-sm font-medium text-gray-500 bg-white border border-gray-300 rounded-l-lg hover:bg-gray-100 hover:text-gray-700">
                                <span aria-hidden="true">&laquo;</span>
                            </a>
                        </li>
                    {% endif %}

                    {% set r, l = 3, 3 %}
                    {% if pagination['current'] == 1 %}
                        {% set r = 6 %}
                    {% endif %}
                    {% if pagination['current'] == 2 %}
                        {% set r = 5 %}
                    {% endif %}
                    {% if pagination['current'] >= pagination['pages'] %}
                        {% set l = 5 %}
                    {% endif %}

                    {% for i in 1..ceil(pagination['pages']) %}
                        {% if i >= (pagination['current']-l) and i <= (pagination['current']+r) %}
                            <li>
                                <a href="{{ page['url'] }}/{{ status }}/{{ i }}{{ params }}" class="inline-flex items-center px-3 py-2 text-sm font-medium {% if i == pagination['current'] %}text-blue-600 bg-blue-50 border border-blue-300{% else %}text-gray-500 bg-white border border-gray-300 hover:bg-gray-100 hover:text-gray-700{% endif %}">
                                    {{ i }}
                                </a>
                            </li>
                        {% endif %}
                    {% endfor %}

                    {% if pagination['current'] < pagination['pages'] %}
                        <li>
                            <a href="{{ page['url'] }}/{{ status }}/{{ pagination['next'] }}{{ params }}" class="inline-flex items-center px-3 py-2 text-sm font-medium text-gray-500 bg-white border border-gray-300 rounded-r-lg hover:bg-gray-100 hover:text-gray-700">
                                <span aria-hidden="true">&raquo;</span>
                            </a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        {% endif %}
    </div>
</div>

<script>
    function writeTextToClipboard(text, successMsg) {
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(function() {
                showNotification(successMsg, 'success');
            }).catch(function() {
                fallbackCopyText(text, successMsg);
            });
        } else {
            fallbackCopyText(text, successMsg);
        }
    }

    function fallbackCopyText(text, successMsg) {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.focus();
        ta.select();
        try {
            document.execCommand('copy');
            showNotification(successMsg, 'success');
        } catch (err) {
            showNotification('Copy failed', 'error');
        }
        document.body.removeChild(ta);
    }

    function showNotification(message, type = 'success') {
        const existingNotifications = document.querySelectorAll('.notification');
        existingNotifications.forEach(notification => notification.remove());

        const notification = document.createElement('div');
        notification.className = `notification fixed top-4 right-4 z-[99999] px-4 py-3 rounded-xl shadow-lg transform transition-all duration-300 translate-x-full ${
            type === 'success' ? 'bg-green-600 text-white' : 'bg-red-600 text-white'
        }`;
        notification.innerHTML = `
            <div class="flex items-center gap-2 font-medium text-sm">
                <i class="ri-${type === 'success' ? 'check-line' : 'close-line'} text-lg"></i>
                <span>${message}</span>
            </div>
        `;

        document.body.appendChild(notification);

        setTimeout(() => {
            notification.classList.remove('translate-x-full');
        }, 10);

        setTimeout(() => {
            notification.classList.add('translate-x-full');
            setTimeout(() => {
                if (notification.parentNode) {
                    notification.parentNode.removeChild(notification);
                }
            }, 300);
        }, 2500);
    }

    function getRemixIconForCategory(categoryName) {
        categoryName = categoryName.toLowerCase();
        if (categoryName.includes('instagram')) {
            return { icon: 'ri-instagram-line', color: 'text-pink-500' };
        } else if (categoryName.includes('facebook')) {
            return { icon: 'ri-facebook-box-fill', color: 'text-blue-600' };
        } else if (categoryName.includes('twitter') || categoryName.includes(' x ')) {
            return { icon: 'ri-twitter-x-line', color: 'text-gray-900' };
        } else if (categoryName.includes('tiktok')) {
            return { icon: 'ri-tiktok-fill', color: 'text-gray-900' };
        } else if (categoryName.includes('telegram')) {
            return { icon: 'ri-telegram-fill', color: 'text-sky-500' };
        } else if (categoryName.includes('youtube')) {
            return { icon: 'ri-youtube-fill', color: 'text-red-600' };
        } else if (categoryName.includes('spotify')) {
            return { icon: 'ri-spotify-fill', color: 'text-green-500' };
        } else if (categoryName.includes('linkedin')) {
            return { icon: 'ri-linkedin-box-fill', color: 'text-blue-700' };
        } else if (categoryName.includes('twitch')) {
            return { icon: 'ri-twitch-fill', color: 'text-purple-600' };
        } else if (categoryName.includes('discord')) {
            return { icon: 'ri-discord-fill', color: 'text-indigo-500' };
        }
        return { icon: 'ri-star-fill', color: 'text-yellow-500' };
    }

    document.addEventListener('DOMContentLoaded', function() {
        // Set service icons
        const serviceCells = document.querySelectorAll('[data-service-name]');
        serviceCells.forEach(cell => {
            const serviceName = cell.getAttribute('data-service-name');
            const iconElement = cell.querySelector('i');
            if (iconElement && serviceName) {
                const iconData = getRemixIconForCategory(serviceName);
                iconElement.className = `${iconData.icon} text-[15px] xl:text-[18px] flex-shrink-0 ${iconData.color}`;
            }
        });

        // Multi-Select Orders & Bulk Copy Logic
        const selectedOrders = new Map(); // orderId -> { id, serviceId, serviceName, link }
        const selectAllCheckbox = document.getElementById('select-all-orders');
        const mobileSelectAllBtn = document.getElementById('mobile-select-all-btn');
        const bulkBar = document.getElementById('orders-bulk-bar');
        const countEl = document.getElementById('selected-orders-count');
        const clearBtn = document.getElementById('clear-selected-orders');
        const desktopCheckboxes = Array.from(document.querySelectorAll('.orders-desktop-table .order-select-checkbox'));
        const allCheckboxes = Array.from(document.querySelectorAll('.order-select-checkbox'));
        let lastClickedDesktopIdx = -1;

        // Collect unique order metadata in page order
        const pageOrders = [];
        const seenIds = new Set();
        allCheckboxes.forEach(cb => {
            const id = cb.getAttribute('data-order-id');
            if (id && !seenIds.has(id)) {
                seenIds.add(id);
                pageOrders.push({
                    id: id,
                    serviceId: cb.getAttribute('data-service-id') || '',
                    serviceName: cb.getAttribute('data-service-name') || '',
                    link: cb.getAttribute('data-order-link') || ''
                });
            }
        });

        function syncSelectionUI() {
            const count = selectedOrders.size;
            if (countEl) countEl.textContent = count;

            if (bulkBar) {
                bulkBar.classList.toggle('hidden', count === 0);
            }

            // Sync all checkboxes & row highlights (desktop + mobile)
            allCheckboxes.forEach(cb => {
                const id = cb.getAttribute('data-order-id');
                const isSelected = selectedOrders.has(id);
                cb.checked = isSelected;
                const row = cb.closest('.order-item-row');
                if (row) {
                    row.classList.toggle('order-row-selected', isSelected);
                }
            });

            // Sync Select All checkbox state
            if (selectAllCheckbox) {
                const total = pageOrders.length;
                selectAllCheckbox.checked = total > 0 && count === total;
                selectAllCheckbox.indeterminate = count > 0 && count < total;
            }
        }

        function setOrderSelected(orderObj, shouldSelect) {
            if (!orderObj || !orderObj.id) return;
            if (shouldSelect) {
                selectedOrders.set(orderObj.id, orderObj);
            } else {
                selectedOrders.delete(orderObj.id);
            }
        }

        allCheckboxes.forEach(cb => {
            cb.addEventListener('click', function(e) {
                const id = cb.getAttribute('data-order-id');
                const shouldSelect = cb.checked;
                const desktopIdx = desktopCheckboxes.indexOf(cb);

                // Shift + Click range selection on desktop table
                if (e.shiftKey && desktopIdx !== -1 && lastClickedDesktopIdx !== -1) {
                    const start = Math.min(lastClickedDesktopIdx, desktopIdx);
                    const end = Math.max(lastClickedDesktopIdx, desktopIdx);
                    for (let i = start; i <= end; i++) {
                        const rangeId = desktopCheckboxes[i].getAttribute('data-order-id');
                        const item = pageOrders.find(o => o.id === rangeId);
                        setOrderSelected(item, shouldSelect);
                    }
                } else {
                    const item = pageOrders.find(o => o.id === id);
                    setOrderSelected(item, shouldSelect);
                }

                if (desktopIdx !== -1) {
                    lastClickedDesktopIdx = desktopIdx;
                }

                syncSelectionUI();
            });
        });

        if (selectAllCheckbox) {
            selectAllCheckbox.addEventListener('change', function() {
                const shouldSelect = selectAllCheckbox.checked;
                pageOrders.forEach(item => setOrderSelected(item, shouldSelect));
                syncSelectionUI();
            });
        }

        if (mobileSelectAllBtn) {
            mobileSelectAllBtn.addEventListener('click', function() {
                const allSelected = selectedOrders.size === pageOrders.length;
                pageOrders.forEach(item => setOrderSelected(item, !allSelected));
                syncSelectionUI();
            });
        }

        if (clearBtn) {
            clearBtn.addEventListener('click', function() {
                selectedOrders.clear();
                syncSelectionUI();
            });
        }

        // Bulk Copy Buttons
        document.querySelectorAll('.bulk-copy-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                if (selectedOrders.size === 0) return;
                const copyType = btn.getAttribute('data-copy-type');
                // Preserve page row order when copying
                const orderedItems = pageOrders.filter(o => selectedOrders.has(o.id));
                let textToCopy = '';
                let label = '';

                if (copyType === 'id') {
                    textToCopy = orderedItems.map(o => o.id).join(', ');
                    label = `${orderedItems.length} Order ID copied`;
                } else if (copyType === 'service_id') {
                    const uniqueServiceIds = Array.from(new Set(orderedItems.map(o => o.serviceId).filter(Boolean)));
                    textToCopy = uniqueServiceIds.join(', ');
                    label = `${uniqueServiceIds.length} Service ID copied`;
                } else if (copyType === 'service_name') {
                    const uniqueNames = Array.from(new Set(orderedItems.map(o => o.serviceName).filter(Boolean)));
                    textToCopy = uniqueNames.join('\n');
                    label = `${uniqueNames.length} Service Name copied`;
                } else if (copyType === 'link') {
                    textToCopy = orderedItems.map(o => o.link).filter(Boolean).join('\n');
                    label = `${orderedItems.length} Link copied`;
                }

                if (textToCopy) {
                    writeTextToClipboard(textToCopy, label);
                }
            });
        });
    });
</script>

<style>
.scrollbar-hide::-webkit-scrollbar {
    display: none;
}
.scrollbar-hide {
    scrollbar-width: none;
    -ms-overflow-style: none;
}

