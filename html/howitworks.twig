             <script>
    document.addEventListener('DOMContentLoaded', function() {
        const steps = document.querySelectorAll('.how-it-works-stepper-container .how-it-works-step');
        const stepPanes = document.querySelectorAll('.how-it-works-content-container .how-it-works-step-pane');

        function activateStep(stepNumber) {
            // Update active step in stepper
            steps.forEach(s => {
                s.classList.toggle('active', s.dataset.step === stepNumber);
            });

            // Update active content pane
            stepPanes.forEach(pane => {
                pane.classList.toggle('active', pane.id === `step-content-${stepNumber}`);
            });
        }

        steps.forEach(step => {
            step.addEventListener('click', () => {
                activateStep(step.dataset.step);
            });
        });

        // Custom Select Dropdown
        const selectWrapper = document.querySelector('.how-it-works-custom-select-wrapper');
        if (selectWrapper) {
            const trigger = selectWrapper.querySelector('.how-it-works-custom-select-trigger');
            const options = selectWrapper.querySelector('.how-it-works-custom-options');
            const selectedDisplay = trigger.querySelector('.how-it-works-selected-option');

            trigger.addEventListener('click', () => {
                options.classList.toggle('open');
                trigger.querySelector('.how-it-works-dropdown-arrow').classList.toggle('rotate-180');
            });

            options.querySelectorAll('.how-it-works-custom-option').forEach(option => {
                option.addEventListener('click', () => {
                    selectedDisplay.innerHTML = option.innerHTML;
                    options.classList.remove('open');
                    trigger.querySelector('.how-it-works-dropdown-arrow').classList.remove('rotate-180');
                });
            });

            window.addEventListener('click', (e) => {
                if (!selectWrapper.contains(e.target)) {
                    options.classList.remove('open');
                    trigger.querySelector('.how-it-works-dropdown-arrow').classList.remove('rotate-180');
                }
            });
        }
        
        // Range Slider
        const sliderContainer = document.querySelector('.how-it-works-range-slider-container');
        if (sliderContainer) {
            const thumb = document.getElementById('range-slider-thumb');
            const track = sliderContainer.querySelector('.how-it-works-range-slider-track');
            const valueDisplay = document.getElementById('range-value');
            const min = 1;
            const max = 100;

            const updateSlider = (clientX) => {
                const rect = sliderContainer.getBoundingClientRect();
                let percent = (clientX - rect.left) / rect.width;
                percent = Math.max(0, Math.min(1, percent));

                const value = Math.round(min + percent * (max - min));
                const newLeft = percent * 100;

                thumb.style.left = `calc(${newLeft}% - 12px)`;
                track.style.width = `${newLeft}%`;
                valueDisplay.textContent = value;
            }
            
            let isDragging = false;

            const onDragStart = (e) => {
                isDragging = true;
                thumb.style.cursor = 'grabbing';
                document.body.style.cursor = 'grabbing';
            };

            const onDragEnd = () => {
                isDragging = false;
                thumb.style.cursor = 'grab';
                document.body.style.cursor = 'default';
            };

            const onDrag = (e) => {
                if (isDragging) {
                    const clientX = e.touches ? e.touches[0].clientX : e.clientX;
                    updateSlider(clientX);
                }
            };
            
            thumb.addEventListener('mousedown', onDragStart);
            document.addEventListener('mouseup', onDragEnd);
            document.addEventListener('mousemove', onDrag);

            thumb.addEventListener('touchstart', onDragStart);
            document.addEventListener('touchend', onDragEnd);
            document.addEventListener('touchmove', onDrag);

            sliderContainer.addEventListener('click', (e) => {
                updateSlider(e.clientX);
            });
            
            // Set initial position
            const initialValue = 50;
            const initialPercent = (initialValue - min) / (max - min);
            thumb.style.left = `calc(${initialPercent * 100}% - 12px)`;
            track.style.width = `${initialPercent * 100}%`;
            valueDisplay.textContent = initialValue;
        }

        // Order Status Tracker
        const statusTabsContainer = document.querySelector('.how-it-works-status-tabs');
        if (statusTabsContainer) {
            const tabs = statusTabsContainer.querySelectorAll('.how-it-works-status-tab');
            const panelsContainer = document.querySelector('.how-it-works-status-content-panels');
            const panels = document.querySelectorAll('.how-it-works-status-panel');

            function positionArrow(activeTab) {
                if (!activeTab || !panelsContainer) return;

                panelsContainer.style.removeProperty('--arrow-top');
                panelsContainer.style.removeProperty('--arrow-left');

                const panelContainerRect = panelsContainer.getBoundingClientRect();
                const tabRect = activeTab.getBoundingClientRect();

                if (window.matchMedia('(max-width: 768px)').matches) {
                    const xPosition = (tabRect.left - panelContainerRect.left) + (tabRect.width / 2);
                    panelsContainer.style.setProperty('--arrow-left', `${xPosition}px`);
                } else {
                    const yPosition = (tabRect.top - panelContainerRect.top) + (tabRect.height / 2);
                    panelsContainer.style.setProperty('--arrow-top', `${yPosition}px`);
                }
            }

            tabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    const target = tab.dataset.tab;

                    tabs.forEach(t => t.classList.remove('active'));
                    panels.forEach(p => p.classList.remove('active'));

                    tab.classList.add('active');
                    document.getElementById(target).classList.add('active');
                    positionArrow(tab);
                });
            });
            
            const initialActiveTab = document.querySelector('.how-it-works-status-tab.active');
            if (initialActiveTab) {
                setTimeout(() => positionArrow(initialActiveTab), 50);
            }

            window.addEventListener('resize', () => {
                const currentActiveTab = document.querySelector('.how-it-works-status-tab.active');
                if (currentActiveTab) {
                    positionArrow(currentActiveTab);
                }
            });
        }

        // Initialize with the first step
        activateStep('1');
    });
    </script>

