<div class="relative z-10 pb-16 md:pb-15 bg-white pt-6">
    <div class="container mx-auto px-4 relative z-10">

        {% if childpanel %}
            <div class="bg-white border border-gray-200 rounded-[20px] w-full mx-auto mb-6 overflow-hidden">
                <div class="p-6 md:p-8 {% if site['rtl'] %}rtl-content{% endif %}">
                    {{ childpanel }}
                </div>
            </div>
        {% endif %}

        {% if name_servers %}
            <div class="bg-white border border-gray-200 rounded-[20px] w-full mx-auto mb-6 p-4 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <div class="flex flex-col sm:flex-row sm:items-center gap-3">
                    <div class="flex items-center bg-blue-50 rounded-full px-4 py-2 text-sm">
                        <i class="ri-global-line text-blue-600 mr-2"></i>
                        <span class="text-blue-600 font-semibold">{{ lang('child_panel.form.ns.info') }}</span>
                    </div>
                    <div class="flex flex-col sm:flex-row sm:items-center gap-2 text-sm">
                        {% for ns in name_servers %}
                            {% if loop.index > 1 %}
                                <span class="hidden sm:inline text-gray-400">/</span>
                            {% endif %}
                            <div class="flex items-center">
                                <span class="font-semibold text-gray-800">{{ ns }}</span>
                                <button class="copy-btn ml-2 text-blue-500 hover:text-blue-600 transition-colors" data-copy-text="{{ ns }}" title="Copy"><i class="ri-file-copy-line"></i></button>
                            </div>
                        {% endfor %}
                    </div>
                </div>
                <div class="w-full md:w-auto">
                    <a href="#!" id="how-to-connect-btn" class="bg-blue-600 text-white font-bold py-3 px-5 rounded-[25px] hover:bg-blue-700 flex items-center justify-center text-sm w-full md:w-auto">
                        <span>How to connect my domain?</span>
                        <i class="ri-arrow-right-s-line ml-2"></i>
                    </a>
                </div>
            </div>
        {% endif %}

        {% if showForm %}
            <!-- Child Panel Order Form -->
            <div class="bg-white border border-gray-200 rounded-[20px] w-full mx-auto mb-8 overflow-hidden">
                <div class="p-6 md:p-8">
                    <div class="flex items-center mb-6">
                        <div class="bg-blue-100 text-blue-500 rounded-full w-10 h-10 flex items-center justify-center mr-4">
                            <i class="ri-store-2-line text-xl"></i>
                        </div>
                        <h2 class="text-lg font-bold text-gray-800">Child Panel Order</h2>
                    </div>

                    <form action="{{ page['url'] }}" method="post">
                        {% if errorForm %}
                            <div class="bg-red-50 border border-red-200 rounded-[15px] p-4 mb-6 {% if site['rtl'] %}rtl-alert{% endif %}">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center">
                                        <i class="ri-error-warning-line text-red-500 mr-3 text-xl"></i>
                                        <div class="text-red-700">{{ errorFormMessage }}</div>
                                    </div>
                                    <button type="button" class="text-red-400 hover:text-red-600 transition-colors" onclick="this.parentElement.parentElement.parentElement.remove()">
                                        <i class="ri-close-line text-xl"></i>
                                    </button>
                                </div>
                            </div>
                        {% endif %}

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                            <div>
                                <label for="domain" class="block text-sm font-medium text-gray-700 mb-2">{{ lang('child_panel.form.domain') }}</label>
                                <input type="text" id="domain" name="CreateOrderForm[domain]" placeholder="example.com" value="{{ form['domain'] }}" class="w-full px-4 py-3 bg-white border border-gray-200 rounded-[15px] focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-300">
                            </div>
                            <div>
                                <label for="createorderform-currency" class="block text-sm font-medium text-gray-700 mb-2">{{ lang('child_panel.form.currency') }}</label>
                                <div class="relative" id="custom-select-wrapper">
                                    <button type="button" class="w-full px-4 py-3 bg-white border border-gray-200 rounded-[15px] text-left focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-300 flex justify-between items-center">
                                        <span id="selected-option-text">
                                            {% set displayedCurrency = false %}
                                            {% for currency in currenciesList %}
                                                {% if form['currency'] == currency['code'] %}
                                                    {{ currency['name'] }}
                                                    {% set displayedCurrency = true %}
                                                {% endif %}
                                            {% endfor %}
                                            {% if not displayedCurrency and currenciesList|length > 0 %}
                                                {{ currenciesList[0]['name'] }}
                                            {% endif %}
                                        </span>
                                        <i class="ri-arrow-down-s-line h-5 w-5 text-gray-400"></i>
                                    </button>
                                    <div id="custom-select-dropdown" class="absolute z-10 w-full mt-1 bg-white border border-gray-200 rounded-[15px] shadow-lg hidden">
                                        <div class="p-2">
                                            <input type="text" id="search-input" placeholder="Search..." class="w-full px-3 py-2 border border-gray-200 rounded-[15px] focus:outline-none focus:ring-1 focus:ring-blue-500">
                                        </div>
                                        <ul id="custom-options-list" class="max-h-60 overflow-y-auto">
                                            {% for currency in currenciesList %}
                                                <li data-value="{{ currency['code'] }}" class="px-4 py-2 hover:bg-gray-100 cursor-pointer">{{ currency['name'] }}</li>
                                            {% endfor %}
                                        </ul>
                                    </div>
                                </div>
                                <select id="createorderform-currency" name="CreateOrderForm[currency]" aria-required="true" class="hidden w-full px-4 py-3 bg-white border border-gray-200 rounded-[15px] focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-300">
                                    {% for currency in currenciesList %}
                                        <option value="{{ currency['code'] }}" {% if form['currency'] == currency['code'] or (not form['currency'] and loop.first) %}selected{% endif %}>{{ currency['name'] }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>

                        <div class="mb-6">
                            <label for="createorderform-username" class="block text-sm font-medium text-gray-700 mb-2">{{ lang('child_panel.form.username') }}</label>
                            <input type="text" id="createorderform-username" name="CreateOrderForm[username]" aria-required="true" value="{{ form['username'] }}" placeholder="Enter your admin username" class="w-full px-4 py-3 bg-white border border-gray-200 rounded-[15px] focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-300">
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                            <div class="relative">
                                <label for="createorderform-password" class="block text-sm font-medium text-gray-700 mb-2">{{ lang('child_panel.form.password') }}</label>
                                <input type="password" id="createorderform-password" name="CreateOrderForm[password]" aria-required="true" placeholder="Enter your admin password" class="w-full px-4 py-3 bg-white border border-gray-200 rounded-[15px] focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-300 pr-10">
                                <i class="ri-eye-line absolute top-1/2 right-3 -translate-y-1/2 mt-3 cursor-pointer text-gray-400 toggle-password"></i>
                            </div>
                            <div class="relative">
                                <label for="createorderform-password_confirm" class="block text-sm font-medium text-gray-700 mb-2">{{ lang('child_panel.form.confirm') }}</label>
                                <input type="password" id="createorderform-password_confirm" name="CreateOrderForm[password_confirm]" aria-required="true" placeholder="Confirm your admin password" class="w-full px-4 py-3 bg-white border border-gray-200 rounded-[15px] focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-300 pr-10">
                                <i class="ri-eye-line absolute top-1/2 right-3 -translate-y-1/2 mt-3 cursor-pointer text-gray-400 toggle-password"></i>
                            </div>
                        </div>

                        <div class="mt-8 pt-8 border-t border-gray-200">
                            <div class="bg-white rounded-[25px] px-4 py-4 flex flex-col md:flex-row md:items-center md:justify-between gap-4 md:gap-0 md:h-[70px] border border-gray-200">
                                <div class="flex items-center">
                                    <div class="bg-blue-100 text-blue-600 rounded-full w-12 h-12 flex items-center justify-center">
                                        <i class="ri-shopping-bag-3-line text-xl"></i>
                                    </div>
                                    <div class="ml-4">
                                        <span class="font-semibold text-gray-900">{{ lang('child_panel.form.price') }}</span>
                                        <span class="text-gray-500"> {{ price }}</span>
                                    </div>
                                </div>
                                <input type="hidden" name="_csrf" value="{{ csrftoken }}">
                                <button type="submit" class="bg-blue-600 text-white font-bold py-2.5 px-6 rounded-[25px] hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 flex items-center justify-center gap-2 w-full md:w-auto">
                                    <span>{{ lang('child_panel.form.submit') }}</span>
                                    <i class="ri-arrow-right-s-line text-xl"></i>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        {% endif %}

        <!-- FAQ -->
        <div class="bg-white border border-gray-200 rounded-[20px] w-full mx-auto mb-8 overflow-hidden">
            <div class="px-6 md:px-8 py-4 border-b border-gray-200">
                <h3 class="text-lg font-semibold text-gray-800">Frequently Asked Questions</h3>
            </div>
     
                  <div id="faq-container">
                      <!-- FAQ Item 1 -->
                      <div class="border-b border-gray-200/80">
                          <button class="w-full p-5 text-left flex items-center text-gray-800 font-semibold focus:outline-none">
                               <div class="w-7 h-7 mr-4 rounded-full border-2 border-gray-300 flex items-center justify-center flex-shrink-0">
                                  <i class="ri-add-line text-lg text-gray-500"></i>
                              </div>
                              <span>What is a child panel?</span>
                          </button>
                          <div class="overflow-hidden max-h-0" style="transition: max-height 0.4s ease-in-out;">
                              <div class="p-5 pl-16 text-gray-600 text-sm">
                                  <p>A child panel is a smaller, separate panel that you can rent from us to sell services to your own customers. It connects to our main panel for service delivery but allows you to have your own branding and user base.</p>
                              </div>
                          </div>
                      </div>
                      <!-- FAQ Item 2 -->
                      <div class="border-b border-gray-200/80">
                          <button class="w-full p-5 text-left flex items-center text-gray-800 font-semibold focus:outline-none">
                               <div class="w-7 h-7 mr-4 rounded-full border-2 border-gray-300 flex items-center justify-center flex-shrink-0">
                                  <i class="ri-add-line text-lg text-gray-500"></i>
                              </div>
                              <span>How do I pay for the panel rental?</span>
                          </button>
                          <div class="overflow-hidden max-h-0" style="transition: max-height 0.4s ease-in-out;">
                               <div class="p-5 pl-16 text-gray-600 text-sm">
                                  <p>The monthly rental fee of $30.00 is automatically deducted from your main account balance on our platform. Please ensure you maintain a sufficient balance to avoid any disruption to your service.</p>
                              </div>
                          </div>
                      </div>
                      <!-- FAQ Item 3 -->
                      <div class="border-b border-gray-200/80">
                          <button class="w-full p-5 text-left flex items-center text-gray-800 font-semibold focus:outline-none">
                               <div class="w-7 h-7 mr-4 rounded-full border-2 border-gray-300 flex items-center justify-center flex-shrink-0">
                                  <i class="ri-add-line text-lg text-gray-500"></i>
                              </div>
                              <span>Can I use my own domain?</span>
                          </button>
                          <div class="overflow-hidden max-h-0" style="transition: max-height 0.4s ease-in-out;">
                               <div class="p-5 pl-16 text-gray-600 text-sm">
                                 <p>Yes, you must use your own domain. You will need to point your domain's nameservers to ns1.perfectdns.com and ns2.perfectdns.com. This allows your domain to display your child panel.</p>
                              </div>
                          </div>
                      </div>
                      <!-- FAQ Item 4 -->
                      <div>
                          <button class="w-full p-5 text-left flex items-center text-gray-800 font-semibold focus:outline-none">
                               <div class="w-7 h-7 mr-4 rounded-full border-2 border-gray-300 flex items-center justify-center flex-shrink-0">
                                  <i class="ri-add-line text-lg text-gray-500"></i>
                              </div>
                              <span>Is there a contract or commitment?</span>
                          </button>
                          <div class="overflow-hidden max-h-0" style="transition: max-height 0.4s ease-in-out;">
                              <div class="p-5 pl-16 text-gray-600 text-sm">
                                  <p>No, our child panel service is month-to-month. You can cancel at any time without any long-term commitment. The service will remain active until the end of your current paid billing period.</p>
                              </div>
                          </div>
                      </div>
                  </div>
         
          </div>

        <!-- Child Panel Rules -->
        <div class="bg-white border border-gray-200 rounded-[20px] w-full mx-auto mb-8 overflow-hidden">
            <div class="px-6 md:px-8 py-4 border-b border-gray-200">
                <h2 class="text-lg font-semibold text-gray-800">Child Panel Rules</h2>
            </div>
            <div class="p-6 md:p-8">
                <ul class="list-disc list-inside space-y-3 text-gray-700 text-sm">
                    <li>Child panels are intended for resale purposes only. You are responsible for managing and supporting your own clientele.</li>
                    <li>Any form of fraudulent activity, spam, or abuse conducted through the child panel will result in immediate suspension and potential termination of your account.</li>
                    <li>The monthly rental fee is automatically deducted from your account balance. Ensure you have sufficient funds to avoid service interruption.</li>
                    <li>We are responsible for the main panel's functionality; however, you are responsible for any customizations or third-party integrations you add.</li>
                    <li>We reserve the right to update the terms of service, features, and pricing for child panels with prior notice.</li>
                </ul>
            </div>
        </div>

    </div>
</div>

<div id="nameserver-modal" class="fixed inset-0 bg-gray-900 bg-opacity-75 flex items-center justify-center z-[99999] hidden transition-opacity duration-300 ease-in-out">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-lg p-8 relative transform scale-95 transition-transform duration-300 ease-in-out">
        <button id="close-modal-btn" class="absolute top-5 right-5 text-gray-400 hover:text-gray-600 transition-colors">
            <i class="ri-close-line text-3xl"></i>
        </button>
        <div class="flex items-center mb-6">
            <div class="bg-blue-100 text-blue-500 rounded-full w-12 h-12 flex items-center justify-center mr-4">
                <i class="ri-server-line text-2xl"></i>
            </div>
            <h3 class="text-xl font-bold text-gray-800">How to Connect Your Domain</h3>
        </div>
        <p class="text-gray-600 mb-5">
            To connect your domain, you need to change its nameservers at your domain registrar (the company you bought the domain from). Please update them to the following:
        </p>
        <div class="space-y-3">
            <div class="bg-gray-100 rounded-lg p-4">
                <p class="font-mono text-gray-800 text-center tracking-wider">ns1.perfectdns.com</p>
            </div>
            <div class="bg-gray-100 rounded-lg p-4">
                <p class="font-mono text-gray-800 text-center tracking-wider">ns2.perfectdns.com</p>
            </div>
        </div>
        <p class="text-sm text-gray-500 mt-6">
            <i class="ri-information-line align-middle"></i>
            DNS changes can take up to 24-48 hours to propagate. If you have any questions, please contact your domain registrar's support.
        </p>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const wrapper = document.getElementById('custom-select-wrapper');
    if (!wrapper) return;

    const button = wrapper.querySelector('button');
    const dropdown = document.getElementById('custom-select-dropdown');
    const searchInput = document.getElementById('search-input');
    const optionsList = document.getElementById('custom-options-list');
    const originalSelect = document.getElementById('createorderform-currency');
    const selectedOptionText = document.getElementById('selected-option-text');

    // Set default selection to first option if no option is selected
    if (originalSelect.options.length > 0) {
        if (!originalSelect.value) {
            originalSelect.selectedIndex = 0;
        }
        // Update the display text to match the actual selected value
        const selectedOption = originalSelect.options[originalSelect.selectedIndex];
        if (selectedOption) {
            selectedOptionText.textContent = selectedOption.text;
        }
    }

    button.addEventListener('click', function (e) {
        e.stopPropagation();
        dropdown.classList.toggle('hidden');
    });

    searchInput.addEventListener('input', function () {
        const filter = searchInput.value.toLowerCase();
        const options = optionsList.getElementsByTagName('li');
        for (let i = 0; i < options.length; i++) {
            const txtValue = options[i].textContent || options[i].innerText;
            if (txtValue.toLowerCase().indexOf(filter) > -1) {
                options[i].style.display = "";
            } else {
                options[i].style.display = "none";
            }
        }
    });

    optionsList.addEventListener('click', function (e) {
        if (e.target.tagName === 'LI') {
            const value = e.target.getAttribute('data-value');
            const text = e.target.textContent;

            originalSelect.value = value;
            selectedOptionText.textContent = text;
            
            // Trigger change event for any other scripts that might be listening
            const event = new Event('change', { bubbles: true });
            originalSelect.dispatchEvent(event);

            dropdown.classList.add('hidden');
        }
    });

    document.addEventListener('click', function (e) {
        if (!wrapper.contains(e.target)) {
            dropdown.classList.add('hidden');
        }
    });

    const togglePasswordIcons = document.querySelectorAll('.toggle-password');
    togglePasswordIcons.forEach(icon => {
        icon.addEventListener('click', function () {
            const input = this.previousElementSibling;
            if (input.type === 'password') {
                input.type = 'text';
                this.classList.remove('ri-eye-line');
                this.classList.add('ri-eye-off-line');
            } else {
                input.type = 'password';
                this.classList.remove('ri-eye-off-line');
                this.classList.add('ri-eye-line');
            }
        });
    });

    // Modal script
    const openModalBtn = document.getElementById('how-to-connect-btn');
    const closeModalBtn = document.getElementById('close-modal-btn');
    const modal = document.getElementById('nameserver-modal');
    const modalContent = modal.querySelector('.transform');

    if (openModalBtn && modal) {
        openModalBtn.addEventListener('click', function(e) {
            e.preventDefault();
            modal.classList.remove('hidden');
            setTimeout(() => { // For transition
                modal.classList.add('opacity-100');
                modalContent.classList.add('scale-100');
            }, 10);
        });
    }

    const closeModal = () => {
        modal.classList.remove('opacity-100');
        modalContent.classList.remove('scale-100');
        setTimeout(() => { // For transition
            modal.classList.add('hidden');
        }, 300);
    }

    if (closeModalBtn && modal) {
        closeModalBtn.addEventListener('click', closeModal);
    }

    if (modal) {
        modal.addEventListener('click', function(e) {
            if (e.target === modal) {
                closeModal();
            }
        });
    }

    // Copy to clipboard for nameservers
    const copyButtons = document.querySelectorAll('.copy-btn');
    copyButtons.forEach(button => {
        button.addEventListener('click', function(e) {
            e.preventDefault();
            const textToCopy = this.getAttribute('data-copy-text');
            navigator.clipboard.writeText(textToCopy).then(() => {
                const icon = this.querySelector('i');
                icon.classList.remove('ri-file-copy-line');
                icon.classList.add('ri-check-line');
                this.classList.add('text-green-500');

                setTimeout(() => {
                    icon.classList.remove('ri-check-line');
                    icon.classList.add('ri-file-copy-line');
                    this.classList.remove('text-green-500');
                }, 2000);
            }).catch(err => {
                console.error('Failed to copy: ', err);
            });
        });
    });

    // FAQ Accordion
    const faqContainer = document.getElementById('faq-container');
    if (faqContainer) {
        faqContainer.addEventListener('click', function(e) {
            const button = e.target.closest('button');
            if (!button) return;

            const faqItem = button.parentElement;
            const answer = button.nextElementSibling;
            const icon = button.querySelector('i');
            const isExpanded = answer.style.maxHeight && answer.style.maxHeight !== '0px';

            // Close all other open FAQs
            const allItems = faqContainer.children;
            for(let item of allItems) {
                if (item !== faqItem) {
                    const otherAnswer = item.querySelector('.overflow-hidden');
                    const otherIcon = item.querySelector('i');
                    const otherButton = item.querySelector('button');
                    otherAnswer.style.maxHeight = '0px';
                    if (otherIcon) {
                        otherIcon.classList.remove('ri-subtract-line');
                        otherIcon.classList.add('ri-add-line');
                    }
                    otherButton.classList.remove('border-b', 'border-gray-200/80');
                }
            }

            // Toggle current FAQ
            if (isExpanded) {
                answer.style.maxHeight = '0px';
                icon.classList.remove('ri-subtract-line');
                icon.classList.add('ri-add-line');
                button.classList.remove('border-b', 'border-gray-200/80');
            } else {
                answer.style.maxHeight = answer.scrollHeight + 'px';
                icon.classList.remove('ri-add-line');
                icon.classList.add('ri-subtract-line');
                button.classList.add('border-b', 'border-gray-200/80');
            }
        });
    }
});
</script>
