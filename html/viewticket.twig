<style>
/* ===== View ticket: same scale as tickets page ===== */
.vt-page { zoom: 0.805; }
@media (max-width: 767px) { .vt-page { zoom: 0.98; } }

/* Palette (site blue as accent, rest neutral) */
.vt-page .vt-link { color: #134de2; }
.vt-page .vt-link:hover { color: #103fad; }
.vt-page .vt-solid {
    background: linear-gradient(0deg, rgba(255,255,255,0.16) 6.48%, rgba(255,255,255,0) 100%), #134de2;
    border: 1px solid #4580f7;
    color: #ffffff;
}
.vt-page .vt-solid:hover { background: #103fad; border-color: #103fad; }

/* Chat area */
.vt-page .vt-chat { background-color: #f8fafc; }
.vt-page .vt-bubble-user {
    background-color: rgba(69, 128, 247, 0.10);
    border: 1px solid rgba(69, 128, 247, 0.25);
    color: #1e293b;
    border-radius: 14px 14px 4px 14px;
}
.vt-page .vt-bubble-support {
    background-color: #ffffff;
    color: #1f2937;
    border: 1px solid #e5e7eb;
    border-radius: 14px 14px 14px 4px;
}
.vt-page .vt-avatar-user { background-color: #eef3ff; color: #134de2; }
.vt-page .vt-avatar-support { background-color: #134de2; color: #ffffff; }
.vt-page .vt-file-user { background-color: rgba(255,255,255,0.7); border: 1px solid rgba(69,128,247,0.2); color: #134de2; }
.vt-page .vt-file-user:hover { background-color: #ffffff; }
.vt-page .vt-file-support { background-color: #f3f4f6; color: #134de2; }
.vt-page .vt-file-support:hover { background-color: #e5e7eb; }
.vt-page .vt-msg-text { overflow-wrap: anywhere; }

/* Status badge */
.vt-page .vt-badge { background-color: #eef3ff; border: 1px solid #c7d7fe; color: #134de2; }

/* Composer */
.vt-page .vt-composer { border: 1px solid #d1d5db; background: #fff; transition: border-color .2s, box-shadow .2s; }
.vt-page .vt-composer:focus-within { border-color: #4580f7; box-shadow: 0 0 0 3px rgba(69,128,247,0.15); }
.vt-page .vt-composer textarea { border: 0 !important; box-shadow: none !important; outline: none !important; background: transparent; }
.auto-resize-textarea { min-height: 40px; max-height: 200px; resize: none; overflow-y: auto; line-height: 1.5; }

/* File uploader (script injects its own button inside) */
.files-label { display: none; }
#uploader-button { padding: 0 !important; margin: 0 !important; }
.vt-page .tickets-uploader { transition: all .2s ease; color: #6b7280; }
.vt-page .tickets-uploader:hover { background-color: #f3f4f6; color: #134de2; }
.rtl-form .tickets-uploader span { margin-left: 0; margin-right: .5rem; }

/* Dark mode */
html.dark-mode .vt-page .vt-chat { background-color: #0b1220; }
html.dark-mode .vt-page .vt-bubble-user { background-color: rgba(69,128,247,0.14); border-color: rgba(69,128,247,0.3); color: #e2e8f0; }
html.dark-mode .vt-page .vt-file-user { background-color: rgba(15,23,42,0.6); border-color: rgba(69,128,247,0.3); color: #9db8fb; }
html.dark-mode .vt-page .vt-file-user:hover { background-color: #0f172a; }
html.dark-mode .vt-page .vt-bubble-support { background-color: #1e293b; border-color: #334155; color: #e2e8f0; }
html.dark-mode .vt-page .vt-avatar-user { background-color: rgba(69,128,247,0.18); color: #9db8fb; }
html.dark-mode .vt-page .vt-file-support { background-color: #0f172a; color: #9db8fb; }
html.dark-mode .vt-page .vt-file-support:hover { background-color: #111827; }
html.dark-mode .vt-page .vt-link { color: #7aa2fa; }
html.dark-mode .vt-page .vt-badge { background-color: rgba(69,128,247,0.15); border-color: rgba(69,128,247,0.4); color: #9db8fb; }
html.dark-mode .vt-page .vt-composer { background-color: #0f172a; border-color: #334155; }
html.dark-mode .vt-page .tickets-uploader:hover { background-color: #1e293b; }
</style>

<div class="vt-page relative z-10 pb-16 md:pb-15 bg-white pt-6">
    <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-[986px] mx-auto">

            <!-- Top bar: back link -->
            <div class="flex items-center justify-between gap-3 mb-4">
                <a href="/tickets" class="vt-link inline-flex items-center gap-1.5 text-sm font-medium">
                    <i class="ri-arrow-left-line text-base"></i>
                    <span>Back to tickets</span>
                </a>
            </div>

            <!-- Ticket Card -->
            <div class="bg-white rounded-xl border border-gray-200 overflow-hidden {% if site['rtl'] %}rtl-content{% endif %}">

                <!-- Header -->
                <div class="px-5 py-3 border-b border-gray-200 flex items-center gap-3 {% if site['rtl'] %}flex-row-reverse{% endif %}">
                    <div class="vt-avatar-support w-9 h-9 shrink-0 rounded-full flex items-center justify-center">
                        <i class="ri-customer-service-2-line text-base"></i>
                    </div>
                    <div class="min-w-0 flex-1">
                        <h3 class="text-base font-semibold text-gray-800 leading-tight truncate" title="{{ ticket['thema'] }}">{{ ticket['thema'] }}</h3>
                        <div class="text-xs text-gray-500 mt-0.5">Support conversation</div>
                    </div>
                    <span class="vt-badge shrink-0 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium">
                        {% if ticket['status'] is defined and ticket['status'] %}{{ ticket['status'] }}{% else %}Open{% endif %}
                    </span>
                </div>

                <!-- Chat -->
                <div id="vt-chat" class="vt-chat max-h-[60vh] min-h-[260px] overflow-y-auto px-4 sm:px-5 py-5">
                    <div class="space-y-4">
                        {% if messageList %}
                            {% for message in messageList %}
                                {% if message['support'] == 0 %}
                                    <!-- User Message (right) -->
                                    <div class="flex items-end gap-2 {% if site['rtl'] %}flex-row{% else %}flex-row-reverse{% endif %}">
                                        <div class="vt-avatar-user w-7 h-7 shrink-0 rounded-full flex items-center justify-center text-xs font-bold uppercase">
                                            {{ message['author']|first }}
                                        </div>
                                        <div class="max-w-[85%] sm:max-w-[70%] flex flex-col {% if site['rtl'] %}items-start{% else %}items-end{% endif %}">
                                            <div class="flex items-center gap-2 mb-1 px-1 text-[11px] text-gray-500">
                                                <span class="font-semibold text-gray-700">{{ message['author'] }}</span>
                                                <span>{{ message['time'] }}</span>
                                            </div>
                                            <div class="vt-bubble-user px-3.5 py-2.5 shadow-sm">
                                                <div class="vt-msg-text text-sm leading-relaxed">{{ message['message'] }}</div>
                                                {% if message['files'] %}
                                                    <div class="mt-2 flex flex-wrap gap-1.5">
                                                        {% for file in message['files'] %}
                                                            <a href="{{ file['url'] }}" title="{{ file['name'] }}" target="_blank" rel="noopener noreferrer nofollow" class="vt-file-user inline-flex items-center gap-1 px-2 py-1 rounded-md text-xs transition-colors">
                                                                <i class="ri-attachment-2"></i>
                                                                {{ sliceUrl(file['name']) }}
                                                            </a>
                                                        {% endfor %}
                                                    </div>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                {% else %}
                                    <!-- Support Message (left) -->
                                    <div class="flex items-end gap-2 {% if site['rtl'] %}flex-row-reverse{% else %}flex-row{% endif %}">
                                        <div class="vt-avatar-support w-7 h-7 shrink-0 rounded-full flex items-center justify-center">
                                            <i class="ri-customer-service-2-line text-xs"></i>
                                        </div>
                                        <div class="max-w-[85%] sm:max-w-[70%] flex flex-col {% if site['rtl'] %}items-end{% else %}items-start{% endif %}">
                                            <div class="flex items-center gap-2 mb-1 px-1 text-[11px] text-gray-500">
                                                <span class="font-semibold vt-link">{{ message['author'] }}</span>
                                                <span>{{ message['time'] }}</span>
                                            </div>
                                            <div class="vt-bubble-support px-3.5 py-2.5 shadow-sm">
                                                <div class="vt-msg-text text-sm leading-relaxed">{{ message['message'] }}</div>
                                                {% if message['files'] %}
                                                    <div class="mt-2 flex flex-wrap gap-1.5">
                                                        {% for file in message['files'] %}
                                                            <a href="{{ file['url'] }}" title="{{ file['name'] }}" target="_blank" rel="noopener noreferrer nofollow" class="vt-file-support inline-flex items-center gap-1 px-2 py-1 rounded-md text-xs transition-colors">
                                                                <i class="ri-attachment-2"></i>
                                                                {{ sliceUrl(file['name']) }}
                                                            </a>
                                                        {% endfor %}
                                                    </div>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}
                            {% endfor %}
                        {% else %}
                            <div class="text-center text-sm text-gray-500 py-10">No messages yet.</div>
                        {% endif %}
                    </div>
                </div>

                {% if canAddMessage %}
                    <!-- Reply -->
                    <div class="px-4 sm:px-5 py-4 border-t border-gray-200">
                        <form {% if site['rtl'] %}class="rtl-form"{% endif %} method="post" action="">
                            {% if error %}
                                <div class="flex items-center gap-2 p-3 mb-3 text-sm text-red-800 border border-red-300 rounded-lg bg-red-50 {% if site['rtl'] %}rtl-alert{% endif %}">
                                    <i class="ri-error-warning-line text-base"></i>
                                    <span class="flex-1">{{ errorMessage }}</span>
                                    <button type="button" class="text-red-500 hover:text-red-700" aria-label="Close" onclick="this.parentElement.style.display='none'">
                                        <i class="ri-close-line text-base"></i>
                                    </button>
                                </div>
                            {% endif %}

                            <label for="message" class="sr-only">{{ lang('tickets.message') }}</label>
                            <div class="vt-composer rounded-xl flex items-end gap-1.5 p-1.5 {% if site['rtl'] %}flex-row-reverse{% endif %}">
                                <textarea
                                    id="message"
                                    name="TicketMessageForm[message]"
                                    rows="1"
                                    class="auto-resize-textarea flex-1 min-w-0 px-2.5 py-2 text-sm text-gray-800 placeholder:text-gray-400"
                                    placeholder="Type your reply..."></textarea>

                                <!-- Attach -->
                                <div
                                    class="tickets-uploader shrink-0 w-10 h-10 rounded-lg flex items-center justify-center cursor-pointer"
                                    data-rtl="{% if site['rtl'] %}true{% else %}false{% endif %}"
                                    data-lang-button-attach="{{ lang('tickets.button.attach') }}"
                                    data-lang-file-format-incorrect="{{ lang('tickets.error.file_format.incorrect') }}"
                                    data-lang-file-size-incorrect="{{ lang('tickets.error.file_size.incorrect') }}"
                                    title="{{ lang('tickets.button.attach') }}"
                                    tabindex="0">
                                    <i class="ri-attachment-2 text-lg"></i>
                                </div>

                                <!-- Send -->
                                <button type="submit" class="vt-solid shrink-0 h-10 px-4 rounded-lg flex items-center justify-center gap-1.5 text-sm font-semibold transition-colors">
                                    <i class="ri-send-plane-fill text-sm"></i>
                                    <span class="hidden sm:inline">{{ lang('tickets.button.reply') }}</span>
                                </button>
                            </div>

                            <input type="hidden" name="_csrf" value="{{csrftoken}}">
                        </form>
                    </div>
                {% endif %}
            </div>

        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Scroll chat to the latest message
    var chat = document.getElementById('vt-chat');
    if (chat) { chat.scrollTop = chat.scrollHeight; }

    // Auto-resize reply box
    var textarea = document.getElementById('message');
    if (!textarea) return;
    function autoResize() {
        textarea.style.height = 'auto';
        textarea.style.height = Math.min(textarea.scrollHeight, 200) + 'px';
    }
    textarea.addEventListener('input', autoResize);
    autoResize();
});
</script>
